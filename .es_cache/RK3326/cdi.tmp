<system>
  <name>cdi</name>
  <fullname>CD-i</fullname>
  <manufacturer>Philips</manufacturer>
  <release>1991</release>
  <hardware>console</hardware>
  <path>/storage/roms/cdi</path>
  <extension>.chd .cue .iso</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>cdi</platform>
  <theme>cdi</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">same_cdi</core>
      </cores>
    </emulator>
  </emulators>
</system>
