<system>
  <name>supervision</name>
  <fullname>Supervision</fullname>
  <manufacturer>Watara</manufacturer>
  <release>1992</release>
  <hardware>portable</hardware>
  <path>/storage/roms/supervision</path>
  <extension>.sv .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>supervision</platform>
  <theme>supervision</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">potator</core>
      </cores>
    </emulator>
  </emulators>
</system>
