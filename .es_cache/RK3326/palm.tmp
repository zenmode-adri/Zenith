<system>
  <name>palm</name>
  <fullname>Palm OS</fullname>
  <manufacturer>Palm, Inc.</manufacturer>
  <release>1996</release>
  <hardware>computer</hardware>
  <path>/storage/roms/palm</path>
  <extension>.prc .pqa .img .pdb .zip</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>palm</platform>
  <theme>palm</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">mu</core>
      </cores>
    </emulator>
  </emulators>
</system>
