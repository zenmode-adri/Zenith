<system>
  <name>tic-80</name>
  <fullname>TIC-80</fullname>
  <manufacturer>Nesbox</manufacturer>
  <release>2017</release>
  <hardware>game engine</hardware>
  <path>/storage/roms/tic-80</path>
  <extension>.tic</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>tic80</platform>
  <theme>tic80</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">tic80</core>
      </cores>
    </emulator>
  </emulators>
</system>
