<system>
  <name>x68000</name>
  <fullname>x68000</fullname>
  <manufacturer>Sharp</manufacturer>
  <release>1987</release>
  <hardware>computer</hardware>
  <path>/storage/roms/x68000</path>
  <extension>.dim .img .d88 .hdm .dup .2hd .xdf .hdf .cmd .m3u .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>x68000</platform>
  <theme>x68000</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">px68k</core>
      </cores>
    </emulator>
  </emulators>
</system>
