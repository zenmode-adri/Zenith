<system>
  <name>pc</name>
  <fullname>DOS</fullname>
  <manufacturer>Microsoft</manufacturer>
  <release>1981</release>
  <hardware>computer</hardware>
  <path>/storage/roms/pc</path>
  <extension>.com .bat .exe .dosz</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>pc</platform>
  <theme>pc</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core>dosbox_pure</core>
        <core>dosbox_core</core>
      </cores>
    </emulator>
  </emulators>
</system>
