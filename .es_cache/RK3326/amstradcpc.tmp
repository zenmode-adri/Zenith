<system>
  <name>amstradcpc</name>
  <fullname>Amstrad CPC</fullname>
  <manufacturer>Amstrad</manufacturer>
  <release>1984</release>
  <hardware>computer</hardware>
  <path>/storage/roms/amstradcpc</path>
  <extension>.dsk .cpr .sna .tap .cdt .kcr .voc .m3u .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>amstradcpc</platform>
  <theme>amstradcpc</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">crocods</core>
        <core>cap32</core>
      </cores>
    </emulator>
  </emulators>
</system>
