<system>
  <name>vircon32</name>
  <fullname>Vircon32</fullname>
  <manufacturer>Various</manufacturer>
  <release>2021</release>
  <hardware>game engine</hardware>
  <path>/storage/roms/vircon32</path>
  <extension>.v32</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>vircon32</platform>
  <theme>vircon32</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">vircon32</core>
      </cores>
    </emulator>
  </emulators>
</system>
