<system>
  <name>zmachine</name>
  <fullname>Z-machine</fullname>
  <manufacturer>Infocom</manufacturer>
  <release>1979</release>
  <hardware>game engine</hardware>
  <path>/storage/roms/zmachine</path>
  <extension>.dat .z1 .z2 .z3 .z4 .z5 .z6 .zip</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>z-machine</platform>
  <theme>zmachine</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">mojozork</core>
      </cores>
    </emulator>
  </emulators>
</system>
