<system>
  <name>pet</name>
  <fullname>Commodore PET</fullname>
  <manufacturer>Commodore</manufacturer>
  <release>1977</release>
  <hardware>computer</hardware>
  <path>/storage/roms/pet</path>
  <extension>.20 .a0 .b0 .d64 .d71 .d80 .d81 .d82 .g64 .g41 .x64 .t64 .tap .prg .p00 .crt .bin .gz .d6z .d7z .d8z .g6z .g4z .x6z .cmd .m3u .vsf .nib .nbz .zip</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>pet</platform>
  <theme>pet</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">vice_xpet</core>
      </cores>
    </emulator>
  </emulators>
</system>
