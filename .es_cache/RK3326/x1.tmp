<system>
  <name>x1</name>
  <fullname>X1</fullname>
  <manufacturer>Sharp</manufacturer>
  <release>1982</release>
  <hardware>computer</hardware>
  <path>/storage/roms/x1</path>
  <extension>.dx1 .2d .2hd .tfd .d88 .88d .hdm .xdf .dup .tap .cmd .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>x1</platform>
  <theme>x1</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">x1</core>
      </cores>
    </emulator>
  </emulators>
</system>
