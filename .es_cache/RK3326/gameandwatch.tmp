<system>
  <name>gameandwatch</name>
  <fullname>Game &amp; Watch</fullname>
  <manufacturer>Nintendo</manufacturer>
  <release>1980</release>
  <hardware>portable</hardware>
  <path>/storage/roms/gameandwatch</path>
  <extension>.mgw .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>gameandwatch</platform>
  <theme>gameandwatch</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core>gw</core>
        <core>mame</core>
      </cores>
    </emulator>
  </emulators>
</system>
