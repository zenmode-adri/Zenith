<system>
  <name>gb</name>
  <fullname>Game Boy</fullname>
  <manufacturer>Nintendo</manufacturer>
  <release>1989</release>
  <hardware>portable</hardware>
  <path>/storage/roms/gb</path>
  <extension>.gb .gbc .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>gb</platform>
  <theme>gb</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">gambatte</core>
        <core>sameboy</core>
        <core>gearboy</core>
        <core>tgbdual</core>
        <core>mgba</core>
        <core>vbam</core>
        <core>DoubleCherryGB</core>
      </cores>
    </emulator>
    <emulator name="mednafen">
      <cores>
        <core>gb</core>
      </cores>
    </emulator>
  </emulators>
</system>
