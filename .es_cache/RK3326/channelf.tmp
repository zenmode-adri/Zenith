<system>
  <name>channelf</name>
  <fullname>Fairchild Channel F</fullname>
  <manufacturer>Fairchild</manufacturer>
  <release>1976</release>
  <hardware>console</hardware>
  <path>/storage/roms/channelf</path>
  <extension>.bin .chf .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>channelf</platform>
  <theme>channelf</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">freechaf</core>
      </cores>
    </emulator>
  </emulators>
</system>
