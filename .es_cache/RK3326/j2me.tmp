<system>
  <name>j2me</name>
  <fullname>J2ME</fullname>
  <manufacturer>Sun Microsystems</manufacturer>
  <release>2002</release>
  <hardware>portable</hardware>
  <path>/storage/roms/j2me</path>
  <extension>.jar</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>j2me</platform>
  <theme>j2me</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core>freej2me</core>
      </cores>
    </emulator>
    <emulator name="freej2me">
      <cores>
        <core default="true">freej2me</core>
      </cores>
    </emulator>
  </emulators>
</system>
