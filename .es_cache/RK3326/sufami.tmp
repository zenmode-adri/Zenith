<system>
  <name>sufami</name>
  <fullname>SuFami Turbo</fullname>
  <manufacturer>Bandai</manufacturer>
  <release>1996</release>
  <hardware>console</hardware>
  <path>/storage/roms/sufami</path>
  <extension>.st .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>sufami</platform>
  <theme>sufami</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">snes9x</core>
      </cores>
    </emulator>
  </emulators>
</system>
