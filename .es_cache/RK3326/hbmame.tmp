<system>
  <name>hbmame</name>
  <fullname>Homebrew Mame</fullname>
  <manufacturer>Arcade</manufacturer>
  <release>0000</release>
  <hardware>arcade</hardware>
  <path>/storage/roms/hbmame</path>
  <extension>.zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>hbmame</platform>
  <theme>hbmame</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">fbalpha2012_32b</core>
        <core>nebularm_32b</core>
        <core>nebularm_legacy_32b</core>
        <core>fbneo_32b</core>
        <core>mame2003_plus_32b</core>
      </cores>
    </emulator>
  </emulators>
</system>
