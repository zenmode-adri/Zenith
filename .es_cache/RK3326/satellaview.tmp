<system>
  <name>satellaview</name>
  <fullname>Satellaview</fullname>
  <manufacturer>Nintendo</manufacturer>
  <release>1995</release>
  <hardware>console</hardware>
  <path>/storage/roms/satellaview</path>
  <extension>.smc .fig .bs .sfc .bsx .swc .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>satellaview</platform>
  <theme>satellaview</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">snes9x</core>
        <core>snes9x2010</core>
        <core>snes9x2002</core>
        <core>snes9x2005_plus</core>
      </cores>
    </emulator>
  </emulators>
</system>
