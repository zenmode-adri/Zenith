<system>
  <name>colecovision</name>
  <fullname>ColecoVision</fullname>
  <manufacturer>Coleco</manufacturer>
  <release>1982</release>
  <hardware>console</hardware>
  <path>/storage/roms/coleco</path>
  <extension>.bin .col .rom .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>colecovision</platform>
  <theme>colecovision</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">gearcoleco</core>
        <core>bluemsx</core>
        <core>smsplus</core>
      </cores>
    </emulator>
  </emulators>
</system>
