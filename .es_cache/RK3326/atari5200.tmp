<system>
  <name>atari5200</name>
  <fullname>Atari 5200</fullname>
  <manufacturer>Atari</manufacturer>
  <release>1982</release>
  <hardware>console</hardware>
  <path>/storage/roms/atari5200</path>
  <extension>.rom .xfd .atr .atx .cdm .cas .car .bin .a52 .xex .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>atari5200</platform>
  <theme>atari5200</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">a5200</core>
        <core>atari800</core>
      </cores>
    </emulator>
  </emulators>
</system>
