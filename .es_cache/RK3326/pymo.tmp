<system>
  <name>pymo</name>
  <fullname>PyMO</fullname>
  <manufacturer>Various</manufacturer>
  <release>2008</release>
  <hardware>game engine</hardware>
  <path>/storage/roms/pymo</path>
  <extension>.pymo</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>pymo</platform>
  <theme>pymo</theme>
  <emulators>
    <emulator name="cpymo">
      <cores>
        <core default="true">cpymo</core>
      </cores>
    </emulator>
  </emulators>
</system>
