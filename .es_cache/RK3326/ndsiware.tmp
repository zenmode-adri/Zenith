<system>
  <name>ndsiware</name>
  <fullname>Nintendo DSiWare</fullname>
  <manufacturer>Nintendo</manufacturer>
  <release>2008</release>
  <hardware>portable</hardware>
  <path>/storage/roms/ndsiware</path>
  <extension>.nds .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>nds</platform>
  <theme>ndsiware</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">melondsds</core>
      </cores>
    </emulator>
  </emulators>
</system>
