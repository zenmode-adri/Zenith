<system>
  <name>eka2l1</name>
  <fullname>eka2l1</fullname>
  <manufacturer>Nokia</manufacturer>
  <release>2000</release>
  <hardware>Nokia Mobile</hardware>
  <path>/storage/.config/eka2l1/scripts/</path>
  <extension>.sh</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>Mobile phone</platform>
  <theme>eka2l1</theme>
  <emulators>
    <emulator name="eka2l1">
      <cores>
        <core default="true">eka2l1</core>
      </cores>
    </emulator>
  </emulators>
</system>
