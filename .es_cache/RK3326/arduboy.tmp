<system>
  <name>arduboy</name>
  <fullname>Arduboy</fullname>
  <manufacturer>Arduboy</manufacturer>
  <release>2014</release>
  <hardware>portable</hardware>
  <path>/storage/roms/arduboy</path>
  <extension>.hex</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>arduboy</platform>
  <theme>arduboy</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">arduous</core>
      </cores>
    </emulator>
  </emulators>
</system>
