<system>
  <name>ports</name>
  <fullname>Ports</fullname>
  <manufacturer>&#xF013; System</manufacturer>
  <release>System</release>
  <hardware>computer</hardware>
  <path>/storage/roms/ports</path>
  <extension>.sh</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>pc</platform>
  <theme>ports</theme>
  <emulators>
    <emulator name="portmaster">
      <cores>
        <core default="true">portmaster</core>
      </cores>
    </emulator>
  </emulators>
</system>
