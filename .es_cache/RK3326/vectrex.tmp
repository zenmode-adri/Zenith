<system>
  <name>vectrex</name>
  <fullname>Vectrex</fullname>
  <manufacturer>Smith Engineering</manufacturer>
  <release>1982</release>
  <hardware>console</hardware>
  <path>/storage/roms/vectrex</path>
  <extension>.bin .gam .vec .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>vectrex</platform>
  <theme>vectrex</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">vecx</core>
      </cores>
    </emulator>
  </emulators>
</system>
