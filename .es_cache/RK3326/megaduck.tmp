<system>
  <name>megaduck</name>
  <fullname>Mega Duck</fullname>
  <manufacturer>Welback Holdings</manufacturer>
  <release>1993</release>
  <hardware>portable</hardware>
  <path>/storage/roms/megaduck</path>
  <extension>.bin .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>megaduck</platform>
  <theme>megaduck</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">sameduck</core>
      </cores>
    </emulator>
  </emulators>
</system>
