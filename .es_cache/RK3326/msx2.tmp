<system>
  <name>msx2</name>
  <fullname>MSX 2</fullname>
  <manufacturer>Microsoft</manufacturer>
  <release>1988</release>
  <hardware>computer</hardware>
  <path>/storage/roms/msx2</path>
  <extension>.dsk .mx1 .mx2 .rom .zip .7z .m3u</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>msx</platform>
  <theme>msx2</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">bluemsx</core>
        <core>fmsx</core>
      </cores>
    </emulator>
  </emulators>
</system>
