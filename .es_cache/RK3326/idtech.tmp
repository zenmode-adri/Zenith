<system>
  <name>idtech</name>
  <fullname>iDtech</fullname>
  <manufacturer>id Software</manufacturer>
  <release>1991</release>
  <hardware>game engine</hardware>
  <path>/storage/.config/idtech</path>
  <extension>.sh</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>idtech</platform>
  <theme>idtech</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core>idtech</core>
      </cores>
    </emulator>
  </emulators>
</system>
