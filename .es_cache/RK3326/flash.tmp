<system>
  <name>flash</name>
  <fullname>Adobe Flash</fullname>
  <manufacturer>Adobe</manufacturer>
  <release>1996</release>
  <hardware>computer</hardware>
  <path>/storage/roms/flash</path>
  <extension>.swf .SWF</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>pc</platform>
  <theme>flash</theme>
  <emulators>
    <emulator name="ruffle">
      <cores>
        <core default="true">ruffle-sa</core>
      </cores>
    </emulator>
  </emulators>
</system>
