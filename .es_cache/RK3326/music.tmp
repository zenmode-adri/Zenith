<system>
  <name>music</name>
  <fullname>Music Player</fullname>
  <manufacturer>&#xF013; System</manufacturer>
  <release>System</release>
  <hardware>System</hardware>
  <path>/storage/.config/gmu/playlists</path>
  <extension>.m3u .sh</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>music</platform>
  <theme>music</theme>
  <emulators>
    <emulator name="gmu">
      <cores>
        <core default="true">gmu</core>
      </cores>
    </emulator>
  </emulators>
</system>
