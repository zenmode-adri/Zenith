<system>
  <name>doom</name>
  <fullname>Doom</fullname>
  <manufacturer>id Software</manufacturer>
  <release>1993</release>
  <hardware>game engine</hardware>
  <path>/storage/roms/doom</path>
  <extension>.doom</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>doom</platform>
  <theme>doom</theme>
  <emulators>
    <emulator name="gzdoom">
      <cores>
        <core default="true">gzdoom-sa</core>
      </cores>
    </emulator>
  </emulators>
</system>
