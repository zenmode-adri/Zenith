<system>
  <name>mkxp-z</name>
  <fullname>RPG Maker XP</fullname>
  <manufacturer>RPG Maker XP</manufacturer>
  <release>2000</release>
  <hardware>RPG Maker XP</hardware>
  <path>/storage/roms/mkxp</path>
  <extension>.mkxp</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>mkxp-x</platform>
  <theme>mkxp-z</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">mkxp-z</core>
      </cores>
    </emulator>
  </emulators>
</system>
