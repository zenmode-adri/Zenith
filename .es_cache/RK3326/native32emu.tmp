<system>
  <name>native32emu</name>
  <fullname>native32emu</fullname>
  <manufacturer>native32emu</manufacturer>
  <release>2005</release>
  <hardware>electronic dictionary</hardware>
  <path>/storage/roms/native32emu</path>
  <extension>.smf .sgm .ssl .zip</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>native32emu</platform>
  <theme>native32emu</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">native32emu</core>
      </cores>
    </emulator>
  </emulators>
</system>
