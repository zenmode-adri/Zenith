<system>
  <name>varcade</name>
  <fullname>Vertical Arcade</fullname>
  <manufacturer>Arcade</manufacturer>
  <release>0000</release>
  <hardware>arcade</hardware>
  <path>/storage/roms/varcade</path>
  <extension>.zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>varcade</platform>
  <theme>varcade</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">mame2003_plus</core>
        <core>fbneoplus</core>
        <core>mame2010</core>
        <core>mame2015</core>
        <core>fbneo</core>
        <core>fbalpha2012</core>
        <core>fbalpha2019</core>
        <core>mame</core>
      </cores>
    </emulator>
  </emulators>
</system>
