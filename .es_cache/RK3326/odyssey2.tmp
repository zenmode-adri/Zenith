<system>
  <name>odyssey2</name>
  <fullname>Odyssey 2</fullname>
  <manufacturer>Magnavox</manufacturer>
  <release>1979</release>
  <hardware>console</hardware>
  <path>/storage/roms/odyssey</path>
  <extension>.bin .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>odyssey2</platform>
  <theme>odyssey2</theme>
  <emulators>
    <emulator name="retroarch">
      <cores>
        <core default="true">o2em</core>
      </cores>
    </emulator>
  </emulators>
</system>
