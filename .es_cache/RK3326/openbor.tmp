<system>
  <name>openbor</name>
  <fullname>OpenBOR</fullname>
  <manufacturer>Various</manufacturer>
  <release>2003</release>
  <hardware>game engine</hardware>
  <path>/storage/roms/openbor</path>
  <extension>.pak</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>openbor</platform>
  <theme>openbor</theme>
  <emulators>
    <emulator name="OpenBOR">
      <cores>
        <core default="true">OpenBOR</core>
        <core>OpenBOR-ff</core>
      </cores>
    </emulator>
  </emulators>
</system>
