<system>
  <name>naomi</name>
  <fullname>Naomi</fullname>
  <manufacturer>Sega</manufacturer>
  <release>1998</release>
  <hardware>arcade</hardware>
  <path>/storage/roms/naomi</path>
  <extension>.lst .bin .dat .zip .7z</extension>
  <command>/usr/bin/runemu.sh %ROM% -P%SYSTEM% --core=%CORE% --emulator=%EMULATOR% --controllers="%CONTROLLERSCONFIG%"</command>
  <platform>naomi arcade</platform>
  <theme>naomi</theme>
  <emulators>
    <emulator name="flycast">
      <cores>
        <core default="true">flycast2022-sa</core>
        <core>flycast-sa</core>
      </cores>
    </emulator>
    <emulator name="retroarch">
      <cores>
        <core>flycast2021</core>
        <core>flycast</core>
      </cores>
    </emulator>
  </emulators>
</system>
