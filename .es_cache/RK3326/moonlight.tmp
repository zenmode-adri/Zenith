<system>
  <name>moonlight</name>
  <fullname>Moonlight Game Streaming</fullname>
  <manufacturer>&#xF013; System</manufacturer>
  <release>System</release>
  <hardware>System</hardware>
  <path>/storage/roms/moonlight/</path>
  <extension>.sh</extension>
  <command>/bin/sh %ROM%</command>
  <platform>moonlight</platform>
  <theme>moonlight</theme>
  <emulators>
    <emulator name="moonlight">
      <cores>
        <core default="true">moonlight</core>
      </cores>
    </emulator>
  </emulators>
</system>
