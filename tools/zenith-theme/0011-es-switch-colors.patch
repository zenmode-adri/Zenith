+		{ "pathOff", PATH },
+		{ "colorOn", COLOR },
+		{ "colorOff", COLOR } } },
 	{ "menuTextEdit",{
 		{ "active", PATH },
 		{ "inactive", PATH } } },
@@ -2632,6 +2634,12 @@
 			Icons.on = elem->get<std::string>("pathOn");
 		if (elem->has("pathOff") && ResourceManager::getInstance()->fileExists(elem->get<std::string>("pathOff")))
 			Icons.off = elem->get<std::string>("pathOff");
+		if (elem->has("colorOn") && elem->has("colorOff"))
+		{
+			Icons.switchOnColor = elem->get<unsigned int>("colorOn");
+			Icons.switchOffColor = elem->get<unsigned int>("colorOff");
