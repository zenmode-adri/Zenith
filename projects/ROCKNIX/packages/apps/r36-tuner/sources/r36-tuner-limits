#!/bin/sh
# SPDX-License-Identifier: MIT
# Puts back at boot the clock limits chosen in R36 Tuner. Usage: r36-tuner-limits <file>
# File: "<cpu_khz> <gpu_hz> <ram_hz>". A value the current table does not offer is skipped (an update may have changed it).
f="$1"
[ -r "$f" ] || exit 0
read -r cpu gpu ram <"$f" || exit 0
apply() {  # value, list of available values, file
  [ -n "$1" ] && [ -w "$3" ] || return 0
  case " $(cat "$2" 2>/dev/null) " in *" $1 "*) echo "$1" >"$3" ;; esac
}
apply "$cpu" /sys/devices/system/cpu/cpufreq/policy0/scaling_available_frequencies /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
apply "$gpu" /sys/class/devfreq/ff400000.gpu/available_frequencies /sys/class/devfreq/ff400000.gpu/max_freq
apply "$ram" /sys/class/devfreq/dmc/available_frequencies /sys/class/devfreq/dmc/max_freq
exit 0
