#!/bin/bash

. /etc/profile.d/001-functions

RULES_FILE="/usr/share/X11/xkb/rules/base.lst"
CONF_KEY_LAYOUT="system.kblayout"
CONF_KEY_VARIANT="system.kbvariant"

# Check to make sure the rules file exists
if [ ! -f "$RULES_FILE" ]; then
    echo "Error: $RULES_FILE not found" >&2
    exit 1
fi

function get_current_layout() {
    local val=$(get_setting "$CONF_KEY_LAYOUT")
    if [ -z "$val" ]; then echo "us"; else echo "$val"; fi
}

function get_current_variant() {
    local val=$(get_setting "$CONF_KEY_VARIANT")
    if [ -z "$val" ] || [ "$val" == "none" ]; then echo ""; else echo "$val"; fi
}

function list_layouts() {
    awk '
    BEGIN { in_section=0 }
    /^! layout/ { in_section=1; next }
    /^!/ { in_section=0 }
    in_section && NF > 0 {
        code=$1;
        $1="";
        sub(/^ */, "", $0);
        print code " " $0
    }
    ' "$RULES_FILE" | sort -k2
}

function list_variants() {
    local layout="$1"

    # If no argument, get from config
    if [ -z "$layout" ]; then
        layout=$(get_current_layout)
    fi

    if [ -z "$layout" ]; then return; fi

    awk -v layout="$layout" '
    BEGIN { in_section=0 }
    /^! variant/ { in_section=1; next }
    /^!/ { in_section=0 }
    in_section && NF > 0 {
        if ($2 == layout":") {
             code=$1;
             $1=""; $2="";
             sub(/^ */, "", $0);
             print code " " $0
        }
    }
    ' "$RULES_FILE" | sort -k2
}

# Apply layout/variant to sway at runtime. zfront (child of sway) has SWAYSOCK;
# over SSH look for the socket. No sway or a failing swaymsg is not an error.
function sway_apply() {
    command -v swaymsg > /dev/null || return 0
    if [ -z "$SWAYSOCK" ]; then
        local RDIR="${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}"
        SWAYSOCK=$(ls "$RDIR"/sway-ipc.*.sock /run/0-runtime-dir/sway-ipc.*.sock 2>/dev/null | head -n 1)
    fi
    [ -n "$SWAYSOCK" ] || return 0
    export SWAYSOCK
    swaymsg input type:keyboard xkb_layout "$1" >/dev/null 2>&1 || true
    swaymsg input type:keyboard xkb_variant "$2" >/dev/null 2>&1 || true
    return 0
}

case "$1" in
    list-layouts)
        list_layouts
        ;;
    list-variants)
        list_variants "$2"
        ;;
    get)
        L=$(get_current_layout)
        V=$(get_current_variant)
        echo "$L $V"
        ;;
    apply)
        # At session start: apply the saved layout; nothing saved = keep sway config (us)
        L=$(get_setting "$CONF_KEY_LAYOUT")
        V=$(get_setting "$CONF_KEY_VARIANT")
        [ -n "$L" ] || exit 0
        [ "$V" == "none" ] && V=""
        sway_apply "$L" "$V"
        exit 0
        ;;
    set)
        LAYOUT="$2"
        VARIANT="$3"

        if [ -z "$LAYOUT" ]; then LAYOUT="us"; fi
        if [ "$VARIANT" == "none" ] || [ -z "$VARIANT" ]; then VARIANT=""; fi

        set_setting "$CONF_KEY_LAYOUT" "$LAYOUT"
        set_setting "$CONF_KEY_VARIANT" "$VARIANT"

        # Try to apply immediately (Runtime)
        # We check if setxkbmap exists. This works for X11.
        if command -v setxkbmap > /dev/null; then
             setxkbmap -layout "$LAYOUT" -variant "$VARIANT" 2>/dev/null || true
        fi

        sway_apply "$LAYOUT" "$VARIANT"

        exit 0
        ;;
    *)
        echo "Usage: $0 {list-layouts|list-variants [layout]|get|set <layout> <variant>}"
        exit 1
        ;;
esac
