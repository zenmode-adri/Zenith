#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)

# Fast path (ES sliders): "paneladj <prop> <0-100> nosave" on builds without Sway.
# Skips sourcing /etc/profile, the full modetest listing (CRTC id is cached) and set_setting:
# once the last wanted value is applied, the worker persists it with a direct, atomic edit of
# system.cfg (ES also keeps the value in memory). Calls made while a write is in flight only
# update the wanted value; a single worker applies the latest one.
# Only taken on RK3326/PX30 (CRTC properties + no Sway); other devices use the full path below.
if [ "${3}" = "nosave" ] && [[ "${2}" =~ ^[0-9]+$ ]] && [ "${2}" -le 100 ] &&    [ -e /dev/dri/card0 ] && ! command -v swaymsg >/dev/null 2>&1 && command -v flock >/dev/null 2>&1 &&    grep -qaE 'rk3326|px30' /proc/device-tree/compatible 2>/dev/null
then
  FP_DIR=/run/paneladj
  mkdir -p "${FP_DIR}"
  fp_crtc() {
    [ -s "${FP_DIR}/crtc" ] || modetest 2>/dev/null | awk '
      /^CRTCs:/ { in_crtcs = 1; next }
      /^Planes:/ { in_crtcs = 0 }
      in_crtcs && $1 ~ /^[0-9]+$/ && $2 != "0" { print $1; exit }
    ' > "${FP_DIR}/crtc"
    cat "${FP_DIR}/crtc"
  }
  fp_apply() {
    local c
    c="$(fp_crtc)"
    [ -n "${c}" ] && modetest -w "${c}:${1}:${2}" >/dev/null 2>&1 && return 0
    rm -f "${FP_DIR}/crtc"
    c="$(fp_crtc)"
    [ -n "${c}" ] && modetest -w "${c}:${1}:${2}" >/dev/null 2>&1
  }
  fp_persist() {
    local cfg="${J_CONF:-/storage/.config/system/configs/system.cfg}" tmp
    [ -f "${cfg}" ] || return 0
    tmp="${cfg}.paneladj.$$"
    if grep -q "^display\.${1}=" "${cfg}"
    then
      sed "s|^display\.${1}=.*|display.${1}=${2}|" "${cfg}" > "${tmp}"
    else
      { cat "${cfg}"; echo "display.${1}=${2}"; } > "${tmp}"
    fi
    mv -f "${tmp}" "${cfg}"
  }
  fp_worker() {
    local want applied=""
    exec 9>"${FP_DIR}/${1}.lock"
    flock -n 9 || return 0
    while :
    do
      want="$(cat "${FP_DIR}/${1}.want" 2>/dev/null)"
      [ "${want}" = "${applied}" ] && break
      applied="${want}"
      fp_apply "${1}" "${want}"
    done
    [ -n "${applied}" ] && fp_persist "${1}" "${applied}"
    flock -u 9
    [ "$(cat "${FP_DIR}/${1}.want" 2>/dev/null)" != "${applied}" ] && fp_worker "${1}"
    return 0
  }
  echo "${2}" > "${FP_DIR}/${1}.want.$$" && mv -f "${FP_DIR}/${1}.want.$$" "${FP_DIR}/${1}.want"
  fp_worker "${1}"
  exit 0
fi

. /etc/profile

# ARGS:
#
# 1 - property to adjust (gamma (brightness)/contrast/saturation/hue)
# 2 - up/down or a defined value

PROPERTY=${1}
NEWVAL=${2}

# Define the basics
MIN=0
MAX=100
STEP=1

if [ ! -e /dev/dri/card0 ]
then
  echo "ERROR: No display found."
  exit 1
fi

useConnectorPaneladj() {
  [ "${HW_DEVICE}" = "RK356X" ]
}

log() {
  $DEBUG && echo "Info: ${*}" >>/var/log/display.log
}

getActiveConnector() {
  modetest -M rockchip -c 2>/dev/null | awk '
    $3 == "connected" && $4 ~ /^DSI/ { print $1; exit }
  '
}

getConnectorValue() {
  local prop="${1}"
  local conn

  conn="$(getActiveConnector)"
  if [ -z "${conn}" ]
  then
    echo 50
    return
  fi

  modetest -M rockchip -c -p 2>/dev/null | awk -v conn="${conn}" -v prop="${prop}" '
    $1 == conn { active = 1; next }
    active && /^[0-9]+/ && $1 != conn { exit }
    active && $2 == prop ":" { found = 1; next }
    active && found && $1 == "value:" { print $2; exit }
  '
}

getValue() {
  MYVAL=$(get_setting display.${1})
  if [ -n "${MYVAL}" ]
  then
    if ! [[ "${MYVAL}" =~ ^[0-9]+$ ]]
    then
      MYVAL=50
    fi
    if [ "${MYVAL}" -gt "${MAX}" ]
    then
      MYVAL=${MAX}
    elif [ "${MYVAL}" -lt "${MIN}" ]
    then
      MYVAL=${MIN}
    fi
    echo ${MYVAL}
  else
    if useConnectorPaneladj
    then
      MYVAL=$(getConnectorValue "${1}")
    else
      MYVAL=$(modetest 2>/dev/null | awk -v prop="${1}" '
        $2 == prop ":" { found = 1; next }
        found && $1 == "value:" { print $2; exit }
      ')
    fi
    echo ${MYVAL:-50}
  fi
}

getActiveCrtc() {
  modetest 2>/dev/null | awk '
    /^CRTCs:/ { in_crtcs = 1; next }
    /^Planes:/ { in_crtcs = 0 }
    in_crtcs && $1 ~ /^[0-9]+$/ && $2 != "0" { print $1; exit }
  '
}

setViaSway() {
  local response

  if ! command -v swaymsg >/dev/null 2>&1
  then
    return 1
  fi

  if [ -z "${SWAYSOCK}" ]
  then
    RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/0-runtime-dir}"
    SWAYSOCK_CANDIDATE="${RUNTIME_DIR}/sway-ipc.$(id -u).sock"
    if [ -S "${SWAYSOCK_CANDIDATE}" ]
    then
      export SWAYSOCK="${SWAYSOCK_CANDIDATE}"
    fi
  fi

  response="$(swaymsg "paneladj * ${1} ${2}" 2>/dev/null)"
  echo "${response}" | grep -Eq '"success"[[:space:]]*:[[:space:]]*true'
}

setViaModetestConnector() {
  local conn

  conn="$(getActiveConnector)"
  if [ -z "${conn}" ]
  then
    return 1
  fi

  modetest -M rockchip -w "${conn}:${1}:${2}" >/dev/null 2>&1
}

setViaModetestCrtc() {
  local crtc

  crtc="$(getActiveCrtc)"
  if [ -z "${crtc}" ]
  then
    return 1
  fi

  modetest -w "${crtc}:${1}:${2}" >/dev/null 2>&1
}

setValue() {
  log "Set (${1}: ${2})"
  if useConnectorPaneladj
  then
    if setViaModetestConnector "${1}" "${2}"
    then
      set_setting display.${1} ${2}
    else
      echo "ERROR: Failed to set ${1} to ${2} on DSI connector."
      exit 1
    fi
  elif setViaSway "${1}" "${2}" || setViaModetestCrtc "${1}" "${2}"
  then
    set_setting display.${1} ${2}
  else
    echo "ERROR: Failed to set ${1} to ${2}."
    exit 1
  fi
}

stepUp() {
  LASTVAL=$(getValue ${PROPERTY})
  NEWVAL=$(expr ${LASTVAL} + 1)
  log "Step up (${PROPERTY}: ${NEWVAL})"
  setValue ${PROPERTY} ${NEWVAL}
}

stepDown() {
  LASTVAL=$(getValue ${PROPERTY})
  NEWVAL=$(expr ${LASTVAL} - 1)
  log "Step down (${PROPERTY}: ${NEWVAL})"
  setValue ${PROPERTY} ${NEWVAL}
}

restoreSettings() {
  for PROPERTY in brightness contrast saturation hue
  do
    RESTVAL=$(getValue ${PROPERTY})
    setValue ${PROPERTY} ${RESTVAL}
  done
}

case ${NEWVAL} in
  "up")
    stepUp
  ;;
  "down")
    stepDown
  ;;
  "restore")
    restoreSettings
  ;;
  *)
    if [[ "${NEWVAL}" =~ ^[0-9]+$ ]] && \
       [ "${NEWVAL}" -le "${MAX}" ] && \
       [ "${NEWVAL}" -ge "${MIN}" ]
    then
      setValue ${PROPERTY} ${NEWVAL}
    else
      echo "Error: Invalid value."
      exit 1
    fi
  ;;
esac
