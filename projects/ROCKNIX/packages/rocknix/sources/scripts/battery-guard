#!/bin/bash
# battery-guard: apaga la consola de forma limpia si la bateria esta por debajo de un voltaje seguro y no se esta cargando.
# Motivo: ni AURKNIX/ROCKNIX ni dArkOS apagan por software; la consola sigue viva hasta el corte fisico del PMIC (visto a 3,09 V).
# Umbrales (variables de entorno, para pruebas): BATGUARD_UV (3200000 uV), BATGUARD_READS (3 lecturas seguidas), BATGUARD_EVERY (10 s).
# Desactivar: crear /flash/no-batguard (desde Windows) o /storage/.config/no-batguard.
BAT=${BAT_DIR:-/sys/class/power_supply/battery}
LOW_UV=${BATGUARD_UV:-3200000}
NEED=${BATGUARD_READS:-3}
EVERY=${BATGUARD_EVERY:-10}
POWEROFF=${BATGUARD_POWEROFF:-systemctl poweroff}
# Ganchos para pruebas: fichero de procesos (lo escribe set_kill), killall, espera maxima en segundos.
KILLFILE=${BATGUARD_KILLFILE:-/tmp/.process-kill-data}
KILLALL=${BATGUARD_KILLALL:-killall}
WAIT=${BATGUARD_WAIT:-15}

# Cierra el juego en marcha con SIGTERM (como la tecla de matar, pero sin -9) para que guarde, y espera.
close_game() {
  [ -s "$KILLFILE" ] || return 0
  local first rest names="" w pids_left
  read -r first rest < "$KILLFILE"
  case "$first" in -*) ;; *) rest="$first $rest" ;; esac
  for w in $rest; do
    case "$w" in
      emulationstation|zfront|sway) logger -t battery-guard "no se cierra '$w' (protegido)"; continue ;;
      ''|*[!A-Za-z0-9._+-]*) logger -t battery-guard "nombre no valido en $KILLFILE, se ignora"; continue ;;
    esac
    names="$names $w"
  done
  [ -n "$names" ] || return 0
  logger -t battery-guard "cerrando juego (SIGTERM):$names"
  for w in $names; do $KILLALL -TERM "$w" 2>/dev/null; done
  local i=0
  while [ "$i" -lt "$WAIT" ]; do
    pids_left=0
    for w in $names; do $KILLALL -0 "$w" 2>/dev/null && pids_left=1; done
    [ "$pids_left" = 0 ] && break
    sleep 1
    i=$((i + 1))
  done
  if [ "$pids_left" = 0 ]; then
    logger -t battery-guard "juego cerrado tras ${i} s"
  else
    logger -t battery-guard "el juego sigue tras ${WAIT} s, se apaga igualmente"
  fi
  sync
  logger -t battery-guard "sincronizado"
}

[ -e /flash/no-batguard ] && exit 0
[ -e /storage/.config/no-batguard ] && exit 0

n=0
while true; do
  status=$(cat "$BAT/status" 2>/dev/null)
  v=$(cat "$BAT/voltage_avg" 2>/dev/null || cat "$BAT/voltage_now" 2>/dev/null)
  if [ -n "$v" ] && [ "$v" -gt 0 ] 2>/dev/null && [ "$v" -lt "$LOW_UV" ] && [ "$status" != "Charging" ] && [ "$status" != "Full" ]; then
    n=$((n + 1))
    logger -t battery-guard "bateria baja: ${v} uV (${status}), lectura ${n}/${NEED}"
  else
    n=0
  fi
  if [ "$n" -ge "$NEED" ]; then
    logger -t battery-guard "apagando: ${v} uV < ${LOW_UV} uV sin cargar"
    echo "battery-guard: apagando por bateria baja (${v} uV)" > /dev/kmsg 2>/dev/null
    close_game
    $POWEROFF
    exit 0
  fi
  sleep "$EVERY"
done
