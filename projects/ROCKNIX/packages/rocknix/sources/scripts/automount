. /etc/profile
. /etc/os-release

### Vars
UPDATE_ROOT="/storage/.update"
MOUNT_GAMES=$(get_setting system.automount)
GAMES_DEVICE=$(get_setting system.gamesdevice)
MS_PATH="/storage/roms"
OWN_LAYOUT=0


function unmount() {
  log $0 "Unmount ${1}."
  umount -f "${1}" 2>/dev/null ||:
}

### Zenith monta la tarjeta de juegos tal cual (/flash/ms_unsupported): su RAIZ va a /storage/roms, con las carpetas de los
### sistemas (gba, snes, psx...) sueltas en ella, como en ArkOS/dArkOS. Las tarjetas de ROCKNIX, muOS o Batocera llevan los
### sistemas dentro de "roms" (o "share/roms"): si esa carpeta tiene mas sistemas con juegos que la raiz, se enlaza esa.
### Reconoce los sistemas por el nombre exacto de la carpeta (los de es_systems); se omiten los nombres genericos (bios,
### themes, music, ports, pc, mac...). No mueve ni escribe nada en la tarjeta: solo elige que carpeta se enlaza.
ROM_SYSTEMS=" \
  3do amiga amigacd32 amstradcpc arcade arduboy atari2600 atari5200 atari7800 atari800 \
  atarijaguar atarilynx atarist atomiswave bbcmicro bbk c128 c16 c64 cdi channelf chip-8 coleco \
  cps1 cps2 cps3 daphne dreamcast easyrpg famicom fbneo fds gameandwatch gamegear gamegearh gb \
  gba gbah gbav gbc gbch gbh genesis genh hbmame intellivision krkr2 mame mastersystem megacd \
  megadrive megadrive-japan megadriveh megaduck mkxp mrp msx msx2 n64 naomi nds ndsiware neocd \
  neogeo nes nesh ngp ngpc odyssey onscripter openbor palm pc88 pc98 pcengine pcenginecd pcfx pet \
  pico-8 pokemini psp pspminis psx pymo satellaview saturn scummvm scv sega32x segacd sfc sg-1000 \
  sgfx snes snesh snesmsu1 st-v sufami supervision tg16 tg16cd tic-80 uzebox varcade vectrex \
  vic20 videopac vircon32 virtualboy wonderswan wonderswancolor x1 x68000 zmachine zx81 \
  zxspectrum \
 "

### $1 = carpeta. Imprime cuantas carpetas de sistemas con algo dentro tiene.
function count_systems() {
  local n=0 d l
  for d in "${1}"/*/
  do
    d=${d%/}
    d=${d##*/}
    l=${d,,}
    ### Los nombres reales solo llevan a-z, 0-9 y "-": cualquier otra cosa (espacios, signos) no es un sistema.
    case "${l}" in
      ""|*[!a-z0-9-]*) continue ;;
    esac
    ### En FAT/exFAT/NTFS "GBA" y "gba" son la misma carpeta; en ext4 no: solo cuenta si la ruta en minusculas ES esta carpeta.
    ### Solo cuentan las carpetas con algo dentro: las vacias no son juegos.
    case "${ROM_SYSTEMS}" in
      *" ${l} "*)
        if [ -d "${1}/${l}" ] && [ "${1}/${l}" -ef "${1}/${d}" ] && [ -n "$(ls -A "${1}/${l}" 2>/dev/null | head -n 1)" ]
        then
          n=$((n+1))
        fi
      ;;
    esac
  done
  echo ${n}
}

### $1 = punto de montaje. Imprime la carpeta a enlazar: la raiz, salvo que roms/ROMS/Roms/share/roms tenga mas sistemas.
function pick_roms_dir() {
  local m="${1}" d n best="${1}" bestn
  bestn=$(count_systems "${m}")
  for d in "${m}/roms" "${m}/ROMS" "${m}/Roms" "${m}/share/roms"
  do
    [ -d "${d}" ] || continue
    n=$(count_systems "${d}")
    if [ "${n}" -ge 1 ] && [ "${n}" -gt "${bestn}" ]
    then
      best="${d}"
      bestn=${n}
    fi
  done
  echo "${best}"
}

### $1 = particion. Imprime el disco al que pertenece (mmcblk1p3 -> mmcblk1).
function disk_of() {
  echo "${1}" | sed -e "s#^/.*/##g" -e "s#p[0-9].*\$##g"
}

### $1 = punto de montaje, $2 = particion. Enlaza la tarjeta a /storage/roms (Zenith, sin almacenamiento combinado).
function bind_games_root() {
  local src sysdisk
  src=$(pick_roms_dir "${1}")
  if [ ! "${src}" = "${1}" ]
  then
    log $0 "Card keeps its systems in ${src}, using it."
  fi
  log $0 "Executing bind mount of ${src} to ${MS_PATH}"
  mount --bind "${src}" ${MS_PATH}

  ### Tarjeta de OTRO disco que ya trae sus juegos: no se le crean carpetas de sistemas vacias.
  sysdisk=${SYSTEM_DISK:-$(disk_of "$(awk '$2 == "/flash" {print $1}' /proc/mounts | head -1)")}
  if [ -n "${sysdisk}" ] && [ ! "$(disk_of "${2}")" = "${sysdisk}" ] && [ "$(count_systems "${src}")" -ge 3 ]
  then
    OWN_LAYOUT=1
  fi
}

function start_ms() {
  ### Entrypoint will be either games card found (external), or not found (internal).
  MOUNT_PATH="/storage/games-${1}"

  MS_DEVICE=$(get_setting system.merged.device)
  ### If the merge target isn't defined and we have an external microsd, we should use the external card by default.
  if [ -z "${MS_DEVICE}" ] && \
     [ "${1}" = "external" ]
  then
    set_setting system.merged.device external
  fi

  ### Determine if internal or external is the primary target by configuration.
  case ${MS_DEVICE} in
    internal)
      LOWER="external"
      UPPER="internal"
    ;;
    *)
      LOWER="internal"
      UPPER="external"
    ;;
  esac

  for GAME_PATH in internal external
  do
    if [ ! -d "/storage/games-${GAME_PATH}/roms" ]
    then
      log $0 "Create /storage/games-${GAME_PATH}/roms."
      mkdir -p "/storage/games-${GAME_PATH}/roms"
    fi
  done

  MS_ENABLED=$(get_setting system.merged.storage)
  if [ -e "/storage/.ms_unsupported" ] || \
     [ ! "${MS_ENABLED}" = 1 ]
  then
    log $0 "Executing bind mount of ${MOUNT_PATH} to ${MS_PATH}"
    mount --bind ${MOUNT_PATH}/roms ${MS_PATH}
  else
    log $0 "Enabling merged storage of /storage/games-${LOWER} and /storage/games-${UPPER} to ${MS_PATH}."

    for DIR in /storage/games-${UPPER}/.tmp/games-workdir /storage/games-${LOWER}/roms /storage/games-${UPPER}/roms
    do
      if [ ! -d "${DIR}" ]
      then
        mkdir -p "${DIR}"
      fi
    done
    mount overlay -t overlay -o lowerdir=/storage/games-${LOWER}/roms,upperdir=/storage/games-${UPPER}/roms,workdir=/storage/games-${UPPER}/.tmp/games-workdir ${MS_PATH}
  fi
  # fast-7: las ROMs ya estan montadas; ES (parche 0045) solo necesita esto para escanear los sistemas, no el resto del script
  touch /run/rocknix-automount.ready
}

start_overlay() {
  if [ -e "/storage/.overlay_unsupported" ]
  then
    # If we're not using the overlay, bind mount the external storage path
    # so we don't need to change any configs.
    grep ${MOUNT_PATH} /proc/mounts >/dev/null 2>&1
    if [ ! $? = 0 ]
    then
      MOUNT_PATH="/storage/games-internal"
    fi
    log $0 "Executing bind mount of ${MOUNT_PATH} to ${OVERLAY_PATH}"
    mount --bind ${MOUNT_PATH} ${OVERLAY_PATH}
    exit 0
  else
    log $0 "Enabling overlay."
    systemctl enable storage-roms.mount >/dev/null 2>&1
    systemctl start storage-roms.mount >/dev/null 2>&1
  fi
}

if [[ ! "${MOUNT_GAMES}" =~ [0-9] ]]
then
  set_setting system.automount 1
elif [[ "${MOUNT_GAMES}" == "0" ]]
then
  start_ms internal
  exit 0
fi

function create_game_dirs() {
  if [ "${OWN_LAYOUT}" = 1 ]
  then
    log $0 "Card with its own games, not creating game directories."
    return
  fi
  ### We don't want systemd to manage this or the directories could be created in the wrong location.
  if [ -e "/usr/config/system-dirs.conf" ]
  then
    log $0 "Creating game directories."
    systemd-tmpfiles --create /usr/config/system-dirs.conf >/dev/null 2>&1 ||:
  fi
}

function load_modules() {
  for MODULE in exfat vfat ntfs ntfs3
  do
    lsmod | grep ${MODULE} >/dev/null 2>&1
    if [ ! $? = 0 ]
    then
      log $0 "Loading ${MODULE}."
      modprobe ${MODULE} >/dev/null 2>&1
    fi
  done
}

function mount_games() {
      MOUNT_PATH="/storage/games-external"
      FSTYPE=$(blkid -o export ${1} | awk 'BEGIN {FS="="} /TYPE/ {print $2}')
      case ${FSTYPE} in
        ext4 | btrfs)
          log $0 "Found supported partition for overlayfs."
          if [ -e "/storage/.ms_unsupported" ]
          then
            rm -f /storage/.ms_unsupported
          fi
	  touch /storage/.ms_supported
        ;;
        *)
          log $0 "Partition does not support overlayfs, disabling."
          if [ -e "/storage/.ms_supported" ]
          then
            rm -f /storage/.ms_supported
          fi
          touch /storage/.ms_unsupported
        ;;
      esac

      # busybox has some weird behaviour with helpers.
      # Despite mount.ntfs is present, it is not used, so just a stupid rewrite to use newer kernel ntfs3 driver
      case ${FSTYPE} in
        ntfs)   MOUNT_ARGS="-t ntfs3" ;;
        *)      true ;;
      esac
      MOUNT_ARGS+=" -o rw,utf8,noatime ";

      if [ ! -d "${MOUNT_PATH}" ]
      then
        log $0 "Create directory ${MOUNT_PATH}"
        /usr/bin/busybox mkdir -p ${MOUNT_PATH} >/dev/null 2>&1
      fi

      NULL=$(cat /proc/mounts | grep -v -e "/var/media" 2>/dev/null | grep ${1})
      if [ ! "$?" = "0" ] && \
         [ -e "${1}" ] && \
         [ ! -e "/storage/.please_resize_me" ]
      then

        ### Udevil shouldn't mount it this early, but just in-case.
        umount /var/media/* 2>/dev/null

        log $0 "Mounting ${1} on ${MOUNT_PATH}"
        /usr/bin/busybox mount ${MOUNT_ARGS} ${1} ${MOUNT_PATH} >/dev/null 2>&1

        log $0 "Checking filesystem ${1}."
        if ! touch "${MOUNT_PATH}/.tmp-rocknix"; then
          log $0 "Fixing filesystem ${1}."
          
          /usr/bin/fsck_prompt &
          MPV_PID=$!
          
          /usr/bin/busybox umount ${1} >/dev/null 2>&1
          /usr/sbin/fsck -Mly ${1} >/dev/null 2>&1
          /usr/bin/busybox mount ${MOUNT_ARGS} ${1} ${MOUNT_PATH} >/dev/null 2>&1
          
          kill $MPV_PID 2>/dev/null
          wait $MPV_PID 2>/dev/null
        else
          rm "${MOUNT_PATH}/.tmp-rocknix"
	fi
      fi
      if [ -e "/flash/ms_unsupported" ]
      then
	      bind_games_root "${MOUNT_PATH}" "${1}"
      else
              start_ms external
      fi
      if [ ! -d "/storage/roms/music" ]
      then
	      create_game_dirs
      fi
      exit 0
}

function find_games() {
  if /usr/bin/busybox mountpoint -q /storage
  then
    ### Detect system disk from /flash mount point
    SYSTEM_DISK=""
    FLASH_DEV=$(awk '$2 == "/flash" {print $1}' /proc/mounts | head -1)
    if [ -n "${FLASH_DEV}" ]
    then
      SYSTEM_DISK=$(echo ${FLASH_DEV} | sed -e "s#^/.*/##g" -e "s#p[0-9].*\$##g")
      log $0 "System disk detected: ${SYSTEM_DISK}"
    fi

    ### Collect all candidate partitions, separated by system/non-system disk
    SYSTEM_PARTITIONS=""
    OTHER_PARTITIONS=""
    for dev in "mmcblk[0-9]" "sd[a-z]" "nvme[0-9]"; do
      for PART in $(blkid | grep -E "/dev/${dev}" | awk 'BEGIN {FS=":"}; /ext4/ || /btrfs/ || /fat/ || /ntfs/ {print $1}' | sort -r); do
        ROOTDEV=$(echo ${PART} | sed -e "s#^/.*/##g" -e "s#p[0-9].*\$##g")
        if [ "${ROOTDEV}" = "${SYSTEM_DISK}" ]
        then
          SYSTEM_PARTITIONS="${SYSTEM_PARTITIONS} ${PART}"
        else
          OTHER_PARTITIONS="${OTHER_PARTITIONS} ${PART}"
        fi
      done
    done

    ### Process non-system disk partitions first, then system disk partitions
    for DEV in ${OTHER_PARTITIONS} ${SYSTEM_PARTITIONS}
    do
      [ -z "${DEV}" ] && continue
      ROOTDEV=$(echo ${DEV} | sed -e "s#^/.*/##g" -e "s#p[0-9].*\$##g")
      log $0 "Inspecting ${DEV}."
      SIZE=$(awk -v dev="${ROOTDEV}" '$4 == dev {print $3; exit}' /proc/partitions)
      if [ -z "${SIZE}" ] && [ -r "/sys/class/block/${ROOTDEV}/size" ]
      then
        SIZE=$(($(cat "/sys/class/block/${ROOTDEV}/size") / 2))
      fi
      if [ -z "${SIZE}" ] || (( SIZE <= 8388608 ))
      then
        log $0 "Device ${ROOTDEV} is too small, ignoring."
        # We don't want to mount partitions smaller than ~8GB.
        continue
      fi
      if [ -L "/sys/class/block/${ROOTDEV}boot0" ]
      then
        log $0 "Device ${ROOTDEV} might be Android, ignoring."
        # Assume this is an android boot device and ignore it.
        continue
      fi
      ISMOUNTED="$(grep "${DEV}" /proc/mounts) >/dev/null 2>&1"
      if [ ! "$?" = 0 ] && \
         [ -e "${DEV}" ] && \
         [ ! -e "/storage/.please_resize_me" ]
      then
        GAMES_DEVICE=${DEV}
        log $0 "Found ${DEV} available to mount."
        mount_games "${DEV}"
      else
        log $0 "${DEV} not available."
      fi
    done
    log $0 "Could not find external card to mount, assume internal."

    MS_DEVICE=$(get_setting system.merged.device)
    ### If the merge target isn't defined and we do not have an external microsd, we should use the internal card by default.
    if [ -z "${MS_DEVICE}" ]
    then
      set_setting system.merged.device internal
    fi
    if [ ! -e "/flash/ms_unsupported" ]
    then
	start_ms internal
    fi

    create_game_dirs
    exit 0
  fi
}

## Main..

### Para las pruebas: cargar las funciones sin ejecutar nada.
[ -n "${AUTOMOUNT_SOURCE_ONLY}" ] && return 0

load_modules

### Unmount any existing storage before beginning operations.
unmount /storage/games-external
unmount /storage/roms

if [ -e "${GAMES_DEVICE}" ]
then
  mount_games ${GAMES_DEVICE}
else
  find_games
fi
