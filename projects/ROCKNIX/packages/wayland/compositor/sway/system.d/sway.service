[Unit]
Description=Sway Wayland Compositor
Before=graphical.target
# arranque temprano (Zenith): sway ya no espera a multi-user.target ni a automount; lo lanza autostart cuando pantalla/GPU/udev estan listos
Wants=seatd.service
After=seatd.service
ConditionKernelCommandLine=!installer

[Service]
Environment=HOME=/storage
Environment=XDG_RUNTIME_DIR=/var/run/0-runtime-dir
Environment=WLR_BACKENDS=drm,libinput
EnvironmentFile=-/storage/.config/profile.d/095-sway
EnvironmentFile=/usr/share/sway/sway-daemon.conf
EnvironmentFile=-/run/sway/sway-daemon.conf
WorkingDirectory=/storage
# puerta de arranque (Zenith): autostart crea /run/zenith-ui-ready cuando GPU, pantalla y udev estan listos (maximo 60 s de espera)
ExecStartPre=/bin/sh -c 'i=0; while [ ! -e /run/zenith-ui-ready ] && [ $i -lt 3000 ]; do sleep 0.02; i=$((i+1)); done'
ExecStartPre=-/usr/lib/sway/sway-config
ExecStart=/usr/bin/sway.sh
Restart=always
RestartSec=5

[Install]
Alias=display-manager.service
WantedBy=graphical.target
