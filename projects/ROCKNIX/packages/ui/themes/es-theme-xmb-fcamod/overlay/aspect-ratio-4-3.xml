<theme>
   <formatVersion>7</formatVersion>
   <view name="screen">
      <batteryIndicator name="batteryIndicator">
         <visible>false</visible>
      </batteryIndicator>
      <text name="clock">
         <pos>1 1</pos>
      </text>
      <stackpanel name="xmb-status" extra="true">
         <h>0.0417</h>
         <w>1</w>
         <pos>-0.025 0.0242</pos>
         <separator>0.0156</separator>
         <zIndex>100</zIndex>
         <orientation>horizontal</orientation>
         <reverse>true</reverse>
         <clock name="xmb-clock" extra="true">
            <color>ffffff</color>
            <fontSize>0.0333</fontSize>
            <lineSpacing>1</lineSpacing>
            <fontPath>./_inc/fonts/FOT-NewRodin Pro DB.otf</fontPath>
         </clock>
         <batteryText name="xmb-battery-text" extra="true">
            <color>ffffffcc</color>
            <fontSize>0.0333</fontSize>
            <lineSpacing>1</lineSpacing>
            <fontPath>./_inc/fonts/FOT-NewRodin Pro DB.otf</fontPath>
         </batteryText>
         <batteryIcon name="xmb-battery-icon" extra="true">
            <maxSize>1 1</maxSize>
            <color>ffffff</color>
            <full>./zenith-status/battery-icon-100.svg</full>
            <at75>./zenith-status/battery-icon-75.svg</at75>
            <at50>./zenith-status/battery-icon-50.svg</at50>
            <at25>./zenith-status/battery-icon-25.svg</at25>
            <empty>./zenith-status/battery-icon-0.svg</empty>
            <incharge>./zenith-status/battery-icon-charging.svg</incharge>
         </batteryIcon>
         <networkIcon name="xmb-network-icon" extra="true">
            <maxSize>1 1</maxSize>
            <color>ffffff</color>
            <networkIcon>./zenith-status/network-icon-on.svg</networkIcon>
            <planemodeIcon>./zenith-status/network-icon-off.svg</planemodeIcon>
         </networkIcon>
      </stackpanel>
   </view>
   <view name="system">
      <carousel name="systemcarousel">
         <type>horizontal</type>
         <logoAlignment>center</logoAlignment>
         <pos>-0.79 0.20</pos>
         <size>1.98 0.22</size>
         <logoSize>0.12 0.12</logoSize>
         <logoScale>1.3</logoScale>
         <maxLogoCount>9</maxLogoCount>
         <defaultTransition>instant</defaultTransition>
         <origin>0 0</origin>
      </carousel>
      <image name="e_system_content" extra="true">
         <pos>0.20 0.49</pos>
         <maxSize>0.15 0.12</maxSize>
         <origin>0.5 0.5</origin>
      </image>
      <text name="e_system_name" extra="true">
         <pos>0.30 0.41</pos>
         <size>0.65 0.07</size>
         <fontSize>0.06</fontSize>
      </text>
      <image name="e_metadata_line" extra="true">
         <pos>0.30 0.50</pos>
         <size>0.72 0.002</size>
      </image>
      <text name="systemInfo">
         <pos>0.30 0.52</pos>
         <size>0.65 0.05</size>
         <fontSize>0.03</fontSize>
      </text>
   </view>
   <view name="system,grid">
      <helpsystem name="help">
         <pos>0.027 0.920</pos>
         <iconColor>00000000</iconColor>
         <textColor>00000000</textColor>
      </helpsystem>
      <image name="e_help_start_icon" extra="true">
         <path>./_inc/images/buttons/${buttonStyle}/start.svg</path>
         <pos>0.027 0.920</pos>
         <maxSize>0.045 0.06</maxSize>
         <origin>0 0</origin>
         <color>ffffffcc</color>
         <zIndex>90</zIndex>
      </image>
      <text name="e_help_start_text" extra="true">
         <text>${helpMenu}</text>
         <pos>0.079125 0.920</pos>
         <size>0.20 0.06</size>
         <fontSize>0.035</fontSize>
         <color>ffffffcc</color>
         <fontPath>./_inc/fonts/FOT-NewRodin Pro DB.otf</fontPath>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <zIndex>90</zIndex>
      </text>
      <image name="e_help_a_icon" extra="true">
         <path>./_inc/images/buttons/${buttonStyle}/${confirmButton}.svg</path>
         <pos>0.973 0.920</pos>
         <maxSize>0.045 0.06</maxSize>
         <origin>1 0</origin>
         <color>ffffffcc</color>
         <zIndex>90</zIndex>
      </image>
      <text name="e_help_a_text" extra="true">
         <text>${helpSelect}</text>
         <pos>0.919875 0.920</pos>
         <size>0.42 0.06</size>
         <fontSize>0.035</fontSize>
         <color>ffffffcc</color>
         <fontPath>./_inc/fonts/FOT-NewRodin Pro DB.otf</fontPath>
         <alignment>right</alignment>
         <verticalAlignment>center</verticalAlignment>
         <origin>1 0</origin>
         <zIndex>90</zIndex>
      </text>
   </view>
   <view name="grid">
      <image name="logo">
         <pos>2 2</pos>
      </image>
      <text name="logoText">
         <pos>2 2</pos>
      </text>
      <imagegrid name="gamegrid">
         <pos>0.02 0.125</pos>
         <size>0.30 0.75</size>
         <padding>0 0 0 0</padding>
         <autoLayout>1 3</autoLayout>
         <scrollDirection>verticalCenter</scrollDirection>
         <centerSelection>true</centerSelection>
         <autoLayoutSelectedZoom>1.0</autoLayoutSelectedZoom>
         <imageSource>marquee</imageSource>
         <folderImage>./_inc/images/xmb_folder.png</folderImage>
         <gameImage>./_inc/images/xmb_game.png</gameImage>
         <zIndex>50</zIndex>
         <scrollSound>./_inc/sounds/scroll.wav</scrollSound>
      </imagegrid>
      <gridtile name="default">
         <size>0.30 0.25</size>
         <padding>0 0</padding>
         <imageSizeMode>maxSize</imageSizeMode>
         <backgroundCenterColor>00000000</backgroundCenterColor>
         <backgroundEdgeColor>00000000</backgroundEdgeColor>
      </gridtile>
      <gridtile name="selected">
         <backgroundCenterColor>00000000</backgroundCenterColor>
         <backgroundEdgeColor>00000000</backgroundEdgeColor>
      </gridtile>
      <text name="md_name">
         <pos>0.40 0.42</pos>
         <size>0.60 0.08</size>
         <fontSize>0.035</fontSize>
         <fontPath>${fontBold}</fontPath>
         <color>ffffff</color>
         <alignment>left</alignment>
         <zIndex>60</zIndex>
      </text>
      <image name="md_line" extra="true">
         <path>${spacerImage}</path>
         <pos>0.40 0.50</pos>
         <size>0.60 0.002</size>
         <color>ffffff88</color>
         <zIndex>55</zIndex>
      </image>
      <text name="md_description">
         <pos>0.40 0.52</pos>
         <size>0.60 0.35</size>
         <fontSize>0.025</fontSize>
         <fontPath>${fontRegular}</fontPath>
         <color>ffffffcc</color>
         <alignment>left</alignment>
         <zIndex>60</zIndex>
      </text>
      <image name="md_image">
         <pos>0.5 0.5</pos>
         <minSize>1.01 1.01</minSize>
         <origin>0.5 0.5</origin>
         <zIndex>1</zIndex>
      </image>
      <video name="md_video">
         <pos>0.5 0.5</pos>
         <minSize>1.01 1.01</minSize>
         <origin>0.5 0.5</origin>
         <delay>2.0</delay>
         <zIndex>2</zIndex>
      </video>
   </view>
</theme>
