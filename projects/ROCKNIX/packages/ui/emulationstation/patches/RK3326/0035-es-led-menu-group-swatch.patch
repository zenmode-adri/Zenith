+// Zenith: punto de color que muestra el modo elegido del LED (rojo, verde... arcoiris); gris hueco si esta apagado
+class LedSwatchComponent : public GuiComponent
+{
+public:
+	LedSwatchComponent(Window* window) : GuiComponent(window) { }
+
+	void setMode(const std::string& mode) { mMode = Utils::String::toLower(mode); }
+
+	void render(const Transform4x4f& parentTrans) override
+	{
+		if (mSize.y() <= 0)
+			return;
+
+		Renderer::setMatrix(parentTrans * getTransform());
+
+		const unsigned int rainbow[6] = { 0xF04438FF, 0xFF9500FF, 0xFFD60AFF, 0x34C759FF, 0x2F7BFFFF, 0xA855F7FF };
+		unsigned int color = 0;
+		bool isRainbow = false, hollow = false;
+
+		if (mMode == "red" || mMode == "heartbeat" || mMode == "breath" || mMode == "breath_red") color = 0xF04438FF;
+		else if (mMode == "yellow") color = 0xFFD60AFF;
+		else if (mMode == "orange" || mMode == "breath_orange") color = 0xFF9500FF;
+		else if (mMode == "green" || mMode == "battery" || mMode == "breath_green") color = 0x34C759FF;
+		else if (mMode == "cyan" || mMode == "breath_cyan") color = 0x00C2D8FF;
+		else if (mMode == "blue" || mMode == "breath_blue") color = 0x2F7BFFFF;
+		else if (mMode == "purple" || mMode == "breath_purple") color = 0xA855F7FF;
+		else if (mMode == "white" || mMode == "breath_white") color = 0xFFFFFFFF;
+		else if (mMode == "rainbow" || mMode == "flow") isRainbow = true;
+		else hollow = true; // off / default / desconocido
+
+		const float d = mSize.y();
+		const float r = d / 2.0f;
+
+		for (int row = 0; row < (int)d; row++)
+		{
+			const float dy = row + 0.5f - r;
+			const float half = sqrtf(Math::max(0.0f, r * r - dy * dy));
+			// borde (circulo completo, gris oscuro) y relleno (circulo 1.5 px mas pequeno)
+			Renderer::drawRect(r - half, (float)row, 2.0f * half, 1.0f, 0x5F5F66FF);
+
+			const float ri = r - 1.5f;
+			const float halfIn = sqrtf(Math::max(0.0f, ri * ri - dy * dy));
+			if (halfIn <= 0.0f)
+				continue;
+
+			if (hollow)
+				Renderer::drawRect(r - halfIn, (float)row, 2.0f * halfIn, 1.0f, 0xE4E4E9FF);
+			else if (isRainbow)
+			{
+				const float w = 2.0f * halfIn / 6.0f;
+				for (int k = 0; k < 6; k++)
+					Renderer::drawRect(r - halfIn + k * w, (float)row, w + 0.5f, 1.0f, rainbow[k]);
+			}
+			else
+				Renderer::drawRect(r - halfIn, (float)row, 2.0f * halfIn, 1.0f, color);
+		}
+	}
+
+private:
+	std::string mMode;
+};
