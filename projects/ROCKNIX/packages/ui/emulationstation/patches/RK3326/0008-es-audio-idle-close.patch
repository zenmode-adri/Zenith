+void AudioManager::touch()
+{
+	if (sInstance != nullptr)
+		sInstance->mIdleMs = 0;
+}
+
+bool AudioManager::isSuspended()
+{
+	return sInstance != nullptr && sInstance->mIdleSuspended;
+}
+
+// Close the SDL audio device after a long silence. Chunks are freed and reloaded by wake().
+void AudioManager::suspendIdle()
+{
+	if (!mInitialized || mIdleSuspended)
+		return;
+
+	// Music playing (or just finished and not yet stopped) keeps the device in use
+	if (mCurrentMusic != nullptr || Mix_PlayingMusic() != 0)
+		return;
+
+	if (Mix_Playing(-1) != 0)
+		return;
+
+	LOG(LogInfo) << "SDL AUDIO idle, closing device";
+
+	for (unsigned int i = 0; i < sSoundVector.size(); i++)
+		sSoundVector[i]->deinit();
+
+	Mix_HookMusicFinished(nullptr);
+	Mix_CloseAudio();
+	SDL_QuitSubSystem(SDL_INIT_AUDIO);
+
+	mIdleSuspended = true;
+}
+
+// Reopen the device closed by suspendIdle(), same open logic as init()
+void AudioManager::wake()
+{
+	if (!mIdleSuspended)
+		return;
+
+	LOG(LogInfo) << "SDL AUDIO waking up";
+
+	if (SDL_InitSubSystem(SDL_INIT_AUDIO) != 0)
+	{
+		LOG(LogError) << "Error initializing SDL audio!\n" << SDL_GetError();
+		mIdleSuspended = false;
+		mInitialized = false;
+		return;
+	}
+
+	if (Mix_OpenAudio(48000, MIX_DEFAULT_FORMAT, 2, 4096) < 0 && Mix_OpenAudio(44100, MIX_DEFAULT_FORMAT, 2, 4096) < 0)
+	{
+		LOG(LogError) << "MUSIC Error - Unable to reopen SDLMixer audio: " << SDL_GetError() << std::endl;
+		SDL_QuitSubSystem(SDL_INIT_AUDIO);
+		mIdleSuspended = false;
+		mInitialized = false;
+		return;
+	}
+
+	mIdleSuspended = false;
+	mIdleMs = 0;
+
+	// Reload known sounds (Sound::init() does nothing while suspended)
+	for (unsigned int i = 0; i < sSoundVector.size(); i++)
+		sSoundVector[i]->init();
+
+	Mix_VolumeMusic((int)mMusicVolume);
+}
