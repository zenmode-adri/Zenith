+// Output of static helper scripts (keyboard layouts, time zones...) is cached per session. The scripts
+// are started in a background thread as soon as the main menu opens, so that System Settings does not
+// block the UI thread waiting for them. Callers asking before the result is ready just wait for it.
+static std::shared_future<std::string> cachedShOutputFuture(const std::string& command)
+{
+	static std::mutex cacheMutex;
+	static std::map<std::string, std::shared_future<std::string>> cache;
+
+	std::lock_guard<std::mutex> lock(cacheMutex);
+	auto it = cache.find(command);
+	if (it == cache.end())
+		it = cache.emplace(command, std::async(std::launch::async, [command] { return Utils::Platform::GetShOutput(command); }).share()).first;
+	return it->second;
+}
+
+static std::string cachedShOutput(const std::string& command)
+{
+	return cachedShOutputFuture(command).get();
+}
+
+static void prewarmMenuCaches()
+{
+	cachedShOutputFuture("/usr/bin/rocknix-keyboard list-layouts");
+	cachedShOutputFuture(R"(/usr/bin/timeinfo timezones)");
+}
+#endif
