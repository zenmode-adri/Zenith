+float Window::getScreenExtraCenterY(const std::string& tag) const
+{
+	for (auto extra : mScreenExtras)
+		if (extra->getTag() == tag)
+	{
+			const Vector2f origin = extra->getOrigin();
+			return extra->getPosition().y() + (0.5f - origin.y()) * extra->getSize().y();
+		}
+
+	return -1.0f;
+}
