+float Window::getWindowMaxHeight() const
+{
+	const float H = (float)Renderer::getScreenHeight();
+	// borde inferior de la barra de estado = 2 x su centro (el aire de arriba es el mismo que el de abajo)
+	const float center = getScreenExtraCenterY("zs-avatar");
+	const float margin = center > 0 ? center * 2.0f : H * 0.0625f; // sin barra en el tema: el 0.875 original
+	return Math::max(H * 0.5f, H - 2.0f * margin);
+}
