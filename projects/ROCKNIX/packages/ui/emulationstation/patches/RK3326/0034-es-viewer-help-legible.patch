+// La pista de ayuda (B CERRAR) se dibuja sobre la imagen a pantalla completa: texto claro sobre una pastilla oscura
+// semitransparente, del tamano justo de la pista, para que se lea sea cual sea la imagen (clara u oscura).
+HelpStyle GuiImageViewer::getHelpStyle()
+{
+	HelpStyle style = GuiComponent::getHelpStyle();
+	style.textColor = 0xFFFFFFFF;
+	style.iconColor = 0xFFFFFFFF;
+	return style;
+}
+
+void GuiImageViewer::render(const Transform4x4f& parentTrans)
+{
+	GuiComponent::render(parentTrans);
+
+	HelpComponent* help = mWindow->getHelpComponent();
+	if (help == nullptr || help->getGrid() == nullptr)
+		return;
+
+	auto grid = help->getGrid();
+	const float padX = Renderer::getScreenHeight() * 0.016f;
+	const float padY = Renderer::getScreenHeight() * 0.006f;
+	const float w = grid->getSize().x() + 2.0f * padX;
+	const float h = grid->getSize().y() + 2.0f * padY;
+	const float x0 = grid->getPosition().x() - grid->getOrigin().x() * grid->getSize().x() - padX;
+	const float y0 = grid->getPosition().y() - grid->getOrigin().y() * grid->getSize().y() - padY;
+
+	Renderer::setMatrix(parentTrans * getTransform());
+	// pastilla (extremos redondeados) dibujada en franjas de 1 px
+	const float r = h / 2.0f;
+	for (int row = 0; row < (int)h; row++)
+	{
+		const float dy = fabsf(row + 0.5f - r);
+		const float inset = r - sqrtf(Math::max(0.0f, r * r - dy * dy));
+		Renderer::drawRect(x0 + inset, y0 + row, w - 2.0f * inset, 1.0f, 0x0000009E);
+	}
+}
