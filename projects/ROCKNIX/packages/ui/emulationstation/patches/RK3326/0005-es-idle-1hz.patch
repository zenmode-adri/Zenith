+static std::atomic<bool> sWakePending(false);
+static std::atomic<int> sWakeEventID(-1);
+
+void PowerSaver::wake()
+{
+	int id = sWakeEventID.load();
+	if (id < 0)
+		return; // not initialised yet (init() runs on the UI thread before the loop)
+
+	bool expected = false;
+	if (!sWakePending.compare_exchange_strong(expected, true))
+		return; // an event is already queued
+
+	SDL_Event ev {};
+	ev.type = (Uint32)id;
+	if (SDL_PushEvent(&ev) <= 0)
+		sWakePending = false;
+}
+
+void PowerSaver::resetWake()
+{
+	sWakePending = false;
+}
