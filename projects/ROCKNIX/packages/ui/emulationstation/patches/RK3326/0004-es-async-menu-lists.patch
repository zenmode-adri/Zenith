+	// Runs query on a worker thread and, back on the UI thread, replaces the entries with what fill adds.
+	// The caller builds the list with a placeholder first (usually the current value, selected) so the menu
+	// opens at once. Rules:
+	//  - query runs OFF the UI thread: it must not touch UI objects, SystemConf or any non thread safe state.
+	//  - fill runs on the UI thread, on an emptied list. It must also be callable with an empty result (the
+	//    placeholder pass) and must leave the stored value selected, so that changed() stays false until the
+	//    user really changes it.
+	//  - the result is dropped if this component is destroyed meanwhile (mAlive) or if accept() returns
+	//    false; if the popup is open the refill waits until it is closed.
+	//  - the selection the user made before the result arrived is kept; the selected-changed callback is
+	//    not fired by a refill.
+	template<typename R>
+	void populateAsync(const std::function<R()>& query, const std::function<void(OptionListComponent<T>*, const R&)>& fill, const std::function<bool()>& accept = nullptr)
+	{
+		if (mMultiSelect)
+			return;
+
+		auto alive = mAlive;
+		auto window = mWindow;
+		std::thread([this, alive, window, query, fill, accept]
+		{
+			try
+			{
+				R result = query();
+				window->postToUiThread([this, alive, result, fill, accept]
+				{
+					if (!*alive)
+						return;
+
+					if (accept && !accept())
+						return;
+
+					mPendingFill = [this, result, fill] { refill<R>(result, fill); };
+					if (!mPopupOpen)
+						applyPendingFill();
+				});
+			}
+			catch (...)
+			{
+				// the placeholder stays
+			}
+		}).detach();
+	}
