+// Same cache, for menus that fetch the output in a worker thread: look it up before spawning the thread and
+// store the result from the UI thread (the populateAsync fill callback).
+static bool peekSessionShOutput(const std::string& key, std::string& value)
+{
+	auto& cache = sessionShOutputCache();
+	auto it = cache.find(key);
+	if (it == cache.end())
+		return false;
+
+	value = it->second;
+	return true;
+}
+
+static void storeSessionShOutput(const std::string& key, const std::string& value)
+{
+	sessionShOutputCache()[key] = value;
+}
+
 static void invalidateSessionShOutput(const std::string& key)
 {
 	sessionShOutputCache().erase(key);
