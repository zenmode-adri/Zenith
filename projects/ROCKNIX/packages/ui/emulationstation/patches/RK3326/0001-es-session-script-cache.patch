+// Session cache for the outputs of the distro scripts invoked while building menus.
+// popen()/sh spawning sources /etc/profile on this distro and freezes the UI thread
+// for up to seconds on low-end devices, so each script output is fetched at most
+// once per session. All reads and writes of this cache MUST happen in the UI thread.
+static std::map<std::string, std::string>& sessionShOutputCache()
+{
+	static std::map<std::string, std::string> cache;
+	return cache;
+}
+
+static std::string getSessionShOutput(const std::string& key, const std::string& command)
+{
+	auto& cache = sessionShOutputCache();
+	auto it = cache.find(key);
+	if (it != cache.end())
+		return it->second;
+
+	std::string value = Utils::Platform::GetShOutput(command);
+	cache[key] = value;
+	return value;
+}
+
+static void invalidateSessionShOutput(const std::string& key)
+{
+	sessionShOutputCache().erase(key);
+}
+
+// /usr/bin/device-switch with no argument cats a sysfs attribute
+static std::string getDeviceSwitchCurrent()
+{
+	std::string value = Utils::FileSystem::readAllText("/sys/firmware/devicetree/base/rocknix,device_switch/this");
+	size_t nul = value.find('\0');
+	if (nul != std::string::npos)
+		value = value.substr(0, nul);
+	value = Utils::String::trim(value);
+	return value;
+}
+
+// /usr/bin/device-switch --options lists the same sysfs directory
+static std::string getDeviceSwitchOptions()
+{
+	std::vector<std::string> names;
+	for (auto entry : Utils::FileSystem::getDirContent("/sys/firmware/devicetree/base/rocknix,device_switch"))
+	{
+		std::string name = Utils::FileSystem::getFileName(entry);
+		if (name != "name" && name != "this")
+			names.push_back(name);
+	}
+	std::sort(names.begin(), names.end());
+	std::string out;
+	for (auto name : names)
+		out += name + " ";
+	return out;
+}
+
+// /usr/bin/dtb_overlay get <type> greps FDTOVERLAYS in /flash/extlinux/extlinux.conf
+static std::string getDtbOverlayCurrent(const std::string& dtbType)
+{
+	static const std::vector<std::string> specializations = { "undervolt-cpu", "undervolt-gpu", "driver-gpu" };
+
+	std::string content = Utils::FileSystem::readAllText("/flash/extlinux/extlinux.conf");
+	if (content.empty())
+		return "None";
+
+	std::stringstream lines(content);
+	std::string line;
+	while (std::getline(lines, line))
+	{
+		size_t pos = line.find("FDTOVERLAYS");
+		if (pos == std::string::npos)
+			continue;
+
+		std::stringstream tokens(line.substr(pos + std::string("FDTOVERLAYS").length()));
+		std::string token;
+		while (tokens >> token)
+		{
+			// mimic: echo ${ol} | cut -d '/' -f 3
+			std::vector<std::string> parts = Utils::String::split(token, '/');
+			std::string base = (parts.size() >= 3 ? parts[2] : token);
+
+			if (dtbType == "custom")
+			{
+				bool specialized = false;
+				for (auto spec : specializations)
+					if (base.find(spec) != std::string::npos)
+						specialized = true;
+				if (!specialized)
+					return base;
+			}
+			else if (base.find(dtbType) != std::string::npos)
+				return base;
+		}
+	}
+
+	return "None";
+}
+
+// /usr/bin/dtb_overlay ls <type> lists /flash/overlays/*.dtbo filtered by type
+static std::string listDtbOverlays(const std::string& dtbType)
+{
+	static const std::vector<std::string> specializations = { "undervolt-cpu", "undervolt-gpu", "driver-gpu" };
+
+	std::vector<std::string> names;
+	for (auto entry : Utils::FileSystem::getDirContent("/flash/overlays"))
+	{
+		std::string base = Utils::FileSystem::getFileName(entry);
+		if (!Utils::String::endsWith(base, ".dtbo"))
+			continue;
+
+		if (dtbType == "custom")
+		{
+			bool specialized = false;
+			for (auto spec : specializations)
+				if (base.find(spec) != std::string::npos)
+					specialized = true;
+			if (!specialized)
+				names.push_back(base);
+		}
+		else if (base.find(dtbType) != std::string::npos)
+			names.push_back(base);
+	}
+	std::sort(names.begin(), names.end());
+	std::string out;
+	for (auto name : names)
+		out += name + " ";
+	return out;
+}
+
+// /usr/bin/usbgadget with no argument cats /sys/class/udc/<udc>/function
+static std::string getUsbGadgetMode()
+{
+	Utils::FileSystem::stringList udcs = Utils::FileSystem::getDirContent("/sys/class/udc");
+	if (udcs.empty())
+		return "disabled";
+
+	std::string mode = Utils::FileSystem::readAllText(udcs.front() + "/function");
+	mode = Utils::String::trim(mode);
+	if (mode == "cdc")
+		return "network";
+	if (mode == "mtp")
+		return "file_transfer";
+	return "disabled";
+}
