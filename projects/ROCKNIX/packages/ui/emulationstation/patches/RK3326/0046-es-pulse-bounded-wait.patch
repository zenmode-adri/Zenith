From: Zenith
Subject: [PATCH] ES: bounded wait (1 s) and supervised reconnection for the PulseAudio connection of the global PulseAudioControl

static PulseAudioControl PulseAudio runs its constructor before main() and waited forever for the pulse context state callback.
With the early boot ES starts before pipewire-pulse is ready: the wait is now bounded (1 s) and each connection attempt is watched
(max 2 s); if it does not reach READY the context is dropped and a new one is created (max ~60 attempts).
---
--- a/es-core/src/VolumeControl.cpp
+++ b/es-core/src/VolumeControl.cpp
@@ -11,6 +11,8 @@
 #ifdef _ENABLE_PULSE_
 #include <thread>
 #include <condition_variable>
+#include <chrono>
+#include <atomic>
 #include <pulse/pulseaudio.h>
 #include "utils/StringUtil.h"
 #include "SystemConf.h"
@@ -64,6 +66,7 @@
 		LOG(LogDebug) << "PulseAudioControl.exit";
 
 		mReady = false;
+		mExit = true;
 
 		if(mThread != nullptr) {
 		  if (mMainLoop != nullptr) {
@@ -81,15 +84,55 @@
 
   		pa_signal_init(pa_mlapi);
 
-		mContext = pa_context_new(pa_mlapi, "EmulationStation");
+		// Zenith: con el arranque temprano ES arranca antes que pipewire-pulse y el primer intento de conexion puede quedarse colgado
+		// hasta el tiempo limite de libpulse (~25 s) o fallar. Cada intento se vigila (max 2 s): si no llega a READY se descarta el contexto
+		// y se reintenta (max ~60 intentos). Una vez READY se vuelve al bucle bloqueante de siempre.
+		for (int attempt = 0; attempt < 60 && !mExit; attempt++)
+		{
+			mContext = pa_context_new(pa_mlapi, "EmulationStation");
+
+			pa_context_set_state_callback(mContext, context_state_callback, this);
+			pa_context_connect(mContext, nullptr, pa_context_flags::PA_CONTEXT_NOFLAGS, nullptr);
 
-		pa_context_set_state_callback(mContext, context_state_callback, this);
-		pa_context_connect(mContext, nullptr, pa_context_flags::PA_CONTEXT_NOFLAGS, nullptr);
+			auto t0 = std::chrono::steady_clock::now();
+			bool ready = false;
 
-		int result = 0;
-		pa_mainloop_run(mMainLoop, &result);
+			while (!mExit)
+			{
+				int r = 0;
+				pa_mainloop_iterate(mMainLoop, 0, &r);
+
+				pa_context_state_t st = pa_context_get_state(mContext);
+				if (st == PA_CONTEXT_READY) { ready = true; break; }
+				if (st == PA_CONTEXT_FAILED || st == PA_CONTEXT_TERMINATED) break;
+				if (std::chrono::steady_clock::now() - t0 > std::chrono::milliseconds(2000)) break;
+
+				std::this_thread::sleep_for(std::chrono::milliseconds(20));
+			}
+
+			if (ready)
+			{
+				int result = 0;
+				pa_mainloop_run(mMainLoop, &result);
+				break;
+			}
+
+			pa_context_disconnect(mContext);
+			pa_context_unref(mContext);
+			mContext = nullptr;
+			mReady = 0;
 
-		pa_context_unref(mContext);
+			if (mExit)
+				break;
+
+			std::this_thread::sleep_for(std::chrono::milliseconds(300));
+		}
+
+		if (mContext != nullptr)
+		{
+			pa_context_unref(mContext);
+			mContext = nullptr;
+		}
 		pa_mainloop_free(mMainLoop);
 		mMainLoop = nullptr;
 
@@ -186,6 +229,7 @@
 
 private:
 	int mReady;
+	std::atomic<bool> mExit{false};
 	int mMute;
 	int mVolume;
 
@@ -196,8 +240,11 @@
 
 	void WaitEvent()
 	{
+		// Zenith: espera acotada. Este objeto es GLOBAL (se construye antes de main()): esperar sin limite a que PulseAudio responda bloqueaba
+		// todo el arranque de ES hasta que el servidor de audio estaba listo (varios segundos con el arranque temprano). PulseAudio.isReady()
+		// se comprueba en cada uso, asi que si aun no esta listo simplemente se activa cuando el callback llegue.
 		std::unique_lock<std::mutex> lock(mLock);
-		mEvent.wait(lock);
+		mEvent.wait_for(lock, std::chrono::milliseconds(1000));
 	}
 
 	std::thread*	mThread;
