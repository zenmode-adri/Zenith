From: Zenith
Subject: [PATCH] ES: bounded wait (1 s) and automatic reconnection for the PulseAudio connection of the global PulseAudioControl

static PulseAudioControl PulseAudio runs its constructor before main() and waited forever for the pulse context state callback,
so the whole ES startup was held until the audio server answered (early boot starts ES before pipewire-pulse). Now the wait is
bounded (1 s) and, if the server does not exist yet, the connection is retried every 0.5 s (max ~60 s).
---
--- a/es-core/src/VolumeControl.cpp
+++ b/es-core/src/VolumeControl.cpp
@@ -11,6 +11,8 @@
 #ifdef _ENABLE_PULSE_
 #include <thread>
 #include <condition_variable>
+#include <chrono>
+#include <atomic>
 #include <pulse/pulseaudio.h>
 #include "utils/StringUtil.h"
 #include "SystemConf.h"
@@ -64,6 +66,7 @@
 		LOG(LogDebug) << "PulseAudioControl.exit";
 
 		mReady = false;
+		mExit = true;
 
 		if(mThread != nullptr) {
 		  if (mMainLoop != nullptr) {
@@ -81,15 +84,28 @@
 
   		pa_signal_init(pa_mlapi);
 
-		mContext = pa_context_new(pa_mlapi, "EmulationStation");
+		// Zenith: si el servidor aun no existe (ES arranca antes que pipewire-pulse) la conexion falla; se reintenta cada 0,5 s (max ~60 s)
+		// en vez de quedarse sin control de volumen toda la sesion.
+		for (int attempt = 0; attempt < 120 && !mExit; attempt++)
+		{
+			mFailed = false;
+			mContext = pa_context_new(pa_mlapi, "EmulationStation");
+
+			pa_context_set_state_callback(mContext, context_state_callback, this);
+			pa_context_connect(mContext, nullptr, pa_context_flags::PA_CONTEXT_NOFLAGS, nullptr);
+
+			int result = 0;
+			pa_mainloop_run(mMainLoop, &result);
 
-		pa_context_set_state_callback(mContext, context_state_callback, this);
-		pa_context_connect(mContext, nullptr, pa_context_flags::PA_CONTEXT_NOFLAGS, nullptr);
+			pa_context_unref(mContext);
+			mContext = nullptr;
 
-		int result = 0;
-		pa_mainloop_run(mMainLoop, &result);
+			if (!mFailed || mExit)
+				break;
+
+			std::this_thread::sleep_for(std::chrono::milliseconds(500));
+		}
 
-		pa_context_unref(mContext);
 		pa_mainloop_free(mMainLoop);
 		mMainLoop = nullptr;
 
@@ -178,14 +194,19 @@
 		default:
 			LOG(LogError) << "PulseAudioControl Connection failure : " << pa_strerror(pa_context_errno(c));    		
 			pThis->mReady = 0;
+			pThis->mFailed = true;
 			pThis->FireEvent();
 
 			quit(userdata, 1);
+			if (pThis->mMainLoop != nullptr)
+				pa_mainloop_quit(pThis->mMainLoop, 1);
 		}
 	}
 
 private:
 	int mReady;
+	std::atomic<bool> mExit{false};
+	std::atomic<bool> mFailed{false};
 	int mMute;
 	int mVolume;
 
@@ -196,8 +217,11 @@
 
 	void WaitEvent()
 	{
+		// Zenith: espera acotada. Este objeto es GLOBAL (se construye antes de main()): esperar sin limite a que PulseAudio responda bloqueaba
+		// todo el arranque de ES hasta que el servidor de audio estaba listo (varios segundos con el arranque temprano). PulseAudio.isReady()
+		// se comprueba en cada uso, asi que si aun no esta listo simplemente se activa cuando el callback llegue.
 		std::unique_lock<std::mutex> lock(mLock);
-		mEvent.wait(lock);
+		mEvent.wait_for(lock, std::chrono::milliseconds(1000));
 	}
 
 	std::thread*	mThread;
