+// Rejilla de botones del cuadro: botones centrados, separacion fija entre ellos y un margen inferior; sin las
+// holguras de los botones de menu (que llevan imagen y sombra).
+static std::shared_ptr<ComponentGrid> makeDialogButtonGrid(Window* window, const std::vector< std::shared_ptr<ButtonComponent> >& buttons)
+{
+	auto grid = std::make_shared<ComponentGrid>(window, Vector2i((int)buttons.size(), 2));
+
+	const float gap = Renderer::getScreenWidth() * 0.018f;
+	const float bottom = Renderer::getScreenHeight() * 0.036f;
+
+	float total = 0;
+	for (auto& btn : buttons)
+		total += btn->getSize().x() + gap;
+
+	for (int i = 0; i < (int)buttons.size(); i++)
+	{
+		grid->setEntry(buttons.at(i), Vector2i(i, 0), true, false);
+		grid->setColWidthPerc(i, (buttons.at(i)->getSize().x() + gap) / total);
+	}
+
+	const float height = buttons.at(0)->getSize().y() + bottom;
+	grid->setSize(total, height);
+	grid->setRowHeightPerc(1, bottom / height);
+	return grid;
+}
