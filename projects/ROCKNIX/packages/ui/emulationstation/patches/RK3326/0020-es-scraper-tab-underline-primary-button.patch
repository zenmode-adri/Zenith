 #define SELECTOR_PX (Renderer::getScreenWidth() * 0.0025f)
 
+static float tabLuminance(unsigned int c)
+{
+	auto f = [](float v) { v /= 255.0f; return v <= 0.03928f ? v / 12.92f : powf((v + 0.055f) / 1.055f, 2.4f); };
+	return 0.2126f * f((float)((c >> 24) & 0xFF)) + 0.7152f * f((float)((c >> 16) & 0xFF)) + 0.0722f * f((float)((c >> 8) & 0xFF));
+}
+
+// color del subrayado de la pestana activa: el acento del menu si contrasta >= 3:1 con el panel; si no, el selector del tema
+static unsigned int tabUnderlineColor(unsigned int fallback)
+{
+	auto menuTheme = ThemeData::getMenuTheme();
+	const unsigned int accent = menuTheme->Text.selectedColor;
+	const float a = tabLuminance(accent) + 0.05f, b = tabLuminance(menuTheme->Background.color) + 0.05f;
+	return (a > b ? a / b : b / a) >= 3.0f ? accent : fallback;
+}
