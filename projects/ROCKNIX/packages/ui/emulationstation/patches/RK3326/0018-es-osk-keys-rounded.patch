+void ButtonComponent::setTextScale(float scale)
+{
+	auto menuFont = ThemeData::getMenuTheme()->Text.font;
+	mTextScale = scale;
+	mFont = Font::get((int)(menuFont->getSize() * scale), menuFont->getPath());
+	setText(mText, mHelpText, false);
+}
+
+// Tecla principal: fondo con el color de acento del menu, solo si contrasta >= 3:1 con el panel (si no, queda como las demas)
+void ButtonComponent::setPrimaryStyle()
+{
+	auto menuTheme = ThemeData::getMenuTheme();
+	const unsigned int accent = menuTheme->Text.selectedColor;
+	const float la = btnLuminance(accent) + 0.05f, lb = btnLuminance(menuTheme->Background.color) + 0.05f;
+	const float ratio = la > lb ? la / lb : lb / la;
+	if (ratio < 3.0f)
+		return;
+
+	mPrimary = true;
+	mPrimaryBg = accent;
+	mTextColorUnfocused = btnLuminance(accent) > 0.35f ? 0x000000FF : 0xFFFFFFFF;
+	if (mTextCache)
+		mTextCache->setColor(getCurTextColor());
+}
+
+void ButtonComponent::fitText()
+{
+	// ajusta el tamano del texto para que quepa dentro de la tecla (pantallas pequenas)
+	const float avail = mSize.x() - mPadding.x() - mPadding.z() - 6.0f;
+	if (avail <= 0 || mText.empty())
+		return;
+
+	auto menuFont = ThemeData::getMenuTheme()->Text.font;
+	float scale = mTextScale;
+	std::shared_ptr<Font> font = Font::get((int)(menuFont->getSize() * scale), menuFont->getPath());
+	while (scale > 0.45f && font->sizeText(mText).x() > avail)
+	{
+		scale -= 0.05f;
+		font = Font::get((int)(menuFont->getSize() * scale), menuFont->getPath());
+	}
+
+	if (font != mFont)
+	{
+		mFont = font;
+		mTextCache = std::unique_ptr<TextCache>(mFont->buildTextCache(mText, 0, 0, getCurTextColor()));
+	}
+}
