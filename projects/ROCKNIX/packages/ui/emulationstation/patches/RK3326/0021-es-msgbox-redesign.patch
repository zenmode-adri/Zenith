 #define HORIZONTAL_PADDING_PX  (Renderer::getScreenWidth()*0.01)
 
+// Mensajes escritos todo en mayusculas ("REALLY RESTART EMULATIONSTATION?") -> frase normal. Se respetan las siglas
+// conocidas y EmulationStation; si el texto lleva caracteres no ASCII (traducciones) o es largo, se deja tal cual.
+static std::string softenUpperCase(const std::string& s)
+{
+	bool hasLower = false, hasUpper = false;
+	for (unsigned char c : s)
+	{
+		if (c >= 0x80) return s;
+		if (c >= 'a' && c <= 'z') hasLower = true;
+		if (c >= 'A' && c <= 'Z') hasUpper = true;
+	}
+	if (hasLower || !hasUpper || s.size() > 120)
+		return s;
+
+	static const char* keep[] = { "BIOS", "WIFI", "SSID", "USB", "NFS", "SMB", "ROM", "ROMS", "GPU", "CPU", "IP", "OK", "SD", "SSH", "PSP", "PS1", "N64", "DNS", nullptr };
+	std::string out, word;
+	bool sentenceStart = true;
+
+	auto flush = [&]()
+	{
+		if (word.empty())
+			return;
+
+		bool kept = false;
+		for (int i = 0; keep[i]; i++)
+			if (word == keep[i])
+				kept = true;
+
+		if (word == "EMULATIONSTATION")
+			out += "EmulationStation";
+		else if (kept)
+			out += word;
+		else
+		{
+			std::string w;
+			for (char c : word)
+				w += (char)tolower((unsigned char)c);
+			if (sentenceStart)
+				w[0] = (char)toupper((unsigned char)w[0]);
+			out += w;
+		}
+
+		sentenceStart = false;
+		word.clear();
+	};
+
+	for (char c : s)
+	{
+		if (isalpha((unsigned char)c))
+			word += c;
+		else
+		{
+			flush();
+			out += c;
+			if (c == '.' || c == '?' || c == '!' || c == '\n')
+				sentenceStart = true;
+		}
+	}
+
+	flush();
+	return out;
+}
