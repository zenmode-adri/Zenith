+static float sliderLuminance(unsigned int c)
+{
+	auto f = [](float v) { v /= 255.0f; return v <= 0.03928f ? v / 12.92f : powf((v + 0.055f) / 1.055f, 2.4f); };
+	return 0.2126f * f((float)((c >> 24) & 0xFF)) + 0.7152f * f((float)((c >> 16) & 0xFF)) + 0.0722f * f((float)((c >> 8) & 0xFF));
+}
+
+// Color de acento del menu (el del elemento seleccionado) para la parte rellena y la perilla; solo si tiene
+// contraste >= 3:1 con el fondo del panel. En temas de terceros con un acento que se pierde sobre el panel
+// (p. ej. blanco sobre panel claro) se usa el color del texto de la fila.
+static unsigned int sliderAccent(unsigned int rowColor)
+{
+	auto menuTheme = ThemeData::getMenuTheme();
+	unsigned int accent = menuTheme->Text.selectedColor;
+	float a = sliderLuminance(accent) + 0.05f, b = sliderLuminance(menuTheme->Background.color) + 0.05f;
+	float ratio = a > b ? a / b : b / a;
+	return ratio >= 3.0f ? accent : rowColor;
+}
