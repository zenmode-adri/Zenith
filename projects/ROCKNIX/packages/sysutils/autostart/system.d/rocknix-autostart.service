[Unit]
Description=ROCKNIX user autostart script
Before=emustation.service weston.service shutdown.target
After=var.mount tmp.mount
# arranque temprano (Zenith): solo necesita /var y /tmp. Los arranques NO tempranos esperan por dentro del script a udevd, tmpfiles y userconfig
DefaultDependencies=no
Conflicts=shutdown.target

[Service]
# prioridad alta: su camino critico (GPU, pantalla, sway-init) gana CPU a los servicios de fondo (red, ssh, avahi...) durante el arranque
CPUWeight=10000
Type=oneshot
Environment=HOME=/storage
ExecStart=/bin/bash -a -c 'source /etc/profile && exec /usr/bin/autostart'
RemainAfterExit=yes

[Install]
WantedBy=rocknix.target
