[Unit]
Description=Release hwdb.bin from /storage before shutdown
DefaultDependencies=no
After=storage.mount
Before=shutdown.target umount.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/bin/hwdb-release
# sin locale de /storage: un proceso con ficheros de /storage mapeados lo mantendria ocupado
Environment=LC_ALL=C LANG=C LOCPATH=/nonexistent
TimeoutStopSec=20

[Install]
WantedBy=sysinit.target
