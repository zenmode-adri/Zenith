count=$(cat /sys/class/drm/card*-*/status 2>/dev/null | grep -cx connected)

if [ "$count" -eq 2 ]; then
    dual_screen=true
else
    dual_screen=false
fi

cat <<EOF >/storage/.config/profile.d/080-dual_screen_mode
DEVICE_HAS_DUAL_SCREEN=$dual_screen
EOF
