+float ControlMappingScreen::SettingsWidth() const {
+	// Narrower side pane on small screens, so the mapping rows have room (350 dp is kept from 960 dp up).
+	if (g_display.dp_xres >= 960.0f)
+		return 350.0f;
+	// Contents need ~130 (names) + 60 (+) + ~226 (mapping + trash) + margins = ~430 dp.
+	return std::clamp(g_display.dp_xres - 430.0f, 220.0f, 350.0f);
+}
