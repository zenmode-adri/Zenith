#!/bin/bash
# Reemplazo rapido de /usr/bin/iwd_get-networks (python3 + ravel tardaba ~2 s en el RK3326; busctl ~0.15 s).
# Imprime el SSID de cada red visible/conocida, ordenadas por señal (igual que GetOrderedNetworks).
# iwd codifica el SSID en hexadecimal en la ruta del objeto D-Bus: /net/connman/iwd/<phy>/<dev>/<hex(ssid)>_<seguridad>.
# Si algo falla (sin estacion, modo AP, iwd parado...), cae al script Python original (IWD_PY lo puede sustituir para pruebas).
PY="${IWD_PY:-/usr/bin/iwd_get-networks.py}"
fallback() {
  [ -x "${PY}" ] && exec "${PY}" "$@"
  exit 1
}

SP="${IWD_SP:-$(busctl --no-pager tree net.connman.iwd 2>/dev/null | grep -o '/net/connman/iwd/[0-9]*/[0-9]*$' | head -1)}"
[ -z "$SP" ] && fallback
OUT=$(busctl --no-pager call net.connman.iwd "$SP" net.connman.iwd.Station GetOrderedNetworks 2>/dev/null) || fallback

hexdec() {
  local h=$1 i
  for ((i = 0; i < ${#h}; i += 2)); do
    printf "\\x${h:i:2}"
  done
  printf '\n'
}

for p in $(printf '%s\n' "$OUT" | grep -o '"/net/connman/iwd/[^"]*"' | tr -d '"'); do
  h=${p##*/}
  h=${h%_*}
  hexdec "$h"
done
