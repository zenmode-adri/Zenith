#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2024 ROCKNIX (https://github.com/ROCKNIX)

. /etc/profile.d/001-functions

GPU_DRIVER_SETTING_KEY="gpu.driver"

get_current_driver() {
  CONFDRIVER=$(get_setting ${GPU_DRIVER_SETTING_KEY})
  if [ -z ${CONFDRIVER} ]; then
    CONFDRIVER="libmali"              # DEFAULT
    set_setting ${GPU_DRIVER_SETTING_KEY} ${CONFDRIVER}
  fi
}


# fast-5b: bind de las bibliotecas de <subdir> sobre /usr/lib{,32} en el mismo proceso. Antes: `find -exec bash -c 'mount --bind'`,
# un bash + un mount por fichero (14 en el arranque). `-n`: /etc/mtab es un enlace a /proc/self/mounts, no hay nada que escribir.
bind_libs() {   # bind_libs <subdir>   (/usr/lib/<subdir>/X -> /usr/lib/X, igual para lib32)
  for d in /usr/lib /usr/lib32; do
    [ -d "${d}/${1}" ] || continue
    find "${d}/${1}" -type f | while IFS= read -r lib; do
      mount -n --bind "${lib}" "${d}/${lib#${d}/${1}/}"
    done
  done
}

# Panfrost cuenta como cargado solo si algun dispositivo de GPU quedo enlazado a el: el modulo puede cargar y aun asi fallar
# el probe (p. ej. RK3326 con un kernel sin el parche 036: "Restricting voltage" -> -EINVAL) y entonces no hay GPU para nadie.
# El probe puede aplazarse (EPROBE_DEFER), por eso se espera hasta 3 s.
PANFROST_SYSFS="${PANFROST_SYSFS:-/sys/bus/platform/drivers/panfrost}"
panfrost_bound() {
  n=0
  while [ ${n} -lt 15 ]; do
    [ -n "$(find "${PANFROST_SYSFS}" -mindepth 1 -maxdepth 1 -type l ! -name module 2>/dev/null)" ] && return 0
    sleep 0.2
    n=$((n+1))
  done
  return 1
}

# When loading a driver, do two things:
#   * ensure needed driver is loaded and other is not
#   * ensure graphics related libs are overridden (or not)
load_driver() {
  DRIVER_TO_LOAD=$1

  case ${DRIVER_TO_LOAD} in
    "libmali")
      # fast-5b: la carga del modulo (~0,4 s) corre a la vez que los binds de bibliotecas (no dependen de el); se espera al final
      ( modprobe -r @PAN@; modprobe mali_kbase ) &
      MODPID=$!

      grep -q /usr/lib/libEGL.so /proc/mounts || bind_libs mali
      # Portmaster is not ready for SDL in glesonly subdir, so override libs the dirty way
      if [ -d /usr/lib/glesonly ]; then
        grep -q /usr/lib/libSDL2-2.0.so /proc/mounts || bind_libs glesonly
      fi
      mount -n --bind /dev/null /usr/lib/libGL.so
      mount -n --bind /dev/null /usr/lib32/libGL.so
      wait ${MODPID}
      ;;
    "panfrost")
      modprobe -r mali_kbase
      modprobe @PAN@

      grep -q /usr/lib/libEGL.so /proc/mounts && find /usr/lib/mali -type f -exec bash -c 'lib={}; umount ${lib/\/mali\//\/}' ';'
      if [ -d /usr/lib/glesonly ]; then
        grep -q /usr/lib/libSDL2-2.0.so /proc/mounts && find /usr/lib/glesonly -type f -exec bash -c 'lib={}; umount ${lib/\/glesonly\//\/}' ';'
      fi
      ;;
    *)
      exit 3
      ;;
  esac
}


case "$1" in
  "--options")
    echo "@GPU_OPTIONS@"
    ;;
  "--start")
    get_current_driver
    load_driver ${CONFDRIVER}
    if [ "${CONFDRIVER}" = "panfrost" ] && ! panfrost_bound; then
      # Sin GPU el escritorio queda en render por software. No se descarga Panfrost para cargar libmali en caliente: en la Ultra
      # `modprobe mali_kbase` tras haber tenido Panfrost la GPU en el mismo arranque cuelga el kernel. Se deja libmali guardado
      # y se reinicia (el arranque limpio con libmali funciona). Solo si el ajuste quedo guardado, para no entrar en bucle.
      logger -t gpudriver "panfrost no enlazo ninguna GPU; se guarda libmali y se reinicia" 2>/dev/null
      echo "gpudriver: panfrost no enlazo ninguna GPU; se guarda libmali y se reinicia" >&2
      set_setting ${GPU_DRIVER_SETTING_KEY} libmali
      @DTB_OVERLAY_UNLOAD@
      if [ "$(get_setting ${GPU_DRIVER_SETTING_KEY})" = "libmali" ]; then
        sync
        reboot
      fi
    fi
    ;;
  "libmali")
    set_setting ${GPU_DRIVER_SETTING_KEY} $1
    @DTB_OVERLAY_UNLOAD@
    ;;
  "panfrost")
    set_setting ${GPU_DRIVER_SETTING_KEY} $1
    @DTB_OVERLAY_LOAD@
    ;;
  "")
    get_current_driver
    echo ${CONFDRIVER}
    ;;
  *)
    echo "Unexpected parameter $1" >&2
    echo "Usage:" >&2
    echo "  List available drivers:                $0 --options" >&2
    echo "  Load configured driver and set libs:   $0 --start" >&2
    echo "  Get current driver:                    $0" >&2
    echo "  Configure driver to load on next boot: $0 <panfrost|libmali>" >&2
    exit 1
    ;;
esac
