+/* PAN_RB_DEBUG=1: every 2 s, read maps by kind (count and bytes) */
+static void
+pan_rb_debug(struct pipe_resource *resource, unsigned usage, uint64_t bytes,
+             bool cached)
+{
+   static int on = -1;
+   static uint64_t n[5], b[5], usage_mask, t0;
+
+   if (on < 0)
+      on = debug_get_bool_option("PAN_RB_DEBUG", false);
+   if (!on || !(usage & PIPE_MAP_READ))
+      return;
+
+   /* 0 texture cached, 1 texture other, 2 buffer cached, 3 buffer staging
+    * not cached, 4 buffer other */
+   unsigned k;
+   if (resource->target != PIPE_BUFFER)
+      k = cached ? 0 : 1;
+   else if (cached)
+      k = 2;
+   else
+      k = resource->usage == PIPE_USAGE_STAGING ? 3 : 4;
+   n[k]++;
+   b[k] += bytes;
+   if (resource->target == PIPE_BUFFER)
+      usage_mask |= 1ull << resource->usage;
+
+   uint64_t t = os_time_get_nano();
+   if (!t0)
+      t0 = t;
+   if (t - t0 >= 2000000000ull) {
+      fprintf(stderr,
+              "[R36-RB] tex_cached %" PRIu64 "/%" PRIu64 "KB tex_other %" PRIu64
+              "/%" PRIu64 "KB buf_cached %" PRIu64 "/%" PRIu64
+              "KB buf_staging %" PRIu64 "/%" PRIu64 "KB buf_other %" PRIu64
+              "/%" PRIu64 "KB usages 0x%" PRIx64 " creados %" PRIu64
+              " binds 0x%" PRIx64 " mapas_escritura %" PRIu64 "\n",
+              n[0], b[0] >> 10, n[1], b[1] >> 10, n[2], b[2] >> 10, n[3],
+              b[3] >> 10, n[4], b[4] >> 10, usage_mask, pan_rb_creates,
+              pan_rb_create_binds, pan_rb_wmaps);
+      pan_rb_creates = pan_rb_create_binds = pan_rb_wmaps = 0;
+      memset(n, 0, sizeof(n));
+      memset(b, 0, sizeof(b));
+      usage_mask = 0;
+      t0 = t;
+   }
+}
