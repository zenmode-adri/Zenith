+/* Replaces the BO of a freshly created linear staging resource by a cached one */
+static bool
+pan_staging_use_cached(struct panfrost_context *ctx,
+                       struct panfrost_resource *staging)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   size_t need = panfrost_bo_size(staging->bo);
+   struct panfrost_bo *bo = ctx->rb_bo;
+
+   if (bo && p_atomic_read(&bo->refcnt) == 1 && panfrost_bo_size(bo) < need) {
+      panfrost_bo_unreference(bo);
+      ctx->rb_bo = NULL;
+      bo = NULL;
+   } else if (bo && p_atomic_read(&bo->refcnt) != 1) {
+      bo = NULL;
+   }
+
+   if (bo) {
+      panfrost_bo_reference(bo);
+   } else {
+      bo = pan_cached_bo_create(dev, need);
+      if (!bo)
+         return false;
+
+      if (!ctx->rb_bo) {
+         ctx->rb_bo = bo;
+         panfrost_bo_reference(bo);
+      }
+   }
+
+   if (staging->owns_label) {
+      char *old_label = (char *)panfrost_bo_replace_label(
+         staging->bo, "Discarded staging BO", false);
+      free(old_label);
+      staging->owns_label = false;
+   }
+
+   panfrost_bo_unreference(staging->bo);
+   staging->bo = bo;
+   staging->plane.base = bo->ptr.gpu;
+   return true;
+}
