@@ -278,11 +282,83 @@
 /* Tries to add a BO to the cache. Returns if it was
  * successful */
 
+/* Free CPU-cached BOs (system dma-heap) are kept in a small pool: importing
+ * and mapping a new one updates the GPU MMU every time, and apps reallocate
+ * their pixel buffers every frame */
+static void panfrost_bo_munmap(struct panfrost_bo *bo);
+
+static bool
+pan_cached_pool_put(struct panfrost_bo *bo)
+{
+   struct panfrost_device *dev = bo->dev;
+   bool kept = false;
+
+   simple_mtx_lock(&dev->cached_pool.lock);
+   if (dev->cached_pool.n < ARRAY_SIZE(dev->cached_pool.bos)) {
+      dev->cached_pool.bos[dev->cached_pool.n++] = bo;
+      kept = true;
+   }
+   simple_mtx_unlock(&dev->cached_pool.lock);
+
+   return kept;
+}
+
+struct panfrost_bo *
+panfrost_bo_cached_pool_get(struct panfrost_device *dev, size_t size)
+{
+   struct panfrost_bo *bo = NULL;
+
+   simple_mtx_lock(&dev->cached_pool.lock);
+   for (unsigned i = 0; i < dev->cached_pool.n; i++) {
+      struct panfrost_bo *entry = dev->cached_pool.bos[i];
+
+      /* Skip BOs the GPU may still access */
+      if (panfrost_bo_size(entry) == size && panfrost_bo_wait(entry, 0, true)) {
+         bo = entry;
+         dev->cached_pool.bos[i] = dev->cached_pool.bos[--dev->cached_pool.n];
+         break;
+      }
+   }
+   simple_mtx_unlock(&dev->cached_pool.lock);
+
+   if (!bo)
+      return NULL;
+
+   if (!bo->ptr.cpu) {
+      void *cpu = os_mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                          bo->cached_fd - 1, 0);
+
+      if (cpu == MAP_FAILED) {
+         panfrost_bo_free(bo);
+         return NULL;
+      }
+      bo->ptr.cpu = cpu;
+   }
+
+   p_atomic_set(&bo->refcnt, 1);
+   return bo;
+}
+
+void
+panfrost_bo_cached_pool_drain(struct panfrost_device *dev)
+{
+   simple_mtx_lock(&dev->cached_pool.lock);
+   for (unsigned i = 0; i < dev->cached_pool.n; i++) {
+      panfrost_bo_munmap(dev->cached_pool.bos[i]);
+      panfrost_bo_free(dev->cached_pool.bos[i]);
+   }
+   dev->cached_pool.n = 0;
+   simple_mtx_unlock(&dev->cached_pool.lock);
+}
+
 static bool
 panfrost_bo_cache_put(struct panfrost_bo *bo)
 {
    struct panfrost_device *dev = bo->dev;
 
+   if (bo->cached_fd)
+      return pan_cached_pool_put(bo);
+
    if (bo->flags & PAN_BO_SHARED || dev->debug & PAN_DBG_NO_CACHE)
       return false;
 
