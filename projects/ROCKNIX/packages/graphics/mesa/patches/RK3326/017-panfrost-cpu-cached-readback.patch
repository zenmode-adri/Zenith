+/* CPU-cached BOs from the system dma-heap. The CPU reads the write-combined
+ * mappings of Panfrost BOs very slowly; pages from the system heap are mapped
+ * with caches, and DMA_BUF_IOCTL_SYNC does the cache maintenance (END cleans,
+ * START with READ invalidates). PAN_RB_CACHED: 1 = read-only texture maps
+ * through a cached staging BO, 2 = staging buffers allocated cached.
+ */
+static int pan_rb_heap_fd = -2;
+
+/* PAN_RB_DEBUG counters: cached buffers created (and their bind flags) and
+ * CPU write maps of cached BOs */
+static uint64_t pan_rb_creates, pan_rb_create_binds, pan_rb_wmaps;
+
+static unsigned
+pan_rb_cached_mode(void)
+{
+   static int mode = -1;
+
+   if (mode < 0) {
+      mode = debug_get_num_option("PAN_RB_CACHED", 0) & 3;
+      if (mode) {
+         pan_rb_heap_fd = open("/dev/dma_heap/system", O_RDONLY | O_CLOEXEC);
+         if (pan_rb_heap_fd < 0)
+            mode = 0;
+      }
+   }
+
+   return mode;
+}
+
+static void
+pan_bo_cpu_sync(struct panfrost_bo *bo, uint64_t flags)
+{
+   if (!bo || !bo->cached_fd)
+      return;
+
+   struct dma_buf_sync sync = {.flags = flags};
+
+   while (ioctl(bo->cached_fd - 1, DMA_BUF_IOCTL_SYNC, &sync) &&
+          (errno == EINTR || errno == EAGAIN))
+      ;
+}
+
+static struct panfrost_bo *
+pan_cached_bo_create(struct panfrost_device *dev, size_t size)
+{
+   size = ALIGN_POT(MAX2(size, 4096), 4096);
+
+   struct panfrost_bo *pooled = panfrost_bo_cached_pool_get(dev, size);
+   if (pooled)
+      return pooled;
+
+   struct dma_heap_allocation_data alloc = {
+      .len = size,
+      .fd_flags = O_RDWR | O_CLOEXEC,
+   };
+
+   if (ioctl(pan_rb_heap_fd, DMA_HEAP_IOCTL_ALLOC, &alloc))
+      return NULL;
+
+   int fd = alloc.fd;
+   uint32_t handle;
+   void *cpu = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+
+   if (cpu == MAP_FAILED) {
+      close(fd);
+      return NULL;
+   }
+
+   if (drmPrimeFDToHandle(dev->kmod.dev->fd, fd, &handle)) {
+      munmap(cpu, size);
+      close(fd);
+      return NULL;
+   }
+
+   struct panfrost_bo *bo = panfrost_bo_import(dev, fd);
+
+   if (!bo || !bo->ptr.gpu || bo->ptr.cpu || panfrost_bo_size(bo) < size) {
+      if (bo)
+         panfrost_bo_unreference(bo);
+      munmap(cpu, size);
+      close(fd);
+      return NULL;
+   }
+
+   bo->ptr.cpu = cpu;
+   bo->cached_fd = fd + 1;
+   return bo;
+}
