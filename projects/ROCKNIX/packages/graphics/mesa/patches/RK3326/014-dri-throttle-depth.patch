+static unsigned
+pan_throttle_depth(void)
+{
+   static int v = -1;
+   if (v < 0) {
+      const char *e = getenv("PAN_THROTTLE_DEPTH");
+      v = e ? atoi(e) : 1;
+      if (v < 1)
+         v = 1;
+      if (v > 4)
+         v = 4;
+   }
+   return v;
+}
 
