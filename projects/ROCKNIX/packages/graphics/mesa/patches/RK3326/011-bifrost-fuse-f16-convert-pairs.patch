+static inline bool
+bi_cvtpair_enabled(void)
+{
+   static int v = -1;
+   if (v < 0) {
+      const char *e = getenv("PAN_OPT");
+      v = e && (strtoul(e, NULL, 0) & 512);
+   }
+   return v;
+}
+
+/* MKVEC.v2i16(V2F32_TO_V2F16(x,x), V2F32_TO_V2F16(y,y)) -> V2F32_TO_V2F16(x,y) */
+static void
+bi_fuse_cvt_pairs(bi_context *ctx)
+{
+   if (!bi_cvtpair_enabled() || ctx->arch >= 9)
+      return;
+
+   bi_instr **lut = calloc(sizeof(bi_instr *), ctx->ssa_alloc);
+
+   bi_foreach_instr_global_safe(ctx, I) {
+      bi_foreach_dest(I, d) {
+         if (bi_is_ssa(I->dest[d]))
+            lut[I->dest[d].value] = I;
+      }
+
+      if (I->op != BI_OPCODE_MKVEC_V2I16)
+         continue;
+      if (!bi_is_ssa(I->src[0]) || !bi_is_ssa(I->src[1]))
+         continue;
+      if (I->src[0].abs || I->src[0].neg || I->src[1].abs || I->src[1].neg)
+         continue;
+
+      bi_instr *ca = lut[I->src[0].value];
+      bi_instr *cb = lut[I->src[1].value];
+      if (!ca || !cb || ca->op != BI_OPCODE_V2F32_TO_V2F16 ||
+          cb->op != BI_OPCODE_V2F32_TO_V2F16)
+         continue;
+      if (ca->clamp != cb->clamp || ca->round != cb->round)
+         continue;
+      if (memcmp(&ca->src[0], &ca->src[1], sizeof(bi_index)) != 0 ||
+          memcmp(&cb->src[0], &cb->src[1], sizeof(bi_index)) != 0)
+         continue;
+
+      bi_builder b = bi_init_builder(ctx, bi_before_instr(I));
+      bi_instr *n = bi_v2f32_to_v2f16_to(&b, I->dest[0], ca->src[0], cb->src[0]);
+      n->clamp = ca->clamp;
+      n->round = ca->round;
+      lut[n->dest[0].value] = n;
+      bi_remove_instruction(I);
+   }
+
+   free(lut);
+}
+
