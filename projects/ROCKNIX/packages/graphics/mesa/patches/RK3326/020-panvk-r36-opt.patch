+/* PANVK_OPT bit 2: restrict the fragment area of a batch to what its draws can
+ * touch, as the GL driver does. Returns true and fills *out when it is safe;
+ * the caller restores fbinfo->draw_extent afterwards. Safe means: no clear
+ * (a clear must cover the whole render area), single sampled, and every
+ * attachment either preloaded (its untouched tiles keep the memory contents)
+ * or discarded (never written). */
+static bool
+panvk_batch_shrunk_extent(const struct panvk_batch *batch,
+                          const struct pan_fb_info *fbinfo,
+                          struct pan_bbox *out)
+{
+   if (!panvk_opt(PANVK_OPT_BBOX) || !batch->bbox.any || batch->bbox.unbounded ||
+       fbinfo->nr_samples > 1)
+      return false;
+
+   for (unsigned i = 0; i < fbinfo->rt_count; i++) {
+      if (!fbinfo->rts[i].view)
+         continue;
+      if (fbinfo->rts[i].clear)
+         return false;
+      if (!fbinfo->rts[i].preload && !fbinfo->rts[i].discard)
+         return false;
+   }
+
+   if (fbinfo->zs.clear.z || fbinfo->zs.clear.s)
+      return false;
+
+   if (fbinfo->zs.view.zs && !fbinfo->zs.preload.z && !fbinfo->zs.discard.z)
+      return false;
+
+   if (fbinfo->zs.view.s && !fbinfo->zs.preload.s && !fbinfo->zs.discard.s)
+      return false;
+
+   /* Never grow beyond the render area. */
+   out->minx = MAX2(fbinfo->draw_extent.minx, batch->bbox.minx);
+   out->miny = MAX2(fbinfo->draw_extent.miny, batch->bbox.miny);
+   out->maxx = MIN2(fbinfo->draw_extent.maxx, batch->bbox.maxx);
+   out->maxy = MIN2(fbinfo->draw_extent.maxy, batch->bbox.maxy);
+
+   return out->minx <= out->maxx && out->miny <= out->maxy;
+}
