+   const uint32_t img_end = limits[PANVK_BIFROST_DESC_TABLE_IMG];
+   const uint32_t tex_end = limits[PANVK_BIFROST_DESC_TABLE_TEXTURE];
+   const uint32_t sampler_end = limits[PANVK_BIFROST_DESC_TABLE_SAMPLER];
