diff -urN a/src/panfrost/vulkan/panvk_opt.h b/src/panfrost/vulkan/panvk_opt.h
--- a/src/panfrost/vulkan/panvk_opt.h
+++ b/src/panfrost/vulkan/panvk_opt.h
@@ -0,0 +1,41 @@
+/*
+ * Experimental PanVK optimisations, switchable at run time (R23).
+ * PANVK_OPT is a bit mask read once from the environment (decimal or 0x..):
+ *   1: respect storeOp DONT_CARE/NONE (discard) at the end of a render pass
+ *   2: shrink the fragment area to the union of the drawn scissors
+ *   4: bigger per-command-buffer pool slabs (fewer BOs per submit)
+ *   8: size the index min/max search grid with the draw's indexCount
+ * Bit at 0 = original behaviour.
+ */
+#ifndef PANVK_OPT_H
+#define PANVK_OPT_H
+
+#include <stdint.h>
+#include <stdlib.h>
+
+#define PANVK_OPT_STORE_OP (1u << 0)
+#define PANVK_OPT_BBOX     (1u << 1)
+#define PANVK_OPT_POOLS    (1u << 2)
+#define PANVK_OPT_IDX_GRID (1u << 3)
+
+static inline uint32_t
+panvk_opt_mask(void)
+{
+   /* Benign race: every thread computes the same value. */
+   static int32_t cached = -1;
+
+   if (cached < 0) {
+      const char *e = getenv("PANVK_OPT");
+      cached = e && e[0] ? (int32_t)(strtoul(e, NULL, 0) & 0x7fffffffu) : 0;
+   }
+
+   return (uint32_t)cached;
+}
+
+static inline bool
+panvk_opt(uint32_t bit)
+{
+   return (panvk_opt_mask() & bit) != 0;
+}
+
+#endif
