diff -ruN a/pan_disk_cache.c b/pan_disk_cache.c
--- a/src/gallium/drivers/panfrost/pan_disk_cache.c
+++ b/src/gallium/drivers/panfrost/pan_disk_cache.c
@@ -165,6 +165,10 @@
    driver_flags |= ((uint64_t)(midgard_debug | bifrost_debug) << 32);
    if (getenv("PAN_OPT") && (strtoul(getenv("PAN_OPT"), NULL, 0) & 32))
       driver_flags |= 1ull << 62;
+   if (getenv("PAN_OPT") && (strtoul(getenv("PAN_OPT"), NULL, 0) & 256)) {
+      const char *pm = getenv("PAN_PSCHED_MIN");
+      driver_flags |= (1ull << 59) | ((uint64_t)(((pm ? strtoul(pm, NULL, 0) : 40) / 8) & 7) << 56);
+   }
    if (getenv("PAN_OPT") && (strtoul(getenv("PAN_OPT"), NULL, 0) & 128))
       driver_flags |= 1ull << 60;
 
diff -ruN a/bifrost_compile.c b/bifrost_compile.c
--- a/src/panfrost/compiler/bifrost/bifrost_compile.c
+++ b/src/panfrost/compiler/bifrost/bifrost_compile.c
@@ -6785,7 +6785,19 @@
 
    bi_iterator_schedule(ctx);
 
-   if (likely(!(bifrost_debug & BIFROST_DBG_NOPSCHED))) {
+   bool skip_psched = false;
+   {
+      const char *po = getenv("PAN_OPT");
+      if (po && (strtoul(po, NULL, 0) & 256) && ctx->arch >= 7 &&
+          ctx->arch <= 8 && !ctx->inputs->is_blend) {
+         const char *pm = getenv("PAN_PSCHED_MIN");
+         unsigned min = pm ? strtoul(pm, NULL, 0) : 40;
+         bi_compute_liveness_ssa(ctx);
+         skip_psched = bi_calc_register_demand(ctx) > min;
+      }
+   }
+
+   if (likely(!(bifrost_debug & BIFROST_DBG_NOPSCHED)) && !skip_psched) {
       bi_pressure_schedule(ctx);
       bi_validate(ctx, "Pre-RA scheduling");
    }
