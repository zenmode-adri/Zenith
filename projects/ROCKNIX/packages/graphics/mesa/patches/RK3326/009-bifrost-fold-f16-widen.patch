+static inline bool
+bi_widen_enabled(void)
+{
+   static int v = -1;
+   if (v < 0) {
+      const char *e = getenv("PAN_OPT");
+      v = e && (strtoul(e, NULL, 0) & 128);
+   }
+   return v;
+}
+
+/* F16_TO_F32(x) as operand 0/1 of FMA.f32/FADD.f32 -> x with widen swizzle (H0/H1) */
+static bool
+bi_fuse_widen(bi_context *ctx, bi_instr *I, bi_instr *mod, unsigned s)
+{
+   if (!bi_widen_enabled() || ctx->arch > 8 || s > 1)
+      return false;
+   if (mod->op != BI_OPCODE_F16_TO_F32)
+      return false;
+   if (I->op != BI_OPCODE_FMA_F32 && I->op != BI_OPCODE_FADD_F32)
+      return false;
+   if (I->src[s].swizzle != BI_SWIZZLE_H01)
+      return false;
+
+   bi_index repl = mod->src[0];
+   if (repl.type != BI_INDEX_NORMAL || repl.abs || repl.neg)
+      return false;
+   if (repl.swizzle != BI_SWIZZLE_H0 && repl.swizzle != BI_SWIZZLE_H1)
+      return false;
+
+   enum bi_swizzle other = I->src[1 - s].swizzle;
+   if (other != BI_SWIZZLE_H01 &&
+       !(other == BI_SWIZZLE_H0 && repl.swizzle == BI_SWIZZLE_H0))
+      return false;
+
+   repl.abs = I->src[s].abs;
+   repl.neg = I->src[s].neg;
+   I->src[s] = repl;
+   return true;
+}
