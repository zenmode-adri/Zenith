+static void
+panfrost_set_inlinable_constants(struct pipe_context *pctx,
+                                 mesa_shader_stage stage, uint num_values,
+                                 uint32_t *values)
+{
+   struct panfrost_context *ctx = pan_context(pctx);
+
+   if (!pan_opt_inline() || stage != MESA_SHADER_FRAGMENT ||
+       !ctx->uncompiled[stage] || num_values > MAX_INLINABLE_UNIFORMS)
+      return;
+
+   if (ctx->inline_for[stage] == ctx->uncompiled[stage] &&
+       ctx->inline_n[stage] == num_values &&
+       !memcmp(ctx->inline_vals[stage], values, num_values * sizeof(uint32_t)))
+      return;
+
+   ctx->inline_for[stage] = ctx->uncompiled[stage];
+   ctx->inline_n[stage] = num_values;
+   memcpy(ctx->inline_vals[stage], values, num_values * sizeof(uint32_t));
+
+   ctx->dirty |= PAN_DIRTY_TLS_SIZE;
+   ctx->dirty_shader[stage] |= PAN_DIRTY_STAGE_SHADER;
+   panfrost_update_shader_variant(ctx, stage);
+}
