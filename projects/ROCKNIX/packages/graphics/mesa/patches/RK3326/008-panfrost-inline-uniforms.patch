+/* PAN_OPT&32: calcula los uniforms inlinables sobre una copia (sin alterar el NIR de st) y los anota en su info.
+ * st copia luego `prog->info = prog->nir->info` y manda los valores con set_inlinable_constants(). */
+static void
+panfrost_finalize_nir_inline(struct pipe_screen *pscreen, struct nir_shader *nir,
+                             bool optimize)
+{
+   if (nir->info.stage != MESA_SHADER_FRAGMENT)
+      return;
+
+   nir_shader *c = nir_shader_clone(NULL, nir);
+   NIR_PASS(_, c, nir_lower_alu_to_scalar, NULL, NULL);
+   NIR_PASS(_, c, nir_opt_copy_prop);
+   NIR_PASS(_, c, nir_opt_algebraic);
+   NIR_PASS(_, c, nir_opt_constant_folding);
+   nir_find_inlinable_uniforms(c);
+
+   nir->info.num_inlinable_uniforms = c->info.num_inlinable_uniforms;
+   memcpy(nir->info.inlinable_uniform_dw_offsets,
+          c->info.inlinable_uniform_dw_offsets,
+          sizeof(nir->info.inlinable_uniform_dw_offsets));
+   ralloc_free(c);
+}
