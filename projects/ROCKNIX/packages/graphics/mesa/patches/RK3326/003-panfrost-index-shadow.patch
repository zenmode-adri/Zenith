 void
+pan_index_shadow_invalidate(struct panfrost_resource *rsrc, unsigned x,
+                            unsigned width)
+{
+   if (!rsrc->index_shadow)
+      return;
+
+   if (x + width <= rsrc->index_shadow_lo || x >= rsrc->index_shadow_hi)
+      return;
+
+   rsrc->index_shadow_lo = rsrc->index_shadow_hi = 0;
+}
+
+/* Index buffers are uploaded with glBufferSubData by some apps (PPSSPP). Keep
+ * a copy in normal cached memory so the min/max index scan never has to read
+ * the write-combined BO. Any other write to the buffer drops the copy. */
+static void
+panfrost_buffer_subdata(struct pipe_context *pctx, struct pipe_resource *buffer,
+                        unsigned usage, unsigned offset, unsigned size,
+                        const void *data)
+{
+   struct panfrost_resource *rsrc = pan_resource(buffer);
+
+   u_default_buffer_subdata(pctx, buffer, usage, offset, size, data);
+
+   static int disabled = -1;
+   if (disabled < 0)
+      disabled = getenv("PAN_NO_INDEX_SHADOW") != NULL;
+
+   if (disabled || !rsrc->index_cache || buffer->width0 > (16u << 20))
+      return;
+
+   if (!rsrc->index_shadow) {
+      rsrc->index_shadow = malloc(buffer->width0);
+      if (!rsrc->index_shadow)
+         return;
+      rsrc->index_shadow_lo = rsrc->index_shadow_hi = 0;
+   }
+
+   /* u_default_buffer_subdata invalidated any overlapping range already */
+   if (rsrc->index_shadow_hi == rsrc->index_shadow_lo) {
+      rsrc->index_shadow_lo = offset;
+      rsrc->index_shadow_hi = offset + size;
+   } else if (offset == rsrc->index_shadow_hi) {
+      rsrc->index_shadow_hi = offset + size;
+   } else if (offset + size == rsrc->index_shadow_lo) {
+      rsrc->index_shadow_lo = offset;
+   } else {
+      rsrc->index_shadow_lo = offset;
+      rsrc->index_shadow_hi = offset + size;
+   }
+
+   memcpy(rsrc->index_shadow + offset, data, size);
+}
