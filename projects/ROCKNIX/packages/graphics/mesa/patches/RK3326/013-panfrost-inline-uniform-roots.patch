+/* PAN_OPT&262144: dwords del bloque 0 de las que cuelga matematica que solo depende de uniforms */
+#define PAN_UROOT_DW 128
+
+static void
+pan_add_uniform_roots(nir_shader *c)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(c);
+   nir_index_ssa_defs(impl);
+   unsigned n = impl->ssa_alloc;
+   uint64_t *mask = calloc(2 * n, sizeof(uint64_t));
+   int32_t *ubo_dw = malloc(n * sizeof(int32_t));
+   bool *uni = calloc(n, sizeof(bool));
+   unsigned cost[PAN_UROOT_DW] = {0};
+
+   for (unsigned i = 0; i < n; ++i)
+      ubo_dw[i] = -1;
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type == nir_instr_type_load_const) {
+            uni[nir_instr_as_load_const(instr)->def.index] = true;
+         } else if (instr->type == nir_instr_type_intrinsic) {
+            nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+            if (in->intrinsic == nir_intrinsic_load_ubo &&
+                nir_src_is_const(in->src[0]) && nir_src_as_uint(in->src[0]) == 0 &&
+                nir_src_is_const(in->src[1]) && in->def.bit_size == 32 &&
+                (nir_src_as_uint(in->src[1]) % 4) == 0) {
+               unsigned dw = nir_src_as_uint(in->src[1]) / 4;
+               if (dw + in->def.num_components <= PAN_UROOT_DW) {
+                  uni[in->def.index] = true;
+                  ubo_dw[in->def.index] = dw;
+               }
+            }
+         } else if (instr->type == nir_instr_type_alu) {
+            nir_alu_instr *a = nir_instr_as_alu(instr);
+            unsigned d = a->def.index;
+            bool u = true;
+            uint64_t m0 = 0, m1 = 0;
+
+            for (unsigned s = 0; s < nir_op_infos[a->op].num_inputs; ++s) {
+               unsigned si = a->src[s].src.ssa->index;
+               if (!uni[si]) {
+                  u = false;
+                  break;
+               }
+               if (ubo_dw[si] >= 0) {
+                  unsigned nc = nir_ssa_alu_instr_src_components(a, s);
+                  for (unsigned k = 0; k < nc; ++k) {
+                     unsigned b = ubo_dw[si] + a->src[s].swizzle[k];
+                     if (b < 64)
+                        m0 |= 1ull << b;
+                     else if (b < PAN_UROOT_DW)
+                        m1 |= 1ull << (b - 64);
+                  }
+               } else {
+                  m0 |= mask[2 * si];
+                  m1 |= mask[2 * si + 1];
+               }
+            }
+            if (!u)
+               continue;
+
+            uni[d] = true;
+            mask[2 * d] = m0;
+            mask[2 * d + 1] = m1;
+
+            unsigned w;
+            switch (a->op) {
+            case nir_op_mov:
+            case nir_op_vec2:
+            case nir_op_vec3:
+            case nir_op_vec4:
+            case nir_op_fneg:
+            case nir_op_fabs:
+               w = 0;
+               break;
+            case nir_op_frcp:
+            case nir_op_frsq:
+            case nir_op_fsqrt:
+            case nir_op_fexp2:
+            case nir_op_flog2:
+            case nir_op_fdiv:
+            case nir_op_fpow:
+               w = 5;
+               break;
+            default:
+               w = 1;
+               break;
+            }
+            if (!w)
+               continue;
+            for (unsigned b = 0; b < PAN_UROOT_DW; ++b) {
+               uint64_t bit = b < 64 ? (m0 >> b) : (m1 >> (b - 64));
+               if (bit & 1)
+                  cost[b] += w;
+            }
+         }
+      }
+   }
+
+   unsigned num = c->info.num_inlinable_uniforms;
+   unsigned added = 0;
+   unsigned nflags = num;
+   while (num < MAX_INLINABLE_UNIFORMS - 1) {
+      unsigned best = 0, bc = 0;
+      for (unsigned b = 0; b < PAN_UROOT_DW; ++b) {
+         if (cost[b] > bc) {
+            bc = cost[b];
+            best = b;
+         }
+      }
+      if (bc < 2)
+         break;
+      cost[best] = 0;
+      if (getenv("PAN_UROOT_MAX") && added >= (unsigned)atoi(getenv("PAN_UROOT_MAX")))
+         break;
+      if (getenv("PAN_UROOT_SKIP") && strstr(getenv("PAN_UROOT_SKIP"), "x") == NULL) {
+         char tag[16];
+         snprintf(tag, sizeof(tag), ",%u,", best);
+         char lst[256];
+         snprintf(lst, sizeof(lst), ",%s,", getenv("PAN_UROOT_SKIP"));
+         if (strstr(lst, tag))
+            continue;
+      }
+      if (getenv("PAN_INLINE_DEBUG"))
+         fprintf(stderr, "[R36-INLINE] raiz dw=%u coste=%u\n", best, bc);
+
+      bool dup = false;
+      for (unsigned i = 0; i < num; ++i)
+         dup |= c->info.inlinable_uniform_dw_offsets[i] == best;
+      if (!dup) {
+         c->info.inlinable_uniform_dw_offsets[num++] = best;
+         added++;
+      }
+   }
+
+   if (getenv("PAN_INLINE_DEBUG"))
+      fprintf(stderr, "[R36-INLINE] raices de uniforms: %u flags + %u raices\n",
+              c->info.num_inlinable_uniforms, added);
+   c->info.num_inlinable_uniforms = num;
+   /* El ultimo hueco (st solo lee los num primeros) guarda cuantos son flags: al llegar al tope de variantes
+    * el driver vuelve a inlinar solo esos (008) en vez de a la variante generica. */
+   c->info.inlinable_uniform_dw_offsets[MAX_INLINABLE_UNIFORMS - 1] = nflags;
+
+   free(mask);
+   free(ubo_dw);
+   free(uni);
+}
