    /* Ensure there is a cache to invalidate and a write */
@@ -153,3 +153,41 @@
    cache->size = valid_count;
    cache->index = 0;
 }
+
+bool
+pan_minmax_cache_get(struct pan_minmax_cache *cache, unsigned index_size,
+                     unsigned start, unsigned count, unsigned *min_index,
+                     unsigned *max_index)
+{
+   if (!cache)
+      return false;
+   simple_mtx_lock(&cache->lock);
+   bool r = pan_minmax_cache_get_locked(cache, index_size, start, count,
+                                        min_index, max_index);
+   simple_mtx_unlock(&cache->lock);
+   return r;
+}
+
+void
+pan_minmax_cache_add(struct pan_minmax_cache *cache, unsigned index_size,
+                     unsigned start, unsigned count, unsigned min_index,
+                     unsigned max_index)
+{
+   if (!cache)
+      return;
+   simple_mtx_lock(&cache->lock);
+   pan_minmax_cache_add_locked(cache, index_size, start, count, min_index,
+                               max_index);
+   simple_mtx_unlock(&cache->lock);
+}
+
+void
+pan_minmax_cache_invalidate(struct pan_minmax_cache *cache, unsigned index_size,
+                            size_t offset, size_t size)
+{
+   if (!cache)
+      return;
+   simple_mtx_lock(&cache->lock);
+   pan_minmax_cache_invalidate_locked(cache, index_size, offset, size);
+   simple_mtx_unlock(&cache->lock);
+}
