diff -ruN a/glthread.c b/glthread.c
--- a/src/mesa/main/glthread.c
+++ b/src/mesa/main/glthread.c
@@ -435,6 +435,31 @@
 void
 _mesa_glthread_finish_before(struct gl_context *ctx, const char *func)
 {
+   {
+      static const char *gs_file = (const char *)1;
+      static struct { const char *f; unsigned long n; } gs[512];
+      static unsigned long gs_calls;
+      if (gs_file == (const char *)1)
+         gs_file = getenv("R36_GLSYNC");
+      if (gs_file) {
+         unsigned i = 0;
+         while (i < 512 && gs[i].f && gs[i].f != func)
+            i++;
+         if (i < 512) {
+            gs[i].f = func;
+            gs[i].n++;
+         }
+         if ((++gs_calls & 255) == 0) {
+            FILE *o = fopen(gs_file, "w");
+            if (o) {
+               for (i = 0; i < 512 && gs[i].f; i++)
+                  fprintf(o, "%lu %s\n", gs[i].n, gs[i].f);
+               fclose(o);
+            }
+         }
+      }
+   }
+
    _mesa_glthread_finish(ctx);
 
    /* Uncomment this if you want to know where glthread syncs. */
