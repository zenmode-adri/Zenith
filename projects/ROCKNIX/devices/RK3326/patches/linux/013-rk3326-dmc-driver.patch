+/* Pack per-bit de-skew values into the register layout ATF expects (BSP algo) */
+static void px30_de_skew_to_reg(struct px30_de_skew *de_skew,
+				struct px30_ddr_timing *tim)
+{
+	u32 n, offset, shift;
+
+	memset_io(tim->ca_skew, 0, sizeof(tim->ca_skew));
+	memset_io(tim->cs0_skew, 0, sizeof(tim->cs0_skew));
+	memset_io(tim->cs1_skew, 0, sizeof(tim->cs1_skew));
+
+	for (n = 0; n < ARRAY_SIZE(de_skew->ca); n++) {
+		offset = n / 2;
+		shift = (n % 2) ? 0 : 4;
+		tim->ca_skew[offset] &= ~(0xf << shift);
+		tim->ca_skew[offset] |= (de_skew->ca[n] << shift);
+	}
+
+	for (n = 0; n < ARRAY_SIZE(de_skew->cs0); n++) {
+		offset = ((n / 21) * 11) + ((n % 21) / 2);
+		if ((n % 21) == 20)
+			shift = 0;
+		else
+			shift = ((n % 21) % 2) ? 0 : 4;
+		tim->cs0_skew[offset] &= ~(0xf << shift);
+		tim->cs0_skew[offset] |= (de_skew->cs0[n] << shift);
+	}
+
+	for (n = 0; n < ARRAY_SIZE(de_skew->cs1); n++) {
+		offset = ((n / 21) * 11) + ((n % 21) / 2);
+		if ((n % 21) == 20)
+			shift = 0;
+		else
+			shift = ((n % 21) % 2) ? 0 : 4;
+		tim->cs1_skew[offset] &= ~(0xf << shift);
+		tim->cs1_skew[offset] |= (de_skew->cs1[n] << shift);
+	}
+}
+
+static void px30_dmc_parse_timings(struct device *dev,
+				   struct px30_ddr_timing *tim)
+{
+	struct device_node *np_tim, *node = dev->of_node;
+	struct px30_de_skew de_skew;
+	bool has_skew = false;
+	u32 *p = (u32 *)tim;
+	int i, ret = 0;
+
+	np_tim = of_parse_phandle(node, "ddr_timing", 0);
+	if (!np_tim) {
+		dev_err(dev, "no ddr_timing node\n");
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(px30_dts_timing); i++)
+		ret |= of_property_read_u32(np_tim, px30_dts_timing[i], p + i);
+
+	if (ret)
+		dev_warn(dev, "ddr_timing incomplete, ATF defaults will be used\n");
+	else
+		tim->available = 1;
+
+	memset(&de_skew, 0, sizeof(de_skew));
+	for (i = 0; i < ARRAY_SIZE(px30_skew_ca); i++) {
+		if (!of_property_read_u32(np_tim, px30_skew_ca[i], &de_skew.ca[i]))
+			has_skew = true;
+	}
+	for (i = 0; i < ARRAY_SIZE(px30_skew_cs0); i++) {
+		if (!of_property_read_u32(np_tim, px30_skew_cs0[i], &de_skew.cs0[i]))
+			has_skew = true;
+		if (!of_property_read_u32(np_tim, px30_skew_cs1[i], &de_skew.cs1[i]))
+			has_skew = true;
+	}
+	if (has_skew)
+		px30_de_skew_to_reg(&de_skew, tim);
+
+	of_node_put(np_tim);
+}
+
+static int px30_dmc_set_rate(struct px30_dmcfreq *priv, unsigned long rate)
+{
+	struct arm_smccc_res res;
+	long timeout;
+
+	mutex_lock(&priv->lock);
+
+	priv->params->hz = rate;
+	priv->params->lcdc_type = 0;
+	priv->params->wait_flag1 = 1;
+	priv->params->wait_flag0 = 1;
+
+	reinit_completion(&priv->complete);
+
+	res = px30_sip_dram(PX30_SHARE_PAGE_TYPE_DDR, 0,
+			    ROCKCHIP_SIP_CONFIG_DRAM_SET_RATE);
+	if (res.a0) {
+		dev_err(priv->dev, "SIP set rate %lu failed: %lx\n",
+			rate, res.a0);
+		mutex_unlock(&priv->lock);
+		return -EIO;
+	}
+
+	if ((long)res.a1 == PX30_SIP_RET_SET_RATE_TIMEOUT) {
+		timeout = wait_for_completion_timeout(&priv->complete,
+						      msecs_to_jiffies(200));
+		if (!timeout)
+			dev_err(priv->dev,
+				"rate change %lu timed out, DRAM state uncertain\n",
+				rate);
+	}
+
+	priv->rate = rate;
+	mutex_unlock(&priv->lock);
+	return 0;
+}
+
+static int px30_dmcfreq_target(struct device *dev, unsigned long *freq,
+			       u32 flags)
+{
+	struct px30_dmcfreq *priv = dev_get_drvdata(dev);
+	struct dev_pm_opp *opp;
+	unsigned long target_rate;
+	int ret = 0;
+
+	rcu_read_lock();
+	opp = devfreq_recommended_opp(dev, freq, flags);
+	if (IS_ERR(opp)) {
+		rcu_read_unlock();
+		return PTR_ERR(opp);
+	}
+	target_rate = dev_pm_opp_get_freq(opp);
+	rcu_read_unlock();
+
+	if (priv->rate == target_rate)
+		return 0;
+
+	ret = px30_dmc_set_rate(priv, target_rate);
+
+	dev_dbg(dev, "%lu -> %lu\n", priv->rate, target_rate);
+
+	return ret;
+}
+
+static int px30_dmcfreq_get_dev_status(struct device *dev,
+				       struct devfreq_dev_status *stat)
+{
+	struct px30_dmcfreq *priv = dev_get_drvdata(dev);
+	struct devfreq_event_data edata;
+	int ret;
+
+	ret = devfreq_event_get_event(priv->edev, &edata);
+	if (ret)
+		return ret;
+
+	stat->busy_time = edata.load_count;
+	stat->total_time = edata.total_count;
+	stat->current_frequency = priv->rate;
+
+	return 0;
+}
+
+static int px30_dmcfreq_get_cur_freq(struct device *dev, unsigned long *freq)
+{
+	struct px30_dmcfreq *priv = dev_get_drvdata(dev);
+
+	*freq = priv->rate;
+
+	return 0;
+}
+
+static int px30_dmcfreq_suspend(struct device *dev)
+{
+	struct px30_dmcfreq *priv = dev_get_drvdata(dev);
+	int ret;
+
+	/* Drop DDR to the lowest OPP before entering suspend: the BSP
+	 * runs the DRAM at 194 MHz in suspend instead of staying at 666.
+	 */
+	if (priv->suspend_freq)
+		px30_dmc_set_rate(priv, priv->suspend_freq);
+
+	ret = devfreq_suspend_device(priv->devfreq);
+	if (ret)
+		dev_err(dev, "failed to suspend devfreq: %d\n", ret);
+
+	return ret;
+}
+
+static int px30_dmcfreq_resume(struct device *dev)
+{
+	struct px30_dmcfreq *priv = dev_get_drvdata(dev);
+	int ret;
+
+	ret = devfreq_resume_device(priv->devfreq);
+	if (ret)
+		dev_err(dev, "failed to resume devfreq: %d\n", ret);
+
+	return ret;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(px30_dmcfreq_pm_ops,
+				px30_dmcfreq_suspend, px30_dmcfreq_resume);
+
+static int px30_dmcfreq_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct px30_dmcfreq *priv;
+	struct arm_smccc_res res;
+	struct dev_pm_opp *opp;
+	unsigned long rate;
+	int irq, ret;
+	u32 pages;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+	mutex_init(&priv->lock);
+	init_completion(&priv->complete);
+	platform_set_drvdata(pdev, priv);
+
+	priv->dmc_clk = devm_clk_get(dev, "dmc_clk");
+	if (IS_ERR(priv->dmc_clk))
+		return dev_err_probe(dev, PTR_ERR(priv->dmc_clk),
+				     "Cannot get the clk dmc_clk\n");
+
+	/* Optional: vdd_logic shared with GPU, see header comment */
+	priv->vdd_center = devm_regulator_get_optional(dev, "center");
+	if (IS_ERR(priv->vdd_center))
+		priv->vdd_center = NULL;
+
+	priv->edev = devfreq_event_get_edev_by_phandle(dev, "devfreq-events", 0);
+	if (IS_ERR(priv->edev))
+		return dev_err_probe(dev, PTR_ERR(priv->edev),
+				     "Cannot get devfreq-events\n");
+
+	/* The vendor ATF must speak the DRAM config SIP */
+	res = px30_sip_dram(0, 0, PX30_DRAM_GET_VERSION);
+	if (res.a0 || res.a1 < PX30_ATF_MIN_VERSION) {
+		dev_err(dev, "ATF too old or invalid (0x%lx), need >= 0x%x\n",
+			res.a1, PX30_ATF_MIN_VERSION);
+		return -ENXIO;
+	}
+	dev_info(dev, "ATF version 0x%lx\n", res.a1);
+
+	/* First 4KB is the interface params page; timing table follows */
+	pages = DIV_ROUND_UP(sizeof(struct px30_ddr_timing), 4096) + 1;
+	res.a1 = 0;
+	arm_smccc_smc(PX30_SIP_SHARE_MEM, pages, PX30_SHARE_PAGE_TYPE_DDR, 0,
+		      0, 0, 0, 0, &res);
+	if (res.a0) {
+		dev_err(dev, "no ATF share memory (%lx)\n", res.a0);
+		return -ENOMEM;
+	}
+	priv->params = ioremap(res.a1, pages << 12);
+	if (!priv->params)
+		return -ENOMEM;
+	memset_io(priv->params, 0, pages << 12);
+
+	px30_dmc_parse_timings(dev, (void *)priv->params + PX30_DTS_PAR_OFFSET);
+
+	irq = platform_get_irq_byname(pdev, "complete_irq");
+	if (irq < 0)
+		return dev_err_probe(dev, irq, "no complete_irq\n");
+
+	/* Tell ATF which hardware IRQ signals rate-change completion */
+	priv->params->complt_hwirq = irqd_to_hwirq(irq_get_irq_data(irq));
+
+	ret = devm_request_irq(dev, irq, px30_dmc_complete_irq, 0,
+			       dev_name(dev), priv);
+	if (ret)
+		return ret;
+
+	res = px30_sip_dram(PX30_SHARE_PAGE_TYPE_DDR, 0,
+			    ROCKCHIP_SIP_CONFIG_DRAM_INIT);
+	if (res.a0) {
+		dev_err(dev, "DRAM_INIT failed: %lx\n", res.a0);
+		return -ENXIO;
+	}
+
+	ret = dev_pm_opp_of_add_table(dev);
+	if (ret) {
+		dev_err(dev, "Invalid operating-points in device tree\n");
+		return ret;
+	}
+
+	ret = devfreq_event_enable_edev(priv->edev);
+	if (ret) {
+		dev_err(dev, "failed to enable devfreq-event devices\n");
+		return ret;
+	}
+
+	if (of_property_read_u32(np, "upthreshold", &priv->ondemand_data.upthreshold))
+		priv->ondemand_data.upthreshold = 40;
+	if (of_property_read_u32(np, "downdifferential", &priv->ondemand_data.downdifferential))
+		priv->ondemand_data.downdifferential = 20;
+
+	priv->suspend_freq = 0;
+	{
+		u64 suspend_hz = 0;
+
+		if (!of_property_read_u64(np, "rockchip,suspend-frequency",
+					  &suspend_hz))
+			priv->suspend_freq = suspend_hz;
+	}
+
+	/* Current DDR rate, snapped to the closest OPP */
+	res = px30_sip_dram(PX30_SHARE_PAGE_TYPE_DDR, 0,
+			    ROCKCHIP_SIP_CONFIG_DRAM_GET_RATE);
+	rate = res.a0 ? 0 : res.a1;
+	opp = devfreq_recommended_opp(dev, &rate, 0);
+	if (!IS_ERR(opp)) {
+		priv->rate = dev_pm_opp_get_freq(opp);
+		dev_pm_opp_put(opp);
+	} else {
+		priv->rate = rate;
+	}
+
+	priv->profile = (struct devfreq_dev_profile) {
+		.polling_ms	= 200,
+		.target		= px30_dmcfreq_target,
+		.get_dev_status	= px30_dmcfreq_get_dev_status,
+		.get_cur_freq	= px30_dmcfreq_get_cur_freq,
+		.initial_freq	= priv->rate,
+	};
+
+	priv->devfreq = devm_devfreq_add_device(dev, &priv->profile,
+						DEVFREQ_GOV_SIMPLE_ONDEMAND,
+						&priv->ondemand_data);
+	if (IS_ERR(priv->devfreq))
+		return PTR_ERR(priv->devfreq);
+
+	dev_info(dev, "DMC ready, DDR at %lu Hz, suspend freq %lu\n",
+		 priv->rate, priv->suspend_freq);
+
+	return 0;
+}
+
+static void px30_dmcfreq_remove(struct platform_device *pdev)
+{
+	struct px30_dmcfreq *priv = dev_get_drvdata(&pdev->dev);
+
+	devfreq_event_disable_edev(priv->edev);
+}
+
+static const struct of_device_id px30_dmcfreq_of_match[] = {
+	{ .compatible = "rockchip,px30-dmc" },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, px30_dmcfreq_of_match);
+
+static struct platform_driver px30_dmcfreq_driver = {
+	.probe	= px30_dmcfreq_probe,
+	.remove	= px30_dmcfreq_remove,
+	.driver = {
+		.name = "px30-dmc",
+		.of_match_table = px30_dmcfreq_of_match,
+		.pm = pm_ptr(&px30_dmcfreq_pm_ops),
+	},
+};
+module_platform_driver(px30_dmcfreq_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("PX30/RK3326 DMC devfreq via Rockchip SIP");
