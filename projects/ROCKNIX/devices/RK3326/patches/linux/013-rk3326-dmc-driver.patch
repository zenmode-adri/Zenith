+static int px30_dfi_init(struct rockchip_dfi *dfi)
+{
+	u32 val;
+
+	regmap_read(dfi->regmap_pmu, PX30_PMUGRF_OS_REG2, &val);
+	dfi->ddr_type = FIELD_GET(PX30_PMUGRF_OS_REG2_DDRTYPE, val);
