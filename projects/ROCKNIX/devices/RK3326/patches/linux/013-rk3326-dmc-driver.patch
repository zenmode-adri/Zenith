+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PX30/RK3326 Dynamic Memory Controller frequency scaling via Rockchip SIP.
+ *
+ * Port of the PX30 code path of the Rockchip 4.4 BSP driver
+ * drivers/devfreq/rockchip_dmc.c. The DRAM (re)training itself is performed
+ * by the vendor ARM Trusted Firmware through SIP calls; this driver only
+ * negotiates OPPs, feeds the DDR timing table (from the "ddr_timing" DT
+ * node) into the ATF share page and asks ATF for rate changes.
+ *
+ * Unlike the BSP, no regulator is touched here on purpose: on RK3326
+ * handhelds vdd_logic is shared between the DMC and the GPU, and lowering
+ * it from here while the GPU runs a high OPP would undervolt the GPU.
+ * Voltage stays wherever the GPU/other consumers put it; all DDR OPPs are
+ * validated to work across the whole vdd_logic range (950-1150 mV).
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/devfreq.h>
+#include <linux/devfreq-event.h>
+#include <linux/interrupt.h>
