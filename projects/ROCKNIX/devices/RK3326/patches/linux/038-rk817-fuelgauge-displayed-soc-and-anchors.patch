+/* rk817_gauge.h - battery percentage logic for RK817 handhelds (see SPEC.md), v1.3.
+ * Header only, C99, integer math, no libc, no globals, no malloc.
+ * Units: uV, uA, uAh, seconds; percentages in milli-percent (100000 = 100 %).
+ * Deterministic: output depends only on (config, state, input).
+ *
+ * Out of scope (documented limit): the driver may apply set_counter up to ONE sample late
+ * (handled by the pend_* logic); a delay of two or more samples is not handled.
+ */
+#ifndef RK817_GAUGE_H
+#define RK817_GAUGE_H
+
+#ifndef __KERNEL__
+#include <stdint.h>
+#include <stdbool.h>
+typedef int64_t gauge_s64;
+#else
+typedef s64 gauge_s64;
+#endif
+
+/* The kernel may redefine this to div_s64(). */
+#ifndef GAUGE_DIV64
+#define GAUGE_DIV64(a, b) ((a) / (b))
+#endif
+
+/* Test-only: -DGAUGE_MUTANT=n breaks one rule (mutation testing). 0 = real code. */
+#ifndef GAUGE_MUTANT
+#define GAUGE_MUTANT 0
+#endif
+#define GAUGE_M(n) (GAUGE_MUTANT == (n))
+
+/* ------------------------------------------------------------------ tunables */
+#define GAUGE_SAMPLE_S            8        /* nominal sample period */
+#define GAUGE_TIME_CREDIT_S       24       /* max seconds one sample adds to a timer */
+#define GAUGE_DT_MAX_S            2592000  /* longest sleep we believe (30 days) */
+#define GAUGE_STEP_MPCT           1000     /* max displayed move per normal sample */
+#define GAUGE_FULL_MPCT           100000
+#define GAUGE_NOFULL_CAP_MPCT     99000    /* ceiling until the full anchor */
+#define GAUGE_MIN_SHOWN           1        /* lowest capacity shown before the empty anchor */
+
+/* D1 sanity window: a sample outside it is garbage and is ignored as a whole */
+#define GAUGE_V_MIN_UV            2500000
+#define GAUGE_V_MAX_UV            4600000
+#define GAUGE_I_MAX_UA            10000000
+#define GAUGE_CTR_MAX_UAH         20000000
+#define GAUGE_CTR_BELIEF_MAX      100000000
+
+/* R2 direction (uA). Charging: > CHG_ON for 2 samples; leaves it when < HOLD for 2.
+ * Discharging: < -DIS_ON for 2 samples; leaves it when > HOLD for 2. Between: keep state. */
+#define GAUGE_CHG_ON_UA           30000
+#define GAUGE_DIS_ON_UA           10000
+#define GAUGE_HOLD_UA             10000
+#define GAUGE_DIR_SAMPLES         2
+#define GAUGE_ONLINE_MIN_UA       (-30000)
+
+/* R4 full anchor */
+#define GAUGE_FIN_TIME_S          30
+#define GAUGE_FIN_MIN_UA          (-30000)
+#define GAUGE_TAP_TIME_S          180
+#define GAUGE_TAP1_HV_UV          25000    /* branch 1: at rest near v_charge */
+#define GAUGE_TAP1_MIN_UA         (-10000)
+#define GAUGE_TAP_MAX_UA          100000
+#define GAUGE_TAP2_HV_UV          60000    /* branch 2: a seen charge tapering */
+#define GAUGE_TAP2_MIN_UA         20000
+#define GAUGE_TAP2_PEAK_DIV       3
+#define GAUGE_PEAK_MAX_UA         3500000
+#define GAUGE_CLEAR_DIS_UA        150000   /* a clear discharge: resets the charge peak */
+#define GAUGE_FULL_DROP_MPCT      1500     /* counter below fcc by this: not full any more */
+#define GAUGE_FULL_CLAMP_MPCT     500      /* counter above fcc by this while full: clamp */
+#define GAUGE_OFF_UA              1500     /* unplugged and drawing at least this ... */
+#define GAUGE_OFF_N               15       /* ... for this many samples: not "full" any more */
+
+/* R5 empty anchor / low zone */
+#define GAUGE_RBAT_DEFAULT_UOHM   100000
+#define GAUGE_RBAT_EXTRA_UOHM     30000
+#define GAUGE_VCUT_MAX_DROP_UV    100000
+#define GAUGE_EMPTY_TIME_S        60
+#define GAUGE_EMPTY_DEEP_UV       50000
+#define GAUGE_EMPTY_DEEP_N        2
+#define GAUGE_LZ_SPAN_UV          150000   /* zone width above v_cut */
+#define GAUGE_LZ_MPCT             15000    /* ceiling at the top of the zone */
+#define GAUGE_LZ_SAMPLES          3
+#define GAUGE_EMPTY_INST_UV       150000   /* one sample below v_empty - this: empty at once ... */
+#define GAUGE_EMPTY_INST_MAX_MPCT 30000    /* ... if the counter does not say more than this */
+
+/* R6 learning, init, R7 */
+#define GAUGE_LEARN_MAX_PCT       10
+#define GAUGE_FCC_MIN_DESIGN_MPCT 50000    /* learned fcc range, of design */
+#define GAUGE_FCC_MAX_DESIGN_MPCT 130000
+#define GAUGE_FCC_VALID_MIN_MPCT  15000    /* saved fcc accepted range, of design */
+#define GAUGE_INIT_KEEP_MPCT      3000
+#define GAUGE_REST_FAR_MPCT       30000    /* R7': counter this far from a trusted rest ... */
+#define GAUGE_REST_BAND_MPCT      20000    /* ... goes to the edge of this band around it */
+#define GAUGE_PEND_SAMPLES        2        /* how long a counter rewrite may take to show up */
+#define GAUGE_CNT_MAX             100
+
+/* ------------------------------------------------------------------ interface */
+enum gauge_pmic_status { GAUGE_PMIC_OFF, GAUGE_PMIC_DEAD, GAUGE_PMIC_TRICKLE, GAUGE_PMIC_CC_CV,
+                         GAUGE_PMIC_FINISH, GAUGE_PMIC_USB_OVER_VOL, GAUGE_PMIC_BAT_TMP_ERR,
+                         GAUGE_PMIC_BAT_TIM_ERR };
+enum gauge_status { GAUGE_DISCHARGING, GAUGE_CHARGING, GAUGE_FULL, GAUGE_NOT_CHARGING };
+
+struct gauge_config {
+	int design_uah;
+	int v_empty_uv;
+	int v_charge_uv;
+	int r_bat_uohm;              /* 0 -> GAUGE_RBAT_DEFAULT_UOHM */
+};
+
+struct gauge_input {
+	int counter_uah;             /* raw signed coulomb counter, NOT clamped */
+	int voltage_uv;
+	int current_ua;              /* + = into the battery */
+	int pmic_status;
+	bool plugged;
+	int rest_ocv_soc;            /* milli-%, trusted rest only, else -1 */
+	int dt_s;
+	bool resumed;
+};
+
+enum { GAUGE_DIR_NONE, GAUGE_DIR_CHG, GAUGE_DIR_DIS };
+enum { GAUGE_CYC_NONE, GAUGE_CYC_FROM_FULL, GAUGE_CYC_FROM_EMPTY };
+
+struct gauge_state {
+	int dsoc;                    /* displayed, milli-% (persist) */
+	int fcc_uah;                 /* learned full capacity (persist) */
+	/* private */
+	int ctr;                     /* believed counter (survives late rewrites) */
+	int prev_raw;
+	int pend_n, pend_jump;       /* a rewrite we issued may still show up as a jump */
+	int dir;
+	int chg_n, dis_n, hi_n, lo_n;
+	int fin_t, tap1_t, tap2_t, emp_t, emp_n, lz_n;
+	int peak, prev_c, cdis_n, off_n;   /* R4(b): charge peak, last current, drain counters */
+	int last_rsoc;               /* counter-based soc of the previous sample (D7) */
+	int last_cap, last_status;   /* outputs repeated for a garbage sample (D1) */
+	bool last_online;
+	int cyc;                     /* clean-cycle tracking (R6) */
+	int saved_pct, saved_fcc;
+	bool full, full_shown, empty, chg_seen, lock;
+};
+
+struct gauge_output {
+	int capacity;                /* 0..100 */
+	int status;
+	bool online;
+	bool set_counter;
+	int set_counter_uah;
+	bool save;
+};
+
+/* ------------------------------------------------------------------ helpers */
+static inline int gauge_abs(int x) { return x < 0 ? -x : x; }
+static inline int gauge_min(int a, int b) { return a < b ? a : b; }
+static inline int gauge_clamp(int x, int lo, int hi) { return x < lo ? lo : (x > hi ? hi : x); }
+
+/* fcc * mpct / 100 % */
+static inline int gauge_pct_of(int fcc, int mpct)
+{
+	return (int)GAUGE_DIV64((gauge_s64)fcc * mpct, GAUGE_FULL_MPCT);
+}
+
+/* R1 */
+static inline int gauge_rsoc(int ctr, int fcc)
+{
+	if (ctr <= 0 || fcc <= 0)
+		return 0;
+	if (ctr >= fcc)
+		return GAUGE_FULL_MPCT;
+	return (int)GAUGE_DIV64((gauge_s64)ctr * GAUGE_FULL_MPCT, fcc);
+}
+
+/* D1: is this sample believable at all? */
+static inline bool gauge_sane(const struct gauge_input *in)
+{
+	if (GAUGE_M(32))
+		return true;
+	return in->voltage_uv >= GAUGE_V_MIN_UV && in->voltage_uv <= GAUGE_V_MAX_UV &&
+	       in->current_ua >= -GAUGE_I_MAX_UA && in->current_ua <= GAUGE_I_MAX_UA &&
+	       in->counter_uah >= -GAUGE_CTR_MAX_UAH && in->counter_uah <= GAUGE_CTR_MAX_UAH;
+}
+
+/* R6: limit a learned capacity to +-10 % of the current one and [50 %, 130 %] of design */
+static inline int gauge_learn_limit(const struct gauge_config *cfg, int cur, int cand)
+{
+	int lim = (int)GAUGE_DIV64((gauge_s64)cur * GAUGE_LEARN_MAX_PCT, 100);
+	int lo = cur - lim, hi = cur + lim;
+	int dmax = gauge_pct_of(cfg->design_uah,
+				GAUGE_M(40) ? GAUGE_FULL_MPCT : GAUGE_FCC_MAX_DESIGN_MPCT);
+
+	if (GAUGE_M(14))
+		lo = 0, hi = 0x7fffffff;
+	cand = gauge_clamp(cand, lo, hi);
+	return gauge_clamp(cand, gauge_pct_of(cfg->design_uah, GAUGE_FCC_MIN_DESIGN_MPCT), dmax);
+}
+
+/* R5: load compensated cut-off voltage. ia = discharge current, >= 0 */
+static inline int gauge_vcut(const struct gauge_config *cfg, int ia, int rbat)
+{
+	int drop;
+
+	if (GAUGE_M(7))
+		return cfg->v_empty_uv;
+	drop = (int)GAUGE_DIV64((gauge_s64)ia * rbat, 1000000);
+	return cfg->v_empty_uv - gauge_min(drop, GAUGE_VCUT_MAX_DROP_UV);
+}
+
+/* Ask the caller to rewrite the counter. The belief follows at once; the jump that will
+ * show up in the raw counter (now or one sample late) is remembered and ignored. */
+static inline void gauge_rewrite(struct gauge_state *st, const struct gauge_input *in,
+				 struct gauge_output *out, int target)
+{
+	st->pend_jump = target - in->counter_uah;
+	st->pend_n = GAUGE_PEND_SAMPLES;
+	st->ctr = target;
+	out->set_counter = true;
+	out->set_counter_uah = target;
+}
+
+static inline void gauge_init(struct gauge_state *st, const struct gauge_config *cfg,
+			      int saved_dsoc, int saved_fcc_uah, int counter_uah)
+{
+	int rsoc;
+
+	counter_uah = gauge_clamp(counter_uah, -GAUGE_CTR_BELIEF_MAX, GAUGE_CTR_BELIEF_MAX);
+	st->fcc_uah = cfg->design_uah;
+	if (saved_fcc_uah > 0 &&
+	    saved_fcc_uah >= gauge_pct_of(cfg->design_uah, GAUGE_FCC_VALID_MIN_MPCT) &&
+	    saved_fcc_uah <= gauge_pct_of(cfg->design_uah, GAUGE_FCC_MAX_DESIGN_MPCT))
+		st->fcc_uah = saved_fcc_uah;
+	st->ctr = counter_uah;
+	st->prev_raw = counter_uah;
+	st->pend_n = st->pend_jump = 0;
+	st->dir = GAUGE_DIR_NONE;
+	st->chg_n = st->dis_n = st->hi_n = st->lo_n = 0;
+	st->fin_t = st->tap1_t = st->tap2_t = st->emp_t = st->emp_n = st->lz_n = 0;
+	st->peak = st->prev_c = st->cdis_n = st->off_n = 0;
+	st->cyc = GAUGE_CYC_NONE;
+	st->full = st->full_shown = st->empty = st->chg_seen = st->lock = false;
+	rsoc = gauge_rsoc(counter_uah, st->fcc_uah);
+	st->last_rsoc = rsoc;
+	if (saved_dsoc >= 0 && gauge_abs(saved_dsoc - rsoc) <= GAUGE_INIT_KEEP_MPCT) {
+		st->dsoc = gauge_clamp(saved_dsoc, 0, GAUGE_FULL_MPCT);
+		st->full = st->dsoc >= GAUGE_FULL_MPCT;   /* a saved 100 % was a real full */
+		st->full_shown = st->full;
+	} else {
+		st->dsoc = gauge_min(rsoc, GAUGE_NOFULL_CAP_MPCT);
+	}
+	/* Booted from a real empty (saved and counted soc both within the init band of 0 %):
+	 * the charge counted from here to the next full anchor is a clean empty->full
+	 * measurement, so let that anchor learn fcc (bounded by gauge_learn_limit). The
+	 * empty anchor itself may never run when a power-off guard cuts first. */
+	if (saved_dsoc >= 0 && saved_dsoc <= GAUGE_INIT_KEEP_MPCT &&
+	    rsoc <= GAUGE_INIT_KEEP_MPCT)
+		st->cyc = GAUGE_CYC_FROM_EMPTY;
+	st->saved_pct = st->dsoc / 1000;
+	st->saved_fcc = st->fcc_uah;
+	st->last_cap = gauge_clamp((st->dsoc + 500) / 1000, 0, 100);
+	st->last_status = GAUGE_NOT_CHARGING;
+	st->last_online = false;
+}
+
+static inline void gauge_step(struct gauge_state *st, const struct gauge_config *cfg,
+			      const struct gauge_input *in, struct gauge_output *out)
+{
+	const int c = in->current_ua, v = in->voltage_uv;
+	const int dt = in->dt_s > 0 ? gauge_min(in->dt_s, GAUGE_DT_MAX_S) : GAUGE_SAMPLE_S;
+	const int tdt = in->resumed ? 0 : gauge_min(dt, GAUGE_TIME_CREDIT_S);
+	const int rest = in->rest_ocv_soc < 0 ? -1 : gauge_min(in->rest_ocv_soc, GAUGE_FULL_MPCT);
+	const int rbat = (cfg->r_bat_uohm > 0 ? cfg->r_bat_uohm : GAUGE_RBAT_DEFAULT_UOHM) +
+			 GAUGE_RBAT_EXTRA_UOHM;
+	const bool pmic_chg = in->pmic_status == GAUGE_PMIC_DEAD ||
+			      in->pmic_status == GAUGE_PMIC_TRICKLE ||
+			      in->pmic_status == GAUGE_PMIC_CC_CV;
+	const int vhi = cfg->v_charge_uv;
+	bool anchor = false, empty_hit = false, rewrote = false, ok1, ok2;
+	int delta, rsoc, target, budget, thr, cm;
+
+	out->set_counter = false;
+	out->set_counter_uah = 0;
+	out->save = false;
+	if (!gauge_sane(in)) {            /* D1: repeat the last answer, touch nothing */
+		out->capacity = st->last_cap;
+		out->status = st->last_status;
+		out->online = st->last_online;
+		return;
+	}
+
+	/* counter belief: follow raw deltas, minus the jump of a rewrite we asked for */
+	delta = in->counter_uah - st->prev_raw;
+	st->prev_raw = in->counter_uah;
+	if (st->pend_n > 0) {
+		if (gauge_abs(delta - st->pend_jump) < gauge_abs(delta)) {
+			delta -= st->pend_jump;
+			st->pend_n = 0;
+		} else {
+			st->pend_n--;
+		}
+	}
+	st->ctr = gauge_clamp(st->ctr + delta, -GAUGE_CTR_BELIEF_MAX, GAUGE_CTR_BELIEF_MAX);
+
+	/* R2 direction with hysteresis */
+	st->chg_n = c > GAUGE_CHG_ON_UA ? gauge_min(st->chg_n + 1, GAUGE_CNT_MAX) : 0;
+	st->dis_n = c < -GAUGE_DIS_ON_UA ? gauge_min(st->dis_n + 1, GAUGE_CNT_MAX) : 0;
+	st->hi_n = c > GAUGE_HOLD_UA ? gauge_min(st->hi_n + 1, GAUGE_CNT_MAX) : 0;
+	st->lo_n = c < GAUGE_HOLD_UA ? gauge_min(st->lo_n + 1, GAUGE_CNT_MAX) : 0;
+	if (in->resumed)
+		st->chg_n = st->dis_n = st->hi_n = st->lo_n = 0;
+	if (GAUGE_M(11)) {
+		st->dir = c > 0 ? GAUGE_DIR_CHG : (c < 0 ? GAUGE_DIR_DIS : GAUGE_DIR_NONE);
+	} else if (st->chg_n >= GAUGE_DIR_SAMPLES || (pmic_chg && c > -GAUGE_DIS_ON_UA)) {
+		st->dir = GAUGE_DIR_CHG;
+	} else if (st->dis_n >= GAUGE_DIR_SAMPLES) {
+		st->dir = GAUGE_DIR_DIS;
+	} else if (st->dir == GAUGE_DIR_CHG && st->lo_n >= GAUGE_DIR_SAMPLES) {
+		st->dir = GAUGE_DIR_NONE;
+	} else if (st->dir == GAUGE_DIR_DIS && st->hi_n >= GAUGE_DIR_SAMPLES) {
+		st->dir = GAUGE_DIR_NONE;
+	}
+	if (st->dir == GAUGE_DIR_CHG) {
+		st->chg_seen = true;
+		st->empty = false;
+	} else if (st->dir == GAUGE_DIR_DIS) {
+		st->chg_seen = false;
+	}
+
+	/* charge peak: the highest current two samples in a row agree on (a stray sample is no
+	 * peak); a clear discharge starts a new charge */
+	cm = GAUGE_M(37) ? c : gauge_min(c, st->prev_c);
+	st->prev_c = c;
+	st->cdis_n = c < -GAUGE_CLEAR_DIS_UA ? gauge_min(st->cdis_n + 1, GAUGE_CNT_MAX) : 0;
+	if (st->cdis_n >= GAUGE_DIR_SAMPLES)
+		st->peak = 0;
+	if (cm > st->peak)
+		st->peak = gauge_min(cm, GAUGE_PEAK_MAX_UA);
+
+	/* "full" on the display ends when we are unplugged and clearly drawing current */
+	st->off_n = (c <= -GAUGE_OFF_UA && !in->plugged) ?
+		gauge_min(st->off_n + 1, GAUGE_CNT_MAX) : 0;
+	if (st->off_n >= GAUGE_OFF_N && !GAUGE_M(38))
+		st->full_shown = false;
+	if (st->full && in->plugged)
+		st->full_shown = true;
+
+	/* a big counter rise during a suspend means a charge happened meanwhile */
+	if (in->resumed && delta > gauge_pct_of(st->fcc_uah, GAUGE_STEP_MPCT))
+		st->chg_seen = true;
+	if (st->chg_seen || in->plugged)
+		st->lock = false;
+
+	/* R7': a trusted rest voltage far from the counter pulls it to the edge of a band */
+	if (rest >= 0) {
+		int d = gauge_rsoc(st->ctr, st->fcc_uah) - rest;
+		int far = GAUGE_M(6) ? 0 : GAUGE_REST_FAR_MPCT;
+		int tgt = 0;
+		bool fix = false;
+
+		if (d > far) {
+			tgt = rest + (GAUGE_M(34) ? 0 : GAUGE_REST_BAND_MPCT);
+			fix = true;
+		} else if (d < -far && !GAUGE_M(33)) {
+			tgt = rest - (GAUGE_M(34) ? 0 : GAUGE_REST_BAND_MPCT);
+			fix = true;
+		}
+		if (fix) {
+			tgt = gauge_clamp(tgt, 0, GAUGE_FULL_MPCT);
+			gauge_rewrite(st, in, out, gauge_pct_of(st->fcc_uah, tgt));
+			st->cyc = GAUGE_CYC_NONE;
+			rewrote = true;
+		}
+	}
+
+	/* R4: the full flag drops once the counter fell 1.5 % under fcc, whatever the direction */
+	thr = st->fcc_uah - gauge_pct_of(st->fcc_uah, GAUGE_FULL_DROP_MPCT);
+	if (st->full && st->ctr < thr &&
+	    (!GAUGE_M(26) || st->dir == GAUGE_DIR_DIS || in->resumed || rewrote)) {
+		st->full = false;
+		st->full_shown = false;
+		st->chg_seen = false;             /* a new charge has to be seen again */
+		st->lock = true;
+	}
+
+	/* R4 full anchor: (a) PMIC FINISH, (b) blind taper, two branches */
+	st->fin_t = (in->pmic_status == GAUGE_PMIC_FINISH && c >= GAUGE_FIN_MIN_UA) ?
+		    st->fin_t + tdt : 0;
+	/* branch 1: at rest near v_charge (a full pack on a charger we cannot see). Not after
+	 * the full flag dropped from use, until a charge or the charger shows up again. */
+	ok1 = (!st->lock || GAUGE_M(43)) && v >= vhi - GAUGE_TAP1_HV_UV &&
+	      c >= GAUGE_TAP1_MIN_UA && c <= GAUGE_TAP_MAX_UA;
+	/* branch 2: a charge we saw, tapering: 20 mA..100 mA and under a third of its peak */
+	ok2 = (st->chg_seen || GAUGE_M(10)) && c <= GAUGE_TAP_MAX_UA &&
+	      (GAUGE_M(9) || v >= vhi - GAUGE_TAP2_HV_UV) &&
+	      c >= (GAUGE_M(35) ? GAUGE_TAP1_MIN_UA : GAUGE_TAP2_MIN_UA) &&
+	      (GAUGE_M(36) || c <= st->peak / GAUGE_TAP2_PEAK_DIV);
+	st->tap1_t = ok1 ? st->tap1_t + (GAUGE_M(8) ? GAUGE_TAP_TIME_S : tdt) : 0;
+	st->tap2_t = ok2 ? st->tap2_t + (GAUGE_M(8) ? GAUGE_TAP_TIME_S : tdt) : 0;
+	if (!st->full && (st->fin_t >= (GAUGE_M(20) ? 1 : GAUGE_FIN_TIME_S) ||
+			  st->tap1_t >= GAUGE_TAP_TIME_S || st->tap2_t >= GAUGE_TAP_TIME_S)) {
+		if (st->cyc == GAUGE_CYC_FROM_EMPTY && st->ctr > 0 && !GAUGE_M(15))
+			st->fcc_uah = gauge_learn_limit(cfg, st->fcc_uah, st->ctr);
+		gauge_rewrite(st, in, out, st->fcc_uah);
+		st->full = st->full_shown = true;
+		st->empty = false;
+		st->cyc = GAUGE_CYC_FROM_FULL;
+		anchor = true;
+		if (!GAUGE_M(29))                 /* the evidence is spent */
+			st->peak = 0;
+		st->tap1_t = st->tap2_t = 0;
+	} else if (st->full && st->pend_n == 0 &&
+		   st->ctr > st->fcc_uah + gauge_pct_of(st->fcc_uah, GAUGE_FULL_CLAMP_MPCT)) {
+		/* keep "full" honest while overcharging */
+		gauge_rewrite(st, in, out, st->fcc_uah);
+	}
+
+	/* R5 empty anchor */
+	if (!st->empty && !in->resumed && c < 0 && st->dir != GAUGE_DIR_CHG) {
+		int vcut = gauge_vcut(cfg, -c, rbat);
+		bool inst, timed;
+
+		st->emp_t = v < vcut ? st->emp_t + tdt : 0;
+		/* one very low sample is enough only if the counter agrees that the pack is low */
+		inst = !GAUGE_M(23) && v < cfg->v_empty_uv - GAUGE_EMPTY_INST_UV &&
+		       (GAUGE_M(41) ||
+		        gauge_rsoc(st->ctr, st->fcc_uah) <= GAUGE_EMPTY_INST_MAX_MPCT);
+		st->emp_n = v < vcut - GAUGE_EMPTY_DEEP_UV ?
+			gauge_min(st->emp_n + 1, GAUGE_CNT_MAX) : 0;
+		timed = GAUGE_M(13) ? v < vcut : (st->emp_t >= GAUGE_EMPTY_TIME_S ||
+						  st->emp_n >= GAUGE_EMPTY_DEEP_N);
+		if (inst || timed) {
+			if (st->cyc == GAUGE_CYC_FROM_FULL && !GAUGE_M(15) &&
+			    (timed || GAUGE_M(42)))      /* a one-sample hit does not teach */
+				st->fcc_uah = gauge_learn_limit(cfg, st->fcc_uah,
+								st->fcc_uah - st->ctr);
+			gauge_rewrite(st, in, out, 0);
+			st->dsoc = 0;
+			st->empty = true;
+			st->full = st->full_shown = false;
+			st->cyc = GAUGE_CYC_FROM_EMPTY;
+			st->emp_t = st->emp_n = st->lz_n = 0;
+			empty_hit = anchor = true;
+		}
+	} else if (c >= 0 || st->dir == GAUGE_DIR_CHG) {
+		st->emp_t = st->emp_n = 0;
+	}
+
+	/* R3 displayed soc */
+	rsoc = gauge_rsoc(st->ctr, st->fcc_uah);
+	target = rsoc;
+	if (!st->full && !GAUGE_M(2) && !(GAUGE_M(19) && in->resumed) &&
+	    target > GAUGE_NOFULL_CAP_MPCT)
+		target = GAUGE_NOFULL_CAP_MPCT;
+
+	/* R5 low zone: voltage ceiling while discharging, applied after 3 samples */
+	if (!GAUGE_M(3) && !empty_hit && st->dir == GAUGE_DIR_DIS && !in->resumed && c < 0) {
+		int margin = v - gauge_vcut(cfg, -c, rbat);
+		int zmax = margin <= 0 ? 0 : margin / (GAUGE_LZ_SPAN_UV / GAUGE_LZ_MPCT);
+
+		if (margin < GAUGE_LZ_SPAN_UV && zmax <= st->dsoc)
+			st->lz_n = gauge_min(st->lz_n + 1, GAUGE_CNT_MAX);
+		else
+			st->lz_n = 0;
+		if (st->lz_n >= GAUGE_LZ_SAMPLES && zmax < target)
+			target = zmax;
+	} else {
+		st->lz_n = 0;
+	}
+
+	if (!empty_hit) {
+		budget = GAUGE_STEP_MPCT;
+		if (in->resumed && !GAUGE_M(12))
+			budget = gauge_clamp(dt / GAUGE_SAMPLE_S, 1, GAUGE_CNT_MAX) *
+				 GAUGE_STEP_MPCT;
+		if (GAUGE_M(4))
+			budget = GAUGE_FULL_MPCT;
+		if (target > st->dsoc) {
+			if (GAUGE_M(1) || in->resumed ||
+			    (st->dir == GAUGE_DIR_CHG && c >= 0) ||
+			    (st->full && c > -GAUGE_CLEAR_DIS_UA)) {
+				int up = gauge_min(budget, target - st->dsoc);
+
+				/* D7: after a sleep it only rises as far as the counter did */
+				if (in->resumed && !GAUGE_M(39))
+					up = gauge_min(up, gauge_clamp(rsoc - st->last_rsoc, 0,
+								       GAUGE_FULL_MPCT));
+				st->dsoc += up;
+			}
+		} else if (target < st->dsoc) {
+			if (GAUGE_M(5) || in->resumed ||
+			    ((GAUGE_M(24) ? st->dir == GAUGE_DIR_DIS : st->dir != GAUGE_DIR_CHG) &&
+			     c <= GAUGE_HOLD_UA))
+				st->dsoc -= gauge_min(budget, st->dsoc - target);
+		}
+	}
+	st->last_rsoc = rsoc;
+
+	/* outputs */
+	out->capacity = gauge_clamp((st->dsoc + 500) / 1000, 0, 100);
+	if (out->capacity < GAUGE_MIN_SHOWN && !st->empty && !GAUGE_M(17))
+		out->capacity = GAUGE_MIN_SHOWN;
+	out->online = in->plugged || st->dir == GAUGE_DIR_CHG ||
+		      (st->full_shown && c >= GAUGE_ONLINE_MIN_UA);
+	if (st->full_shown && out->online)
+		out->status = GAUGE_FULL;
+	else if (st->dir == GAUGE_DIR_CHG)
+		out->status = GAUGE_CHARGING;
+	else if (st->dir == GAUGE_DIR_DIS)
+		out->status = GAUGE_DISCHARGING;
+	else
+		out->status = GAUGE_NOT_CHARGING;
+	st->last_cap = out->capacity;
+	st->last_status = out->status;
+	st->last_online = out->online;
+
+	/* R9 */
+	if (anchor || st->dsoc / 1000 != st->saved_pct || st->fcc_uah != st->saved_fcc) {
+		out->save = true;
+		st->saved_pct = st->dsoc / 1000;
+		st->saved_fcc = st->fcc_uah;
+	}
+}
+
+#endif /* RK817_GAUGE_H */
