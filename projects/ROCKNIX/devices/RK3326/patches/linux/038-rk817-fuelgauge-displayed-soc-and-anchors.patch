 	/* Update reported voltage. */
 	charger->volt_avg_uv = rk817_bat_voltage_uv(charger,
@@ -509,8 +460,94 @@
 
 	charger->relax_voltage_uv = rk817_bat_relax_voltage_uv(charger, true);
 
-	/* Calibrate battery capacity and soc. */
-	rk817_bat_calib_cap(charger);
+	/*
+	 * A supply is present if the PMIC says so or the optional dc-det gpio
+	 * does: some boards charge through an external IC the PMIC cannot see.
+	 */
+	regmap_read(charger->rk808->regmap, RK817_SYS_STS, &reg);
+	charger->plugged_in = reg & RK817_PLUG_IN_STS;
+	in.plugged = charger->plugged_in;
+	charger->dbg_pmic_plug = charger->plugged_in;
+	charger->dbg_dcdet = -1;
+	if (charger->dc_det) {
+		charger->dbg_dcdet = gpiod_get_value_cansleep(charger->dc_det);
+		if (charger->dbg_dcdet > 0)
+			in.plugged = true;
+	}
+
+	/*
+	 * Time since the previous pass. Passes also come from the plug ISRs, so
+	 * never pass less than 1 s (the gauge reads 0 as "one nominal period").
+	 */
+	now = ktime_get_boottime_seconds();
+	in.rest_ocv_soc = -1;
+	if (charger->resumed) {
+		in.resumed = true;
+		in.dt_s = charger->resume_dt_s;
+		in.rest_ocv_soc = charger->resume_rest_ocv_soc;
+		charger->resumed = false;
+	} else if (charger->last_sample_s) {
+		in.dt_s = clamp_t(time64_t, now - charger->last_sample_s, 1, INT_MAX);
+	} else {
+		in.dt_s = GAUGE_SAMPLE_S;
+	}
+	charger->last_sample_s = now;
+
+	in.counter_uah = raw_uah;
+	in.voltage_uv = charger->volt_avg_uv;
+	in.current_ua = charger->cur_avg_ua;
+	in.pmic_status = charger->charge_status;
+	gauge_step(&charger->gauge, &charger->gauge_cfg, &in, &out);
+
+	/* Apply the decision. */
+	if (out.set_counter) {
+		dev_info(charger->dev,
+			 "gauge: counter %d -> %d uAh, %d uV, %d uA, shown %d%%, fcc %d uAh\n",
+			 raw_uah, out.set_counter_uah, in.voltage_uv,
+			 in.current_ua, out.capacity, charger->gauge.fcc_uah);
+		rk817_bat_write_counter_uah(charger, out.set_counter_uah);
+	}
+	charger->soc = charger->gauge.dsoc;
+	charger->fcc_mah = charger->gauge.fcc_uah / 1000;
+	if (out.save)
+		rk817_record_battery_nvram_values(charger);
+
+	/* Update reported charge: the counter, limited to the pack's range. */
+	charger->charge_now_uah = clamp(raw_uah, 0, charger->fcc_mah * 1000);
+
+	switch (out.status) {
+	case GAUGE_CHARGING:
+		status = POWER_SUPPLY_STATUS_CHARGING;
+		break;
+	case GAUGE_FULL:
+		status = POWER_SUPPLY_STATUS_FULL;
+		break;
+	case GAUGE_DISCHARGING:
+		status = POWER_SUPPLY_STATUS_DISCHARGING;
+		break;
+	default:
+		status = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	}
+
+	changed = out.capacity != charger->capacity ||
+		  status != charger->status ||
+		  out.online != charger->online;
+	if (status != charger->status || out.online != charger->online)
+		dev_info(charger->dev,
+			 "gauge: status %d -> %d, online %d -> %d, shown %d%%, %d uV, %d uA\n",
+			 charger->status, status, charger->online, out.online,
+			 out.capacity, in.voltage_uv, in.current_ua);
+	charger->capacity = out.capacity;
+	charger->status = status;
+	charger->online = out.online;
+
+	mutex_unlock(&charger->lock);
+
+	if (changed) {
+		power_supply_changed(charger->bat_ps);
+		power_supply_changed(charger->chg_ps);
+	}
 }
 
