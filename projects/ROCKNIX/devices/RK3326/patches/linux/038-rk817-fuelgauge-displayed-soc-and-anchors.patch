 	struct power_supply_battery_info *bat_info;
 
 	/* Stamped at system suspend to correct the gauge across sleep. */
@@ -216,6 +255,38 @@
 }
 
 /*
+ * Coulomb counter <-> uAh, exact to 1 uAh. The ADC_TO_CHARGE_UAH() and
+ * CHARGE_TO_ADC() macros above divide before multiplying (172 uAh steps on
+ * read, up to 1 mAh lost on write); the gauge rewrites the counter often, so
+ * it uses these 64 bit versions instead.
+ */
+static int rk817_bat_read_counter_uah(struct rk817_charger *charger)
+{
+	u8 bulk_reg[4];
+	s32 adc;
+
+	regmap_bulk_read(charger->rk808->regmap, RK817_GAS_GAUGE_Q_PRES_H3,
+			 bulk_reg, 4);
+	adc = (s32)get_unaligned_be32(bulk_reg);
+
+	return div_s64((s64)adc * 172, 3600 * charger->res_div);
+}
+
+static int rk817_bat_write_counter_uah(struct rk817_charger *charger, int uah)
+{
+	u8 bulk_reg[4];
+	s64 adc;
+
+	if (uah < 0)
+		uah = 0;
+	adc = div_s64((s64)uah * charger->res_div * 3600, 172);
+	put_unaligned_be32((u32)adc, bulk_reg);
+
+	return regmap_bulk_write(charger->rk808->regmap,
+				 RK817_GAS_GAUGE_Q_INIT_H3, bulk_reg, 4);
+}
+
+/*
  * note that only the fcc_mah is really used by this driver, the other values
  * are to ensure we can remain backwards compatible with the BSP kernel.
  */
@@ -253,123 +324,6 @@
 	return 0;
 }
 
