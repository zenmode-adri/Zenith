From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lcdyk0517 <lcdyk0517@qq.com>
Subject: [PATCH] leds: add R36Ultra RGB LED driver

Add kernel driver for R36Ultra joystick RGB LED control via
single-wire pulse protocol. Based on JoyLed project:
https://github.com/lcdyk0517/JoyLed

Enable with CONFIG_LEDS_R36ULTRA and DTS compatible "r36ultra,led".

---
diff --git a/drivers/leds/leds-r36ultra.c b/drivers/leds/leds-r36ultra.c
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/drivers/leds/leds-r36ultra.c
@@ -0,0 +1,412 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * R36Ultra RGB LED driver - single-wire pulse protocol
+ *
+ * The number of pulses selects the LED mode:
+ *   1=red 2=yellow 3=green 4=cyan 5=blue 6=purple 7=white 8=heartbeat 9=rainbow, 0/10+=off
+ *
+ * Hardware:
+ *   - pulse-gpios: pulse output used to talk to the LED controller
+ *   - irq-gpios: input from the LED controller (optional)
+ *
+ * sysfs:
+ *   /sys/class/leds/joyled/brightness  - 0-255 mapped to a mode
+ *   /sys/class/leds/joyled/pulse       - send a raw pulse count
+ *   /sys/class/leds/joyled/test        - raw GPIO level (0/1)
+ *
+ * DTS example:
+ *   joyleds {
+ *       compatible = "r36ultra,led";
+ *       pulse-gpios = <&gpio0 RK_PB3 GPIO_ACTIVE_HIGH>;
+ *       irq-gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_HIGH>;
+ *       status = "okay";
+ *   };
+ *
+ * Zenith rework (fixes "the LEDs light up for a moment and go off"):
+ *   - the pulse train is bit-banged with udelay(), so any delay stretches a 1 ms gap and the controller counts a
+ *     different number of pulses (a corrupted "off" train shows up as a random colour until the next refresh).
+ *     The train now runs with preemption disabled.
+ *   - sysfs writes and the refresh used to run concurrently with no lock and could interleave their pulses:
+ *     everything is now serialised by a mutex and the refresh is a delayed work (process context).
+ *   - the controller is not latching, so a lit mode is re-sent every 2 s, but "off" is NOT re-sent any more:
+ *     before, every 2 s a 10-pulse train was bit-banged forever even with the LEDs off, and each glitch lit them.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of_gpio.h>
+#include <linux/gpio.h>
+#include <linux/delay.h>
+#include <linux/leds.h>
+#include <linux/interrupt.h>
+#include <linux/mutex.h>
+#include <linux/workqueue.h>
+#include <linux/irqflags.h>
+#include <linux/preempt.h>
+
+#define DRIVER_NAME "r36ultra-led"
+
+/* The LED controller does not latch: a lit mode must be re-sent periodically (the vendor driver does the same) */
+#define REFRESH_INTERVAL    (HZ * 2)
+
+/* Pulse timing (reverse engineered from the vendor driver) */
+#define PULSE_DELAY_US      1000
+#define PULSE_GAP_US        5000
+
+enum led_mode {
+    MODE_OFF       = 10,  /* off (0 is converted to 10) */
+    MODE_RED       = 1,
+    MODE_YELLOW    = 2,
+    MODE_GREEN     = 3,
+    MODE_CYAN      = 4,
+    MODE_BLUE      = 5,
+    MODE_PURPLE    = 6,
+    MODE_WHITE     = 7,
+    MODE_HEARTBEAT = 8,
+    MODE_RAINBOW   = 9,
+};
+
+struct r36ultra_led_priv {
+    int pulse_gpio;
+    int irq_gpio;
+    int irq_num;
+    struct led_classdev led;
+    int current_mode;
+    struct mutex lock;                  /* serialises pulse trains and current_mode */
+    struct delayed_work refresh_work;
+};
+
+static bool mode_is_lit(int mode)
+{
+    return mode >= MODE_RED && mode <= MODE_RAINBOW;
+}
+
+static irqreturn_t led_irq_handler(int irq, void *dev_id)
+{
+    struct r36ultra_led_priv *priv = dev_id;
+
+    if (!priv)
+        return IRQ_NONE;
+
+    dev_dbg(priv->led.dev, "LED controller interrupt\n");
+    return IRQ_HANDLED;
+}
+
+/*
+ * send_pulse_count - send one pulse train (caller holds priv->lock)
+ *
+ *   1. GPIO high for 7 periods (start)
+ *   2. GPIO low for 1 period
+ *   3. pulse_count data pulses (high, delay, low, delay)
+ *   4. end gap, GPIO low
+ *
+ * Preemption is off for the whole train (a task switch is what can stretch a 1 ms gap by whole milliseconds and change the
+ * pulse count). IRQs are NOT masked: hard IRQ handlers are far shorter than a pulse and masking them for up to ~18 ms every
+ * 2 s while a colour is lit would risk audio crackle / input hitches in games. Worst case ~35 ms (rainbow).
+ */
+static void send_pulse_count(int pulse_gpio, int pulse_count)
+{
+    int i;
+
+    preempt_disable();
+
+    gpio_set_value(pulse_gpio, 1);
+    for (i = 0; i < 7; i++)
+        udelay(PULSE_DELAY_US);
+
+    gpio_set_value(pulse_gpio, 0);
+    udelay(PULSE_DELAY_US);
+
+    for (i = 0; i < pulse_count; i++) {
+        gpio_set_value(pulse_gpio, 1);
+        udelay(PULSE_DELAY_US);
+        gpio_set_value(pulse_gpio, 0);
+        udelay(PULSE_DELAY_US);
+    }
+
+    udelay(PULSE_GAP_US);
+    gpio_set_value(pulse_gpio, 0);
+
+    preempt_enable();
+}
+
+/* Set a new mode (caller holds priv->lock): send it and start/stop the periodic refresh */
+static void r36ultra_led_apply(struct r36ultra_led_priv *priv, int mode)
+{
+    send_pulse_count(priv->pulse_gpio, mode);
+    priv->current_mode = mode;
+
+    if (mode_is_lit(mode))
+        mod_delayed_work(system_wq, &priv->refresh_work, REFRESH_INTERVAL);
+    else
+        cancel_delayed_work(&priv->refresh_work);   /* off is not re-sent */
+}
+
+static void refresh_work_fn(struct work_struct *work)
+{
+    struct r36ultra_led_priv *priv =
+        container_of(to_delayed_work(work), struct r36ultra_led_priv, refresh_work);
+
+    mutex_lock(&priv->lock);
+    if (mode_is_lit(priv->current_mode)) {
+        send_pulse_count(priv->pulse_gpio, priv->current_mode);
+        schedule_delayed_work(&priv->refresh_work, REFRESH_INTERVAL);
+    }
+    mutex_unlock(&priv->lock);
+}
+
+/*
+ * brightness (0-255) -> mode:
+ *   0 off | 1-28 red | 29-56 yellow | 57-84 green | 85-112 cyan | 113-140 blue
+ *   141-168 purple | 169-196 white | 197-224 heartbeat | 225-255 rainbow
+ */
+static int r36ultra_led_set(struct led_classdev *led_cdev, enum led_brightness brightness)
+{
+    struct r36ultra_led_priv *priv = container_of(led_cdev, struct r36ultra_led_priv, led);
+    int target_mode;
+
+    if (brightness == LED_OFF)
+        target_mode = MODE_OFF;
+    else if (brightness <= 28)
+        target_mode = MODE_RED;
+    else if (brightness <= 56)
+        target_mode = MODE_YELLOW;
+    else if (brightness <= 84)
+        target_mode = MODE_GREEN;
+    else if (brightness <= 112)
+        target_mode = MODE_CYAN;
+    else if (brightness <= 140)
+        target_mode = MODE_BLUE;
+    else if (brightness <= 168)
+        target_mode = MODE_PURPLE;
+    else if (brightness <= 196)
+        target_mode = MODE_WHITE;
+    else if (brightness <= 224)
+        target_mode = MODE_HEARTBEAT;
+    else
+        target_mode = MODE_RAINBOW;
+
+    mutex_lock(&priv->lock);
+    r36ultra_led_apply(priv, target_mode);
+    mutex_unlock(&priv->lock);
+    return 0;
+}
+
+static enum led_brightness r36ultra_led_get(struct led_classdev *led_cdev)
+{
+    struct r36ultra_led_priv *priv = container_of(led_cdev, struct r36ultra_led_priv, led);
+
+    return mode_is_lit(priv->current_mode) ? LED_FULL : LED_OFF;
+}
+
+/* sysfs: send a raw pulse count. Usage: echo <count> > /sys/class/leds/joyled/pulse (0 -> 10 = off) */
+static ssize_t pulse_store(struct device *dev, struct device_attribute *attr,
+                           const char *buf, size_t count)
+{
+    struct led_classdev *led_cdev = dev_get_drvdata(dev);
+    struct r36ultra_led_priv *priv = container_of(led_cdev, struct r36ultra_led_priv, led);
+    unsigned long pulse_count;
+    int ret;
+
+    ret = kstrtoul(buf, 10, &pulse_count);
+    if (ret)
+        return ret;
+
+    if (pulse_count > 255)
+        return -EINVAL;
+
+    if (pulse_count == 0)
+        pulse_count = MODE_OFF;
+
+    dev_info(dev, "pulse: %lu\n", pulse_count);
+    mutex_lock(&priv->lock);
+    r36ultra_led_apply(priv, pulse_count);
+    mutex_unlock(&priv->lock);
+
+    return count;
+}
+static DEVICE_ATTR_WO(pulse);
+
+/* sysfs: raw GPIO test. echo 1 > test (high), echo 0 > test (low) */
+static ssize_t test_store(struct device *dev, struct device_attribute *attr,
+                          const char *buf, size_t count)
+{
+    struct led_classdev *led_cdev = dev_get_drvdata(dev);
+    struct r36ultra_led_priv *priv = container_of(led_cdev, struct r36ultra_led_priv, led);
+    unsigned long value;
+    int ret;
+
+    ret = kstrtoul(buf, 10, &value);
+    if (ret)
+        return ret;
+
+    mutex_lock(&priv->lock);
+    gpio_set_value(priv->pulse_gpio, value ? 1 : 0);
+    mutex_unlock(&priv->lock);
+    dev_info(dev, "GPIO test: %lu\n", value);
+
+    return count;
+}
+static DEVICE_ATTR_WO(test);
+
+static struct attribute *r36ultra_led_attrs[] = {
+    &dev_attr_pulse.attr,
+    &dev_attr_test.attr,
+    NULL,
+};
+ATTRIBUTE_GROUPS(r36ultra_led);
+
+static int r36ultra_led_probe(struct platform_device *pdev)
+{
+    struct device *dev = &pdev->dev;
+    struct r36ultra_led_priv *priv;
+    int ret;
+
+    priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+    if (!priv)
+        return -ENOMEM;
+
+    mutex_init(&priv->lock);
+    INIT_DELAYED_WORK(&priv->refresh_work, refresh_work_fn);
+
+    priv->irq_gpio = -EINVAL;
+    priv->irq_num = -EINVAL;
+
+    /* pulse GPIO (required) */
+    priv->pulse_gpio = of_get_named_gpio(dev->of_node, "pulse-gpios", 0);
+    if (!gpio_is_valid(priv->pulse_gpio)) {
+        dev_err(dev, "pulse-gpios not found\n");
+        return -EINVAL;
+    }
+
+    ret = devm_gpio_request_one(dev, priv->pulse_gpio,
+                                 GPIOF_OUT_INIT_LOW, "r36ultra-led-pulse");
+    if (ret) {
+        dev_err(dev, "cannot request pulse GPIO\n");
+        return ret;
+    }
+
+    /* irq GPIO (optional) */
+    priv->irq_gpio = of_get_named_gpio(dev->of_node, "irq-gpios", 0);
+    if (gpio_is_valid(priv->irq_gpio)) {
+        ret = devm_gpio_request_one(dev, priv->irq_gpio,
+                                     GPIOF_OUT_INIT_LOW, "r36ultra-led-irq");
+        if (ret) {
+            priv->irq_gpio = -EINVAL;
+        } else {
+            /* reset delay, then switch to input */
+            udelay(100);
+            gpio_direction_input(priv->irq_gpio);
+            priv->irq_num = gpio_to_irq(priv->irq_gpio);
+            if (priv->irq_num >= 0) {
+                ret = devm_request_irq(dev, priv->irq_num, led_irq_handler,
+                                       IRQF_TRIGGER_RISING, "r36ultra-led-irq", priv);
+                if (ret)
+                    priv->irq_num = -EINVAL;
+            }
+        }
+    }
+
+    priv->led.name = "joyled";
+    priv->led.brightness_set_blocking = r36ultra_led_set;
+    priv->led.brightness_get = r36ultra_led_get;
+    priv->led.max_brightness = 255;
+    priv->led.groups = r36ultra_led_groups;
+
+    ret = devm_led_classdev_register(dev, &priv->led);
+    if (ret) {
+        dev_err(dev, "cannot register LED device\n");
+        return ret;
+    }
+
+    platform_set_drvdata(pdev, priv);
+
+    /* init train (11 pulses): leaves the LEDs off; nothing is refreshed while off */
+    mutex_lock(&priv->lock);
+    send_pulse_count(priv->pulse_gpio, 11);
+    priv->current_mode = MODE_OFF;
+    mutex_unlock(&priv->lock);
+
+    dev_info(dev, "R36Ultra LED driver loaded (pulse_gpio=%d)\n", priv->pulse_gpio);
+    return 0;
+}
+
+static void r36ultra_led_remove(struct platform_device *pdev)
+{
+    struct r36ultra_led_priv *priv = platform_get_drvdata(pdev);
+
+    if (priv) {
+        cancel_delayed_work_sync(&priv->refresh_work);
+        mutex_lock(&priv->lock);
+        send_pulse_count(priv->pulse_gpio, MODE_OFF);
+        priv->current_mode = MODE_OFF;
+        mutex_unlock(&priv->lock);
+    }
+}
+
+/* turn the LEDs off on shutdown */
+static void r36ultra_led_shutdown(struct platform_device *pdev)
+{
+    struct r36ultra_led_priv *priv = platform_get_drvdata(pdev);
+
+    if (priv && gpio_is_valid(priv->pulse_gpio)) {
+        cancel_delayed_work_sync(&priv->refresh_work);
+        mutex_lock(&priv->lock);
+        send_pulse_count(priv->pulse_gpio, MODE_OFF);
+        priv->current_mode = MODE_OFF;
+        mutex_unlock(&priv->lock);
+    }
+}
+
+static int __maybe_unused r36ultra_led_suspend(struct device *dev)
+{
+    struct r36ultra_led_priv *priv = dev_get_drvdata(dev);
+
+    if (priv)
+        cancel_delayed_work_sync(&priv->refresh_work);
+    return 0;
+}
+
+static int __maybe_unused r36ultra_led_resume(struct device *dev)
+{
+    struct r36ultra_led_priv *priv = dev_get_drvdata(dev);
+
+    if (priv) {
+        mutex_lock(&priv->lock);
+        gpio_direction_output(priv->pulse_gpio, 0);
+        gpio_set_value(priv->pulse_gpio, 0);
+        msleep(50);
+        send_pulse_count(priv->pulse_gpio, 11);
+        msleep(100);
+        if (mode_is_lit(priv->current_mode)) {
+            send_pulse_count(priv->pulse_gpio, priv->current_mode);
+            schedule_delayed_work(&priv->refresh_work, REFRESH_INTERVAL);
+        }
+        mutex_unlock(&priv->lock);
+    }
+    return 0;
+}
+
+static SIMPLE_DEV_PM_OPS(r36ultra_led_pm, r36ultra_led_suspend, r36ultra_led_resume);
+
+static const struct of_device_id r36ultra_led_of_match[] = {
+    { .compatible = "r36ultra,led" },
+    { /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, r36ultra_led_of_match);
+
+static struct platform_driver r36ultra_led_driver = {
+    .probe    = r36ultra_led_probe,
+    .remove   = r36ultra_led_remove,
+    .shutdown = r36ultra_led_shutdown,
+    .driver = {
+        .name           = DRIVER_NAME,
+        .of_match_table = r36ultra_led_of_match,
+        .pm             = &r36ultra_led_pm,
+    },
+};
+module_platform_driver(r36ultra_led_driver);
+
+MODULE_AUTHOR("lcdyk0517@qq.com");
+MODULE_DESCRIPTION("R36Ultra RGB LED driver - single-wire pulse protocol");
+MODULE_LICENSE("GPL");
